#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=lib/common.sh
source "$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

for dependency in awk cp date dpkg dpkg-scanpackages dpkg-scansources find git gpg gpgv \
  gzip md5sum mktemp sha256sum stat tar; do
  require_command "$dependency"
done
load_project_config
load_upstream_config

channel=stable
case ${1:-} in
  "") ;;
  --demo) channel=demo ;;
  *) die "usage: publish-updates [--demo]" ;;
esac

archive="$PROJECT_ROOT/out/archive"
gnupg_home="$PROJECT_ROOT/_state/gnupg/archive"
public_key="$PROJECT_ROOT/packages/native/kernora-archive/keyrings/kernora-archive-keyring.asc"
checkout="$PROJECT_ROOT/_state/publish/kernora-updates"
stable_suite=$DIST_CODENAME
demo_suite=$DIST_CODENAME-demo
stable="dists/$stable_suite"
demo="dists/$demo_suite"
binaries="main/binary-$BASE_ARCH"

[[ -s "$archive/$stable/InRelease" ]] || die "the package archive is missing; run make local-archive"
[[ "$DIST_ARCHIVE_KEY_FINGERPRINT" =~ ^[0-9A-F]{40}$ ]] || die "DIST_ARCHIVE_KEY_FINGERPRINT is not set"
gpg --homedir "$gnupg_home" --batch --list-secret-keys "$DIST_ARCHIVE_KEY_FINGERPRINT" >/dev/null 2>&1 \
  || die "the archive signing key is not on this machine (_state/gnupg/archive)"

staging=$(mktemp -d "$PROJECT_ROOT/_build/.publish.XXXXXX")
trap 'rm -rf -- "$staging"' EXIT
published="$staging/published"
site="$staging/site"
mkdir -p "$published" "$site"

if [[ ! -d "$checkout/.git" ]]; then
  mkdir -p "$checkout"
  git -C "$checkout" init --quiet --initial-branch=main
  git -C "$checkout" remote add origin "$DIST_UPDATES_REPOSITORY"
fi
remote=0
git -C "$checkout" ls-remote --exit-code --heads origin main >/dev/null 2>&1 || remote=$?
case $remote in
  0)
    git -C "$checkout" fetch --quiet origin main
    git -C "$checkout" archive FETCH_HEAD | tar -x -C "$published"
    ;;
  2)
    [[ $channel == stable ]] || die "nothing is published yet; publish the normal updates first"
    ;;
  *)
    die "could not reach $DIST_UPDATES_REPOSITORY"
    ;;
esac

sources_table() {
  [[ -s "$1" ]] || return 0
  awk '
    function flush() {
      if (name != "") print name, version, directory, dsc
      name = version = directory = dsc = ""
      sums = 0
    }
    /^$/ { flush(); next }
    /^ / { if (sums && $3 ~ /\.dsc$/) dsc = $1; next }
    { sums = 0 }
    /^Package:/ { name = $2 }
    /^Version:/ { version = $2 }
    /^Directory:/ { directory = $2 }
    /^Checksums-Sha256:/ { sums = 1 }
    END { flush() }
  ' "$1"
}

newer() {
  [[ -z "$2" ]] || dpkg --compare-versions "$1" gt "$2"
}

declare -A old_demo=()
while read -r name version directory dsc; do
  old_demo["$name $version"]=$dsc
done < <(sources_table "$published/$demo/main/source/Sources")

declare -A live=()
while read -r name version directory dsc; do
  live[$name]="$version $dsc"
done < <(sources_table "$published/$stable/main/source/Sources")

declare -A base=()
included=()
if [[ $channel == stable ]]; then
  cp -a "$archive/pool" "$site/pool"
  for index in "$binaries/Packages" "$binaries/Packages.gz" main/source/Sources main/source/Sources.gz; do
    install -D -m 0644 "$archive/$stable/$index" "$site/$stable/$index"
  done
  while read -r name version directory dsc; do
    base[$name]=$version
    previous=${old_demo["$name $version"]:-}
    [[ -z "$previous" || "$previous" == "$dsc" ]] \
      || die "$name $version is in the demo updates with other contents; raise its version so systems that have the demo get this one"
  done < <(sources_table "$site/$stable/main/source/Sources")
  while read -r name version directory dsc; do
    if newer "$version" "${base[$name]:-}"; then
      mkdir -p "$site/${directory%/*}"
      cp -a "$published/$directory" "$site/$directory"
      included+=("$name $version")
    fi
  done < <(sources_table "$published/$demo/main/source/Sources")
else
  mkdir -p "$site/dists"
  cp -a "$published/pool" "$site/pool"
  cp -a "$published/$stable" "$site/$stable"
  for name in "${!live[@]}"; do
    base[$name]=${live[$name]%% *}
  done
  while read -r name version directory dsc; do
    newer "$version" "${base[$name]:-}" || continue
    previous=${old_demo["$name $version"]:-}
    [[ -z "$previous" || "$previous" == "$dsc" ]] \
      || die "$name $version is already in the demo updates with other contents; raise its version so systems that have it get this one"
    target="$site/pool-demo/${directory#pool/}"
    mkdir -p "${target%/*}"
    cp -a "$archive/$directory" "$target"
    included+=("$name $version")
  done < <(sources_table "$archive/$stable/main/source/Sources")
  (( ${#included[@]} > 0 )) \
    || die "nothing in out/archive is newer than the published updates; raise a version first"
fi

while read -r name version directory dsc; do
  read -r live_version live_dsc <<< "${live[$name]:-}"
  if [[ "$version" == "${live_version:-}" && "$dsc" != "$live_dsc" ]]; then
    printf 'warning: %s %s changed but kept its version; systems that have it will not get the change\n' \
      "$name" "$version" >&2
  fi
done < <(sources_table "$archive/$stable/main/source/Sources")

mkdir -p "$site/pool-demo/main" "$site/$demo/$binaries" "$site/$demo/main/source"
(
  cd "$site"
  dpkg-scanpackages --arch "$BASE_ARCH" pool-demo/main /dev/null > "$demo/$binaries/Packages"
  dpkg-scansources pool-demo/main /dev/null > "$demo/main/source/Sources"
)
gzip -n -9 -c "$site/$demo/$binaries/Packages" > "$site/$demo/$binaries/Packages.gz"
gzip -n -9 -c "$site/$demo/main/source/Sources" > "$site/$demo/main/source/Sources.gz"

sign() {
  gpg --homedir "$gnupg_home" --batch --yes --local-user "$DIST_ARCHIVE_KEY_FINGERPRINT" \
    --digest-algo SHA256 "$@"
}

release_suite() {
  local suite_dir=$1 suite=$2 label=$3 description=$4
  local release="$suite_dir/Release" algorithm index sum
  {
    printf 'Origin: %s\n' "$DIST_NAME"
    printf 'Label: %s\n' "$label"
    printf 'Suite: %s\n' "$suite"
    printf 'Codename: %s\n' "$suite"
    printf 'Version: %s\n' "$DIST_VERSION"
    printf 'Date: %s\n' "$(date --utc --rfc-email)"
    printf 'Architectures: %s\n' "$BASE_ARCH"
    printf '%s\n' 'Components: main'
    printf 'Description: %s\n' "$description"
    for algorithm in MD5Sum SHA256; do
      printf '%s:\n' "$algorithm"
      while IFS= read -r index; do
        if [[ $algorithm == MD5Sum ]]; then
          sum=$(md5sum "$index" | awk '{ print $1 }')
        else
          sum=$(sha256sum "$index" | awk '{ print $1 }')
        fi
        printf ' %s %16s %s\n' "$sum" "$(stat --format='%s' "$index")" "${index#"$suite_dir/"}"
      done < <(find "$suite_dir/main" -type f | sort)
    done
  } > "$release"
  sign --armor --detach-sign --output "$release.gpg" "$release"
  sign --clearsign --output "$suite_dir/InRelease" "$release"
}

if [[ $channel == stable ]]; then
  release_suite "$site/$stable" "$stable_suite" "$DIST_NAME" "$DIST_NAME package archive"
fi
release_suite "$site/$demo" "$demo_suite" "$DIST_NAME Demo" "$DIST_NAME demo updates"

verify_home=$(mktemp -d "$staging/.verify.XXXXXX")
chmod 0700 "$verify_home"
gpg --batch --quiet --homedir "$verify_home" --dearmor < "$public_key" > "$verify_home/keyring.gpg"
for suite in "$stable" "$demo"; do
  gpgv --keyring "$verify_home/keyring.gpg" "$site/$suite/InRelease" 2>/dev/null \
    || die "the $suite index does not verify with the shipped key"
done
rm -rf -- "$verify_home"

install -m 0644 "$public_key" "$site/kernora-archive-keyring.asc"
touch "$site/.nojekyll"
cat > "$site/index.html" <<HTML
<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>$DIST_NAME packages</title>
<body style="font-family: sans-serif; max-width: 40em; margin: 3em auto; line-height: 1.5">
<h1>$DIST_NAME packages</h1>
<p>This is the APT archive of $DIST_NAME. Installed systems take their Kernora
updates from here on their own; nothing here needs to be downloaded by hand.</p>
<p>Demo updates, turned on in Settings &gt; System, come from the
<code>$demo_suite</code> suite.</p>
<p>Signing key: <a href="kernora-archive-keyring.asc">kernora-archive-keyring.asc</a><br>
Fingerprint: <code>$DIST_ARCHIVE_KEY_FINGERPRINT</code></p>
</body>
</html>
HTML

git -C "$checkout" config user.name "$(git -C "$PROJECT_ROOT" config user.name)"
git -C "$checkout" config user.email "$(git -C "$PROJECT_ROOT" config user.email)"

if [[ $channel == stable ]]; then
  message="Kernora OS packages for $DIST_CODENAME, $(date --utc +%Y-%m-%d)"
else
  message="Kernora OS demo packages for $DIST_CODENAME, $(date --utc +%Y-%m-%d)"
fi
git -C "$checkout" checkout --quiet --orphan publish
git -C "$checkout" rm -r --quiet --cached . >/dev/null 2>&1 || true
find "$checkout" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf -- {} +
cp -a "$site/." "$checkout/"
git -C "$checkout" add --all
git -C "$checkout" commit --quiet -m "$message"
git -C "$checkout" branch --quiet -M main
git -C "$checkout" push --quiet --force origin main

if (( ${#included[@]} > 0 )); then
  printf 'demo: %s\n' "${included[@]}"
else
  printf 'demo: empty\n'
fi
printf 'published %s: %s (%s)\n' "$channel" "$DIST_UPDATES_URL" \
  "$(git -C "$checkout" rev-parse --short HEAD)"
