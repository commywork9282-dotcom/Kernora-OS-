#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=lib/apt-env.sh
source "$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/apt-env.sh"

require_command apt-get
require_command dpkg-deb
require_command sha256sum
configure_project_apt

package_dir="$PROJECT_ROOT/_cache/bootstrap-packages"
keyring_root="$PROJECT_ROOT/_state/trust/debian-keyring-root"
keyring="$keyring_root/usr/share/keyrings/debian-keyring.pgp"
signer_keyring="$keyring_root/usr/share/keyrings/debian-source-signers.pgp"
package_file="$package_dir/debian-keyring_${DEBIAN_SIGNER_KEYRING_VERSION}_all.deb"

if [[ ! -f "$package_file" ]]; then
  mkdir -p "$package_dir"
  (
    cd "$package_dir"
    apt-get "${APT_OPTIONS[@]}" download \
      "debian-keyring=$DEBIAN_SIGNER_KEYRING_VERSION"
  )
fi

printf '%s  %s\n' "$DEBIAN_SIGNER_KEYRING_SHA256" "$package_file" \
  | sha256sum --check --status \
  || die "Debian signer keyring package checksum mismatch"

if [[ ! -s "$keyring" ]]; then
  mkdir -p "$keyring_root"
  dpkg-deb --extract "$package_file" "$keyring_root"
fi

[[ -s "$keyring" ]] || die "Debian signer keyring was not extracted"

temporary_keyring=$(mktemp "$keyring_root/usr/share/keyrings/.source-signers.XXXXXX")
for keyring_file in debian-keyring.pgp debian-maintainers.pgp debian-nonupload.pgp; do
  dd \
    if="$keyring_root/usr/share/keyrings/$keyring_file" \
    of="$temporary_keyring" \
    oflag=append conv=notrunc status=none
done
mv -- "$temporary_keyring" "$signer_keyring"

printf 'Debian source signer keyring: %s\n' "$signer_keyring"
