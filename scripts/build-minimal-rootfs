#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=lib/common.sh
source "$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

for dependency in awk chmod cp date find install mkdir mktemp mv sha256sum \
  tar unshare; do
  require_command "$dependency"
done
load_project_config
load_upstream_config

snapshot_iso="${SNAPSHOT_TIMESTAMP:0:4}-${SNAPSHOT_TIMESTAMP:4:2}-${SNAPSHOT_TIMESTAMP:6:2}"
snapshot_iso+=" ${SNAPSHOT_TIMESTAMP:9:2}:${SNAPSHOT_TIMESTAMP:11:2}:${SNAPSHOT_TIMESTAMP:13:2} UTC"
source_date_epoch=$(date --utc --date="$snapshot_iso" +%s)
export SOURCE_DATE_EPOCH=$source_date_epoch

tool="$PROJECT_ROOT/_state/tools/mmdebstrap/usr/bin/mmdebstrap"
debian_key="$PROJECT_ROOT/_state/trust/debian-trixie-archive-keyring.gpg"
kernora_key="$PROJECT_ROOT/_state/keys/development-archive.gpg"
local_archive="$PROJECT_ROOT/out/archive"
package_manifest="$PROJECT_ROOT/configs/rootfs/minimal-packages.txt"

[[ -x "$tool" ]] || die "mmdebstrap is missing; run make build-tools"
[[ -s "$debian_key" ]] || die "Debian archive keyring is missing"
[[ -s "$kernora_key" ]] || die "Kernora development archive key is missing"
[[ -s "$local_archive/dists/$DIST_CODENAME/InRelease" ]] \
  || die "Kernora local archive is missing; run make local-archive"

mapfile -t requested_packages < <(
  awk 'NF && $1 !~ /^#/ { print $1 }' "$package_manifest"
)
(( ${#requested_packages[@]} > 0 )) || die "minimal package manifest is empty"
include=$(IFS=,; printf '%s' "${requested_packages[*]}")

temporary_root=$(mktemp -d /tmp/kernora-minimal-rootfs.XXXXXX)
chmod 0777 "$temporary_root"
rootfs="$temporary_root/rootfs"
temporary_archive="$temporary_root/archive"
keyring_dir="$temporary_root/keyrings"
final_sources="$temporary_root/sources.list"
mkdir -p "$keyring_dir"
cp -a "$local_archive" "$temporary_archive"
install -m 0644 "$debian_key" \
  "$keyring_dir/debian-trixie-archive-keyring.gpg"
install -m 0644 "$kernora_key" \
  "$keyring_dir/kernora-development-archive-keyring.gpg"

{
  printf 'deb [signed-by=/usr/share/keyrings/kernora-development-archive-keyring.gpg] file:/usr/share/kernora/archive %s main\n' \
    "$DIST_CODENAME"
  printf 'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-trixie-archive-keyring.gpg] %s/%s %s main\n' \
    "$DEBIAN_SNAPSHOT" "$SNAPSHOT_TIMESTAMP" "$BASE_CODENAME"
  printf 'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-trixie-archive-keyring.gpg] %s/%s %s-updates main\n' \
    "$DEBIAN_SNAPSHOT" "$SNAPSHOT_TIMESTAMP" "$BASE_CODENAME"
  printf 'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-trixie-archive-keyring.gpg] %s/%s %s-security main\n' \
    "$DEBIAN_SECURITY_SNAPSHOT" "$SNAPSHOT_TIMESTAMP" "$BASE_CODENAME"
} > "$final_sources"

cleanup() {
  set +e
  if [[ -e "$rootfs" ]]; then
    unshare --map-auto --setuid 0 --setgid 0 \
      find "$rootfs" -depth -delete
  fi
  find "$temporary_root" -depth -delete
}
trap cleanup EXIT

"$tool" \
  --mode=unshare \
  --variant=minbase \
  --architectures="$BASE_ARCH" \
  --include="$include" \
  --keyring="$keyring_dir" \
  --aptopt='Acquire::Check-Valid-Until "false"' \
  --aptopt='Acquire::Languages "none"' \
  --setup-hook='mkdir -p "$1/usr/share/keyrings" "$1/usr/share/kernora"' \
  --setup-hook="upload $debian_key /usr/share/keyrings/debian-trixie-archive-keyring.gpg" \
  --setup-hook="upload $kernora_key /usr/share/keyrings/kernora-development-archive-keyring.gpg" \
  --setup-hook="copy-in $temporary_archive /usr/share/kernora" \
  --customize-hook="upload $final_sources /etc/apt/sources.list" \
  --customize-hook='rm -f "$1/etc/apt/apt.conf.d/99mmdebstrap" "$1/etc/hostname" "$1/etc/resolv.conf"' \
  "$BASE_CODENAME" \
  "$rootfs" \
  "deb copy:$temporary_archive $DIST_CODENAME main" \
  "deb $DEBIAN_SNAPSHOT/$SNAPSHOT_TIMESTAMP $BASE_CODENAME main" \
  "deb $DEBIAN_SNAPSHOT/$SNAPSHOT_TIMESTAMP $BASE_CODENAME-updates main" \
  "deb $DEBIAN_SECURITY_SNAPSHOT/$SNAPSHOT_TIMESTAMP $BASE_CODENAME-security main"

"$PROJECT_ROOT/tests/test-minimal-rootfs.sh" "$rootfs"

output_dir="$PROJECT_ROOT/out/rootfs"
artifact_name="kernora-${DIST_VERSION}-${DIST_CODENAME}-${BASE_ARCH}.tar.xz"
artifact="$output_dir/$artifact_name"
temporary_artifact="$output_dir/.$artifact_name.tmp"
mkdir -p "$output_dir"

unshare --map-auto --setuid 0 --setgid 0 \
  tar \
    --sort=name \
    --mtime="@$source_date_epoch" \
    --numeric-owner \
    --owner=0 \
    --group=0 \
    --pax-option=delete=atime,delete=ctime \
    -C "$rootfs" -cJf - . > "$temporary_artifact"
mv -- "$temporary_artifact" "$artifact"
(
  cd "$output_dir"
  sha256sum "$artifact_name" > "$artifact_name.sha256"
)

printf 'minimal rootfs: %s\n' "$artifact"
printf 'rootfs checksum: %s.sha256\n' "$artifact"
