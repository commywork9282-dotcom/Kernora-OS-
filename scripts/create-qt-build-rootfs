#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=lib/common.sh
source "$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

for dependency in chmod find install python3 tar unshare; do
  require_command "$dependency"
done
load_upstream_config

tool="$PROJECT_ROOT/_state/tools/mmdebstrap/usr/bin/mmdebstrap"
archive_keyring="$PROJECT_ROOT/_state/trust/debian-trixie-archive-keyring.gpg"
control=${1:-$PROJECT_ROOT/packages/native/kernora-apps/debian/control}
name=${2:-qt}
[[ "$name" =~ ^[a-z0-9-]+$ ]] || die "invalid build rootfs name: $name"
cache_dir="$PROJECT_ROOT/_cache/chroots"
cache_file="$cache_dir/trixie-amd64-buildd-$name.tar.xz"

[[ -x "$tool" ]] || die "mmdebstrap is missing; run scripts/bootstrap-build-tools"
[[ -s "$archive_keyring" ]] || die "Debian archive keyring is missing"
[[ -s "$control" ]] || die "Build-Depends source is missing: $control"

wanted=$(python3 - "$control" <<'PYTHON'
import re
import sys

text = open(sys.argv[1], encoding="utf-8").read() + "\nEnd: \n"
names = set()
for match in re.finditer(r"^Build-Depends(?:-Arch|-Indep)?:(.*?)(?=^\S)", text, re.S | re.M):
    for item in match.group(1).split(","):
        item = item.strip()
        if not item or "<!nocheck>" in item:
            continue
        name = re.split(r"[\s(|\[<]", item, maxsplit=1)[0]
        names.add(name.split(":", 1)[0])
print("\n".join(sorted(names)))
PYTHON
)

manifest=./etc/kernora-build-depends
if [[ -s "$cache_file" ]]; then
  recorded=$(tar -xJOf "$cache_file" "$manifest" 2>/dev/null || true)
  if [[ "$recorded" == "$wanted" ]]; then
    printf '%s build rootfs cache: %s\n' "$name" "$cache_file"
    exit 0
  fi
  printf '%s build rootfs cache is stale; rebuilding\n' "$name"
fi

temporary_root=$(mktemp -d "/tmp/kernora-$name-build-rootfs.XXXXXX")
chmod 0777 "$temporary_root"
rootfs="$temporary_root/rootfs"
temporary_keyring="$temporary_root/debian-trixie-archive-keyring.gpg"
install -m 0644 "$archive_keyring" "$temporary_keyring"
printf '%s\n' "$wanted" > "$temporary_root/build-depends"
chmod 0644 "$temporary_root/build-depends"

cleanup() {
  set +e
  if [[ -e "$rootfs" ]]; then
    unshare --map-auto --setuid 0 --setgid 0 \
      find "$rootfs" -depth -delete
  fi
  find "$temporary_root" -depth -delete
}
trap cleanup EXIT

include=$(printf '%s\n' "$wanted" | paste -sd, -)
"$tool" \
  --mode=unshare \
  --variant=buildd \
  --architectures="$BASE_ARCH" \
  --include="debian-archive-keyring,ca-certificates,$include" \
  --keyring="$temporary_keyring" \
  --aptopt='Acquire::Check-Valid-Until "false"' \
  --aptopt='Acquire::Languages "none"' \
  --aptopt='Apt::Install-Recommends "false"' \
  --customize-hook='rm -f "$1/etc/hostname" "$1/etc/resolv.conf"' \
  --customize-hook="upload $temporary_root/build-depends /etc/kernora-build-depends" \
  "$BASE_CODENAME" \
  "$rootfs" \
  "deb $DEBIAN_SNAPSHOT/$SNAPSHOT_TIMESTAMP $BASE_CODENAME main"

mkdir -p "$cache_dir"
temporary_cache="$cache_dir/.trixie-amd64-buildd-$name.tar.xz.tmp"
unshare --map-auto --setuid 0 --setgid 0 \
  tar --numeric-owner -C "$rootfs" -cf - . | xz -T0 -6 > "$temporary_cache"
mv -- "$temporary_cache" "$cache_file"

printf 'created %s build rootfs cache: %s\n' "$name" "$cache_file"
