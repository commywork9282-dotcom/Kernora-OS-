@@ -340,6 +362,28 @@
 {
     m_selectedLocaleConfiguration.explicit_lang = true;
     setLanguage( language );
+
+    const QLocale selected( language );
+    auto* translations = Calamares::Locale::availableTranslations();
+    int index = translations->find( selected );
+    if ( index < 0 )
+    {
+        index = translations->find( [ &selected ]( const QLocale& candidate )
+                                    {
+                                        return candidate.language() == selected.language()
+                                            && candidate.script() == selected.script();
+                                    } );
+    }
+    if ( index < 0 )
+    {
+        index = translations->find( [ &selected ]( const QLocale& candidate )
+                                    { return candidate.language() == selected.language(); } );
+    }
+    const auto translation = index >= 0 ? translations->locale( index ).id()
+                                        : Calamares::Locale::Translation::Id { selected.name() };
+    QLocale::setDefault( selected );
+    const auto* branding = Calamares::Branding::instance();
+    Calamares::installTranslator( translation, branding ? branding->translationsDirectory() : QString() );
 }
 
