+
+void
+PartitionViewStep::updatePixelHeader()
+{
+    const QString product = Calamares::Branding::instance()->string( Calamares::Branding::ShortProductName );
+    const bool manual = m_manualPartitionPage && m_widget->currentWidget() == m_manualPartitionPage;
+    if ( manual )
+    {
+        m_frame->setHeader( tr( "Manual partitioning", "@title" ),
+                            tr( "Create, resize or delete partitions yourself. %1 needs a partition mounted at /.", "@info" )
+                                .arg( product ) );
+    }
+    else
+    {
+        m_frame->setHeader(
+            tr( "Where to install %1", "@title" ).arg( product ),
+            tr( "Choose how to place %1 on the disk. Before installing, you will see what changes.", "@info" ).arg( product ) );
+    }
 }
 
