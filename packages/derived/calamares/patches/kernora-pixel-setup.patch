+
+static QPainterPath
+pixelSegment( const QRectF& r, qreal leftRadius, qreal rightRadius )
+{
+    leftRadius = qMin( leftRadius, qMin( r.width(), r.height() ) / 2 );
+    rightRadius = qMin( rightRadius, qMin( r.width(), r.height() ) / 2 );
+    QPainterPath path;
+    path.moveTo( r.left() + leftRadius, r.top() );
+    path.lineTo( r.right() - rightRadius, r.top() );
+    path.arcTo( QRectF( r.right() - 2 * rightRadius, r.top(), 2 * rightRadius, 2 * rightRadius ), 90, -90 );
+    path.lineTo( r.right(), r.bottom() - rightRadius );
+    path.arcTo(
+        QRectF( r.right() - 2 * rightRadius, r.bottom() - 2 * rightRadius, 2 * rightRadius, 2 * rightRadius ), 0, -90 );
+    path.lineTo( r.left() + leftRadius, r.bottom() );
+    path.arcTo( QRectF( r.left(), r.bottom() - 2 * leftRadius, 2 * leftRadius, 2 * leftRadius ), 270, -90 );
+    path.lineTo( r.left(), r.top() + leftRadius );
+    path.arcTo( QRectF( r.left(), r.top(), 2 * leftRadius, 2 * leftRadius ), 180, -90 );
+    path.closeSubpath();
+    return path;
+}
+
+void
+PartitionSplitterWidget::drawPixel( QPainter* painter )
+{
+    const qreal span = qMax< qreal >( 1, m_itemToResize.size + m_itemToResizeNext.size );
+    const qreal w = width();
+    const qreal track = 48;
+    const qreal top = ( height() - track ) / 2.0;
+    const qreal gap = 6;
+    const qreal handle = 4;
+    const qreal handleX = qBound( gap + handle, w * m_itemToResize.size / span, w - gap - handle );
+    m_resizeHandleX = qRound( handleX );
+
+    const QRectF keep( 0, top, handleX - handle / 2 - gap, track );
+    const QRectF add( handleX + handle / 2 + gap, top, w - ( handleX + handle / 2 + gap ), track );
+    painter->setPen( Qt::NoPen );
+    painter->fillPath( pixelSegment( keep, track / 2, 4 ), m_keepColor );
+    painter->fillPath( pixelSegment( add, 4, track / 2 ), m_newColor );
+    painter->setBrush( m_newColor );
+    painter->drawRoundedRect( QRectF( handleX - handle / 2, top - 8, handle, track + 16 ), 2, 2 );
+
+    QFont label = font();
+    label.setPixelSize( 14 );
+    label.setWeight( QFont::Medium );
+    painter->setFont( label );
+    const QFontMetrics metrics( label );
+    const QString keepText = QStringLiteral( "%1 · %2" ).arg( m_keepName, pixelSize( m_itemToResize.size ) );
+    const QString addText = QStringLiteral( "%1 · %2" ).arg( m_newName, pixelSize( m_itemToResizeNext.size ) );
+    painter->setPen( m_keepTextColor );
+    painter->drawText( keep.adjusted( 20, 0, -12, 0 ),
+                       Qt::AlignVCenter | Qt::AlignLeft,
+                       metrics.elidedText( keepText, Qt::ElideRight, int( keep.width() ) - 32 ) );
+    painter->setPen( m_newTextColor );
+    painter->drawText( add.adjusted( 12, 0, -20, 0 ),
+                       Qt::AlignVCenter | Qt::AlignRight,
+                       metrics.elidedText( addText, Qt::ElideRight, int( add.width() ) - 32 ) );
+}
+
+void
+PartitionSplitterWidget::pixelResize( qreal x )
+{
+    const qint64 span = m_itemToResize.size + m_itemToResizeNext.size;
+    qreal size = x / qMax( 1, width() ) * span;
+    size = qBound( static_cast< qreal >( m_itemMinSize ), size, static_cast< qreal >( qMin( m_itemMaxSize, span ) ) );
+    m_itemToResize.size = qRound64( size );
+    m_itemToResizeNext.size = span - m_itemToResize.size;
+    countTransform( m_items,
+                    [ this ]( PartitionSplitterItem& item ) -> bool
+                    {
+                        if ( item.status == PartitionSplitterItem::Resizing )
+                        {
+                            item.size = m_itemToResize.size;
+                            return true;
+                        }
+                        else if ( item.status == PartitionSplitterItem::ResizingNext )
+                        {
+                            item.size = m_itemToResizeNext.size;
+                            return true;
+                        }
+                        return false;
+                    } );
+    repaint();
+    Q_EMIT partitionResized( m_itemToResize.itemPath, m_itemToResize.size, m_itemToResizeNext.size );
 }
 
