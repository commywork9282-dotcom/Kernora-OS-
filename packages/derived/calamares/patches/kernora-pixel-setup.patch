+#include "PixelFrame.h"
+
+#include "Branding.h"
+#include "ViewManager.h"
+
+#include <QIcon>
+#include <QLabel>
+#include <QPushButton>
+#include <QResizeEvent>
+#include <QToolButton>
+
+#include <algorithm>
+
+static int
+bounded( double value, int low, int high )
+{
+    return int( std::max< double >( low, std::min< double >( high, value ) ) );
+}
+
+PixelFrame::PixelFrame( QWidget* content, QWidget* parent )
+    : QWidget( parent )
+    , m_content( content )
+    , m_back( new QToolButton( this ) )
+    , m_icon( new QLabel( this ) )
+    , m_title( new QLabel( this ) )
+    , m_description( new QLabel( this ) )
+    , m_next( new QPushButton( this ) )
+{
+    setObjectName( QStringLiteral( "pixelPage" ) );
+    setAttribute( Qt::WA_StyledBackground, true );
+    m_content->setParent( this );
+
+    const auto* branding = Calamares::Branding::instance();
+    m_back->setObjectName( QStringLiteral( "pixelBack" ) );
+    m_back->setIcon( QIcon( branding->image( QStringLiteral( "images/pixel-arrow-back.svg" ), QSize( 48, 48 ) ) ) );
+    m_back->setIconSize( QSize( 24, 24 ) );
+    m_back->setFixedSize( 48, 48 );
+    m_back->setCursor( Qt::PointingHandCursor );
+    m_back->setFocusPolicy( Qt::TabFocus );
+
+    m_icon->setObjectName( QStringLiteral( "pixelIcon" ) );
+    QPixmap icon = branding->image( QStringLiteral( "images/pixel-hard-drive.svg" ), QSize( 80, 80 ) );
+    icon.setDevicePixelRatio( 2.0 );
+    m_icon->setPixmap( icon );
+    m_icon->setFixedSize( 40, 40 );
+
+    m_title->setObjectName( QStringLiteral( "pixelTitle" ) );
+    m_title->setWordWrap( true );
+    m_description->setObjectName( QStringLiteral( "pixelDescription" ) );
+    m_description->setWordWrap( true );
+
+    m_next->setObjectName( QStringLiteral( "pixelPrimary" ) );
+    m_next->setCursor( Qt::PointingHandCursor );
+
+    auto* manager = Calamares::ViewManager::instance();
+    connect( m_back, &QToolButton::clicked, manager, &Calamares::ViewManager::back );
+    connect( m_next, &QPushButton::clicked, manager, &Calamares::ViewManager::next );
+    connect( manager, &Calamares::ViewManager::nextEnabledChanged, m_next, &QPushButton::setEnabled );
+    connect( manager, &Calamares::ViewManager::backEnabledChanged, m_back, &QToolButton::setVisible );
+    connect( manager,
+             &Calamares::ViewManager::nextLabelChanged,
+             this,
+             [ this ]( const QString& label )
+             {
+                 m_next->setText( label );
+                 layoutChildren();
+             } );
+    m_next->setEnabled( manager->nextEnabled() );
+    m_back->setVisible( manager->backEnabled() );
+    m_next->setText( manager->nextLabel() );
+}
+
+void
+PixelFrame::setHeader( const QString& title, const QString& description )
+{
+    m_title->setText( title );
+    m_description->setText( description );
+    layoutChildren();
+}
+
+void
+PixelFrame::resizeEvent( QResizeEvent* event )
+{
+    QWidget::resizeEvent( event );
+    layoutChildren();
+}
+
+void
+PixelFrame::showEvent( QShowEvent* event )
+{
+    QWidget::showEvent( event );
+    layoutChildren();
+}
+
+void
+PixelFrame::layoutChildren()
+{
+    const int w = width();
+    const int h = height();
+    const bool wide = w >= 960;
+    const int margin = wide ? bounded( w * 0.05, 40, 72 ) : 24;
+    const int top = bounded( h * 0.15, 88, 136 );
+    const int bottom = bounded( h * 0.053, 24, 48 );
+    const int pane = wide ? w / 2 - margin - 24 : w - 2 * margin;
+    const int corner = margin / 2 - 8;
+
+    m_back->move( corner, corner );
+
+    const int headerWidth = std::max( 0, pane - ( wide ? 16 : 0 ) );
+    int y = top;
+    m_icon->setGeometry( margin, y, 40, 40 );
+    y += 40 + 28;
+    const int titleHeight = m_title->heightForWidth( headerWidth );
+    m_title->setGeometry( margin, y, headerWidth, titleHeight );
+    y += titleHeight + 20;
+    const int textHeight = m_description->heightForWidth( headerWidth );
+    m_description->setGeometry( margin, y, headerWidth, textHeight );
+    y += textHeight;
+
+    const int nextWidth = std::max( 148, m_next->sizeHint().width() + 16 );
+    m_next->setGeometry( w - margin - nextWidth, h - bottom - 56, nextWidth, 56 );
+
+    const int contentTop = wide ? top : y + 24;
+    const int contentLeft = wide ? w / 2 + 24 : margin;
+    m_content->setGeometry( contentLeft, contentTop, pane, std::max( 0, h - contentTop - 56 - bottom - 24 ) );
+}
