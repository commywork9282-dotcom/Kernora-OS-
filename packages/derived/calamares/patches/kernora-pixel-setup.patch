 void
+ChoicePage::updatePixelPreviews( Config::InstallChoice choice )
+{
+    m_previewBeforeLabel->hide();
+    m_previewAfterLabel->hide();
+    const bool pick = choice == InstallChoice::Alongside || choice == InstallChoice::Replace;
+    m_previewBeforeFrame->setVisible( pick );
+    if ( choice == InstallChoice::Alongside && m_core && selectedDevice() && m_beforePartitionBarsView )
+    {
+        PartitionModel* model = m_core->partitionModelForDevice( selectedDevice() );
+        QModelIndex best;
+        qint64 bestSize = -1;
+        int candidates = 0;
+        std::function< void( const QModelIndex& ) > scan = [ & ]( const QModelIndex& parent )
+        {
+            for ( int row = 0; row < model->rowCount( parent ); ++row )
+            {
+                const QModelIndex index = model->index( row, 0, parent );
+                Partition* partition = model->partitionForIndex( index );
+                if ( partition && PartUtils::canBeResized( partition, Logger::Once() ) )
+                {
+                    ++candidates;
+                    if ( partition->capacity() > bestSize )
+                    {
+                        bestSize = partition->capacity();
+                        best = index;
+                    }
+                }
+                scan( index );
+            }
+        };
+        scan( QModelIndex() );
+        auto* selection = m_beforePartitionBarsView->selectionModel();
+        if ( best.isValid() && selection && !selection->currentIndex().isValid() )
+        {
+            selection->setCurrentIndex( best, QItemSelectionModel::ClearAndSelect );
+        }
+        if ( candidates <= 1 )
+        {
+            m_previewBeforeFrame->hide();
+            m_selectLabel->hide();
+        }
+    }
+    if ( choice == InstallChoice::Erase || choice == InstallChoice::Replace )
+    {
+        if ( m_afterPartitionBarsView )
+        {
+            m_afterPartitionBarsView->hide();
+        }
+        if ( m_afterPartitionLabelsView )
+        {
+            m_afterPartitionLabelsView->hide();
+        }
+        m_previewAfterFrame->setVisible( !m_isEfi || choice == InstallChoice::Replace );
+    }
+}
+
+void
+ChoicePage::updatePixelSegments()
+{
+    QList< Calamares::Widgets::PrettyRadioButton* > shown;
+    for ( auto* button : { m_alongsideButton, m_replaceButton, m_eraseButton, m_somethingElseButton } )
+    {
+        if ( button && !button->isHidden() )
+        {
+            shown.append( button );
+        }
+    }
+    for ( int i = 0; i < shown.count(); ++i )
+    {
+        const QString segment = shown.count() == 1 ? QStringLiteral( "only" )
+            : i == 0                              ? QStringLiteral( "first" )
+            : i == shown.count() - 1              ? QStringLiteral( "last" )
+                                                  : QStringLiteral( "middle" );
+        shown[ i ]->setProperty( "segment", segment );
+        shown[ i ]->style()->unpolish( shown[ i ] );
+        shown[ i ]->style()->polish( shown[ i ] );
+    }
+    fitPixelChoices();
+}
+
+void
+ChoicePage::fitPixelChoices()
+{
+    QWidget* contents = m_itemsScrollArea->widget();
+    if ( !contents )
+    {
+        return;
+    }
+    const int width = qMax( 1, m_itemsScrollArea->viewport()->width() );
+    const int height = contents->hasHeightForWidth() ? contents->heightForWidth( width ) : contents->sizeHint().height();
+    m_itemsScrollArea->setFixedHeight( qMax( 0, height ) );
+}
+
+void
+ChoicePage::resizeEvent( QResizeEvent* event )
+{
+    QWidget::resizeEvent( event );
+    fitPixelChoices();
+}
+
+void
+ChoicePage::updatePixelDisk()
+{
+    Device* device = m_core ? selectedDevice() : nullptr;
+    if ( !device )
+    {
+        m_pixelDiskTitle->clear();
+        m_pixelDiskText->clear();
+        return;
+    }
+    const QString name = device->name().isEmpty() ? device->deviceNode() : device->name();
+    m_pixelDiskTitle->setText(
+        tr( "%1 · %2", "@label, disk model and size" ).arg( name, formatByteSize( device->capacity() ) ) );
+    QStringList systems;
+    for ( const auto& entry : getOsproberEntriesForDevice( device ) )
+    {
+        if ( !entry.prettyName.isEmpty() && !systems.contains( entry.prettyName ) )
+        {
+            systems.append( entry.prettyName );
+        }
+    }
+    if ( !systems.isEmpty() )
+    {
+        m_pixelDiskText->setText( tr( "On this disk: %1", "@label, %1 is a list of operating systems" ).arg( systems.join( QStringLiteral( ", " ) ) ) );
+    }
+    else if ( !device->partitionTable() || device->partitionTable()->children().isEmpty() )
+    {
+        m_pixelDiskText->setText( tr( "This disk is empty", "@label" ) );
+    }
+    else
+    {
+        m_pixelDiskText->setText( tr( "This disk has partitions with files", "@label" ) );
+    }
+}
