+QString
+PartitionSplitterWidget::pixelSize( qint64 bytes ) const
+{
+    const double gigabytes = static_cast< double >( bytes ) / ( 1024.0 * 1024.0 * 1024.0 );
+    return tr( "%1 GB", "@label, size in gigabytes" ).arg( QLocale().toString( gigabytes, 'f', gigabytes < 10 ? 1 : 0 ) );
