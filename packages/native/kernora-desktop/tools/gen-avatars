#!/usr/bin/env python3
"""usage: gen-avatars OUTPUT_DIR
"""

from __future__ import annotations

import math
import pathlib
import sys

import kernora_design as design
import m3color

SIZE = 512
CHROMA = 46.0


def tone(hue: float, value: float, chroma: float = CHROMA) -> str:
    return m3color.hex_from_rgb(m3color.rgb_from_hct(hue, chroma, value))


def wave_band(top: float, amplitude: float, length: float, phase: float, left: float, right: float, bottom: float) -> str:
    points = []
    steps = 96
    for step in range(steps + 1):
        x = left + (right - left) * step / steps
        y = top + amplitude * math.sin(2 * math.pi * (x - left) / length + phase)
        points.append(f"{x:.1f},{y:.1f}")
    return f'M{points[0]} L' + " ".join(points[1:]) + f" L{right:.1f},{bottom:.1f} L{left:.1f},{bottom:.1f} Z"


def ripple(radius: float, amplitude: float, lobes: int, phase: float) -> str:
    centre = SIZE / 2
    points = []
    steps = 360
    for step in range(steps):
        angle = 2 * math.pi * step / steps
        r = radius + amplitude * math.cos(lobes * angle + phase)
        points.append(f"{centre + r * math.cos(angle):.1f},{centre + r * math.sin(angle):.1f}")
    return f'M{points[0]} L' + " ".join(points[1:]) + " Z"


def layers(hue: float, dark: bool, seed: int) -> tuple[str, str]:
    background = tone(hue, 22 if dark else 94, 20)
    tones = [40, 55, 70, 84] if dark else [86, 74, 60, 44]
    paths = []
    for index, value in enumerate(tones):
        top = SIZE * (0.30 + 0.17 * index)
        length = SIZE * (1.15 - 0.12 * index)
        phase = seed * 0.9 + index * 1.7
        paths.append(f'  <path d="{wave_band(top, SIZE * 0.045, length, phase, -8, SIZE + 8, SIZE + 8)}" fill="{tone(hue, value)}"/>')
    return background, "\n".join(paths)


def diagonal(hue: float, dark: bool, seed: int) -> tuple[str, str]:
    background = tone(hue, 24 if dark else 92, 22)
    tones = [36, 50, 64, 78, 90] if dark else [84, 72, 58, 44, 32]
    paths = []
    for index, value in enumerate(tones):
        top = SIZE * (0.05 + 0.2 * index)
        phase = seed * 1.3 + index * 2.1
        paths.append(f'    <path d="{wave_band(top, SIZE * 0.05, SIZE * 0.8, phase, -SIZE * 0.5, SIZE * 1.5, SIZE * 1.6)}" fill="{tone(hue, value)}"/>')
    group = f'  <g transform="rotate({-28 if seed % 2 else 28} {SIZE / 2} {SIZE / 2})">\n' + "\n".join(paths) + "\n  </g>"
    return background, group


def rings(hue: float, dark: bool, seed: int) -> tuple[str, str]:
    background = tone(hue, 20 if dark else 95, 18)
    tones = [34, 48, 62, 76, 88] if dark else [88, 78, 66, 54, 42]
    lobes = 8 + 2 * (seed % 3)
    paths = []
    for index, value in enumerate(tones):
        radius = SIZE * (0.62 - 0.115 * index)
        amplitude = SIZE * (0.022 - 0.002 * index)
        phase = seed * 0.6 + index * math.pi / lobes
        paths.append(f'  <path d="{ripple(radius, amplitude, lobes, phase)}" fill="{tone(hue, value)}"/>')
    return background, "\n".join(paths)


def swell(hue: float, dark: bool, seed: int) -> tuple[str, str]:
    background = tone(hue, 30 if dark else 90, 30)
    second = (hue + 40) % 360
    paths = [
        f'  <path d="{wave_band(SIZE * 0.42, SIZE * 0.11, SIZE * 1.3, seed * 1.1, -8, SIZE + 8, SIZE + 8)}" fill="{tone(second, 62 if dark else 70)}"/>',
        f'  <path d="{wave_band(SIZE * 0.6, SIZE * 0.09, SIZE * 1.05, seed * 1.1 + 2.4, -8, SIZE + 8, SIZE + 8)}" fill="{tone(hue, 82 if dark else 48)}"/>',
        f'  <path d="{wave_band(SIZE * 0.8, SIZE * 0.05, SIZE * 0.7, seed * 1.1 + 4.0, -8, SIZE + 8, SIZE + 8)}" fill="{tone(hue, 92 if dark else 32, 30)}"/>',
    ]
    return background, "\n".join(paths)


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    output = pathlib.Path(argv[1])
    output.mkdir(parents=True, exist_ok=True)
    kernora = m3color.Hct.from_hex(design.SEED).hue
    hues = {"ember": kernora, **design.ACCENT_HUES}
    plan = [
        ("ember", layers, False), ("violet", rings, True), ("teal", diagonal, False), ("rose", swell, False),
        ("blue", layers, True), ("amber", rings, False), ("green", diagonal, True), ("ember", diagonal, True),
        ("violet", layers, False), ("teal", swell, True), ("rose", rings, False), ("blue", diagonal, False),
        ("green", rings, True), ("amber", layers, False),
    ]
    for index, (name, style, dark) in enumerate(plan, start=1):
        background, shapes = style(hues[name], dark, index)
        svg = (
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{SIZE}" height="{SIZE}" viewBox="0 0 {SIZE} {SIZE}">\n'
            f'  <rect width="{SIZE}" height="{SIZE}" fill="{background}"/>\n{shapes}\n</svg>\n'
        )
        path = output / f"{index:02d}-{name}-{style.__name__}.svg"
        path.write_text(svg, encoding="utf-8")
    print(f"avatars: {len(plan)} in {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
