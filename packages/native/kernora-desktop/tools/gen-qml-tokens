#!/usr/bin/env python3
"""usage: gen-qml-tokens OUTPUT_FILE
       gen-qml-tokens --palette OUTPUT_FILE
"""

from __future__ import annotations

import pathlib
import sys

import kernora_design as design

HEADER = """// Material 3 design tokens for the Kernora shell.
//
// Generated by tools/gen-qml-tokens from the seed colour {seed}.
// Do not edit: every surface in the shell reads these, so a hand edit here
// would silently desynchronise the QML from the Plasma theme and the icons.

pragma Singleton

import QtCore
import QtQuick
import org.kde.kirigami as Kirigami

QtObject {{
    id: tokens

    // --- generation -----------------------------------------------------------

    // "md1", "md2" or "md3": the Material generation Kernora wears.
    property string generation: "{default}"
    property string colour: "{colour}"
    readonly property var colourIds: {colour_ids}
    readonly property int generationIndex: generation === "md1" ? 0 : generation === "md2" ? 1 : 2
    // Material 1 and 2: square-ish shapes, shadows, uppercase buttons,
    // classic switches and sliders.
    readonly property bool classic: generationIndex < 2

    property Settings styleStore: Settings {{
        location: StandardPaths.writableLocation(StandardPaths.GenericConfigLocation) + "/kernorarc"
        category: "Style"
    }}

    function reloadGeneration() {{
        tokens.styleStore.sync();
        const value = String(tokens.styleStore.value("generation", "{default}"));
        tokens.generation = (value === "md1" || value === "md2" || value === "md3") ? value : "{default}";
        const colour = String(tokens.styleStore.value("colour", "{colour}"));
        const chosen = tokens.colourIds.indexOf(colour) >= 0 ? colour : "{colour}";
        if (chosen !== tokens.colour || (chosen !== "{colour}" && !tokens.colourPalettes)) {{
            tokens.colour = chosen;
            tokens.loadColour();
        }}
    }}

    // Any change of colour scheme may come with a change of generation.
    readonly property color schemeProbe: Kirigami.Theme.backgroundColor
    onSchemeProbeChanged: reloadGeneration()
    Component.onCompleted: reloadGeneration()
"""

FOOTER = """
    // --- helpers ------------------------------------------------------------

    // A Material state layer: the content colour laid over the container at a
    // fixed opacity, pre-blended so it can be used as a plain fill.
    function layer(base, content, opacity) {
        return Qt.rgba(base.r + (content.r - base.r) * opacity,
                       base.g + (content.g - base.g) * opacity,
                       base.b + (content.b - base.b) * opacity,
                       1.0)
    }

    function withAlpha(colour, alpha) {
        return Qt.rgba(colour.r, colour.g, colour.b, alpha)
    }

    // Rounds to whole device pixels so borders and dividers stay crisp.
    function px(value) {
        return Math.round(value * tokens.scale)
    }
}
"""


def qml_name(role: str) -> str:
    if role.startswith("on") and role[2:3].isupper():
        base = role[2].lower() + role[3:]
        return base + "Content"
    return role


def colour_lines() -> list[str]:
    lines = ["", "    // --- colour roles -------------------------------------------------------", ""]
    lines.append("    // True when the active Plasma colour scheme is a dark one. Kernora ships")
    lines.append("    // a dark scheme by default; the check keeps the shell correct if the")
    lines.append("    // user switches to the light one.")
    lines.append(
        "    readonly property bool dark: Kirigami.Theme.backgroundColor.hslLightness < 0.5"
    )
    lines.append("")
    lines.append("    // Every role of every generation in both modes.")
    def js(palette: dict[str, str]) -> str:
        return "{ " + ", ".join(f'{qml_name(role)}: "{palette[role]}"' for role in sorted(palette)) + " }"
    entries = []
    for generation in design.GENERATIONS:
        entries.append(
            f"        {generation}: {{ dark: {js(design.palette(generation, True))},\n"
            f"               light: {js(design.palette(generation, False))} }}"
        )
    lines.append("    readonly property var palettes: ({\n" + ",\n".join(entries) + "\n    })")
    lines.append("    property var colourPalettes: null")
    lines.append("    readonly property var activePalette: (tokens.colourPalettes || palettes)[tokens.generation][tokens.dark ? \"dark\" : \"light\"]")
    lines.append("    readonly property var roleNames: [" + ", ".join(f'"{qml_name(role)}"' for role in sorted(design.DARK)) + "]")
    lines.append("    property Component paletteReader: Component {")
    lines.append("        Settings {}")
    lines.append("    }")
    lines.append("    function loadColour() {")
    lines.append(f'        if (tokens.colour === "{design.DEFAULT_COLOUR}") {{')
    lines.append("            tokens.colourPalettes = null;")
    lines.append("            return;")
    lines.append("        }")
    lines.append('        const file = StandardPaths.locate(StandardPaths.GenericDataLocation, "kernora/palettes/" + tokens.colour + ".conf");')
    lines.append("        if (String(file).length === 0) {")
    lines.append("            tokens.colourPalettes = null;")
    lines.append("            return;")
    lines.append("        }")
    lines.append("        const reader = tokens.paletteReader.createObject(tokens, { location: file });")
    lines.append("        const result = {};")
    lines.append("        for (const generation of [" + ", ".join(f'"{g}"' for g in design.GENERATIONS) + "]) {")
    lines.append("            result[generation] = {};")
    lines.append('            for (const mode of ["dark", "light"]) {')
    lines.append("                const roles = {};")
    lines.append("                for (const role of tokens.roleNames) {")
    lines.append('                    const value = String(reader.value(generation + "-" + mode + "/" + role, ""));')
    lines.append('                    roles[role] = value.length > 0 ? "#" + value : tokens.palettes[generation][mode][role];')
    lines.append("                }")
    lines.append("                result[generation][mode] = roles;")
    lines.append("            }")
    lines.append("        }")
    lines.append("        reader.destroy();")
    lines.append("        tokens.colourPalettes = result;")
    lines.append("    }")
    lines.append("")
    for role in sorted(design.DARK):
        lines.append(f"    readonly property color {qml_name(role)}: tokens.activePalette.{qml_name(role)}")
    return lines


def scheme_lines() -> list[str]:
    roles = ("surface", "surfaceContainerLow", "surfaceContainer", "surfaceContainerHigh",
             "surfaceContainerHighest", "onSurface", "onSurfaceVariant", "primary", "onPrimary",
             "primaryContainer", "onPrimaryContainer", "secondaryContainer", "onSecondaryContainer",
             "tertiaryContainer", "onTertiaryContainer", "error", "onError", "outline", "outlineVariant",
             "inverseSurface", "inverseOnSurface")
    def js(palette: dict[str, str]) -> str:
        return "({ " + ", ".join(f'{qml_name(role)}: "{palette[role]}"' for role in roles) + " })"
    del js
    return [
        "",
        "    // Both palettes of the generation, whichever is active, for light and",
        "    // dark previews.",
        "    readonly property var darkScheme: (tokens.colourPalettes || palettes)[tokens.generation].dark",
        "    readonly property var lightScheme: (tokens.colourPalettes || palettes)[tokens.generation].light",
    ]


def accent_lines() -> list[str]:
    lines = ["", "    // --- accent families --------------------------------------------------", ""]
    lines.append("    // Harmonised extra hues, for category icons: {name, container, content}.")
    def js(dark: bool) -> str:
        items = ", ".join(
            f'{{ name: "{name}", container: "{container}", content: "{content}" }}'
            for name, container, content in design.accents(dark)
        )
        return f"[{items}]"
    lines.append(f"    readonly property var accents: tokens.dark ? {js(True)} : {js(False)}")
    lines.append("")
    lines.append("    function accent(index) {")
    lines.append("        return accents[((index % accents.length) + accents.length) % accents.length];")
    lines.append("    }")
    return lines


def shape_lines() -> list[str]:
    lines = ["", "    // --- shape scale --------------------------------------------------------", ""]
    for name, value in design.SHAPE.items():
        prop = "shape" + name[0].upper() + name[1:]
        lines.append(f"    readonly property int {prop}: {value}")
    lines.append("")
    lines.append("    // The corners of each kind of component in this generation; -1 rounds")
    lines.append("    // the short side fully. Read them through radius(kind, height).")
    table = ", ".join(f"{kind}: [{', '.join(str(v) for v in values)}]" for kind, values in design.CORNERS.items())
    lines.append(f"    readonly property var corners: ({{ {table} }})")
    for kind in design.CORNERS:
        prop = "corner" + kind[0].upper() + kind[1:]
        lines.append(f"    readonly property int {prop}: corners.{kind}[tokens.generationIndex]")
    lines.append("")
    lines.append("    // The corner radius of a component of this kind and height.")
    lines.append("    function radius(kind, height) {")
    lines.append("        const value = tokens.corners[kind][tokens.generationIndex];")
    lines.append("        return value < 0 ? height / 2 : Math.min(value, height / 2);")
    lines.append("    }")
    lines.append("")
    lines.append("    // --- elevation ----------------------------------------------------------")
    lines.append("")
    lines.append("    // Shadows: [blur, offset, opacity] at Material's levels 0-5.")
    levels = ", ".join(
        f"{generation}: [{', '.join(f'[{b}, {y}, {a}]' for b, y, a in design.ELEVATION[generation])}]"
        for generation in design.GENERATIONS
    )
    lines.append(f"    readonly property var elevations: ({{ {levels} }})")
    rests = ", ".join(f"{kind}: [{', '.join(str(v) for v in values)}]" for kind, values in design.ELEVATION_LEVEL.items())
    lines.append(f"    readonly property var elevationLevels: ({{ {rests} }})")
    lines.append("")
    lines.append("    // The shadow a component of this kind casts: { blur, offset, opacity }.")
    lines.append("    // (Not \"shadow\": that is the colour role.)")
    lines.append("    function elevationOf(kind) {")
    lines.append("        const level = tokens.elevationLevels[kind][tokens.generationIndex];")
    lines.append("        const value = tokens.elevations[tokens.generation][level];")
    lines.append("        return { blur: value[0], offset: value[1], opacity: value[2] };")
    lines.append("    }")
    lines.append("")
    lines.append("    // --- component behaviour ------------------------------------------------")
    lines.append("")
    behaviour = design.COMPONENT
    lines.append(
        "    readonly property bool buttonUppercase: "
        + " || ".join(f'tokens.generation === "{g}"' for g in design.GENERATIONS if behaviour[g]["buttonCase"] == "upper")
    )
    lines.append(f"    readonly property real buttonTracking: tokens.buttonUppercase ? {design.CLASSIC_BUTTON_TRACKING} : 0.1")
    lines.append(
        "    readonly property string tileStyle: "
        + " : ".join(f'tokens.generation === "{g}" ? "{behaviour[g]["tile"]}"' for g in design.GENERATIONS[:-1])
        + f' : "{behaviour[design.GENERATIONS[-1]]["tile"]}"'
    )
    lines.append(
        "    readonly property int slabGap: "
        + " : ".join(f'tokens.generation === "{g}" ? {behaviour[g]["slabGap"]}' for g in design.GENERATIONS[:-1])
        + f' : {behaviour[design.GENERATIONS[-1]]["slabGap"]}'
    )
    return lines


def spacing_lines() -> list[str]:
    lines = ["", "    // --- spacing ------------------------------------------------------------", ""]
    for name, value in design.SPACING.items():
        prop = "spacing" + name.upper()
        lines.append(f"    readonly property int {prop}: {value}")
    return lines


def state_lines() -> list[str]:
    lines = ["", "    // --- state layers -------------------------------------------------------", ""]
    for name, value in design.STATE.items():
        prop = "state" + name[0].upper() + name[1:]
        lines.append(f"    readonly property real {prop}: {value}")
    return lines


def motion_lines() -> list[str]:
    lines = ["", "    // --- motion -------------------------------------------------------------", ""]
    lines.append("    // Material durations, scaled by the user's animation speed setting so")
    lines.append("    // that turning animations down in System Settings is respected.")
    lines.append(
        "    readonly property real motionScale: Kirigami.Units.longDuration / 200"
    )
    for name, value in design.MOTION_DURATION.items():
        prop = "duration" + name[0].upper() + name[1:]
        lines.append(
            f"    readonly property int {prop}: Math.max(1, Math.round({value} * tokens.motionScale))"
        )
    lines.append("")
    for name, points in design.MOTION_EASING.items():
        prop = "easing" + name[0].upper() + name[1:]
        curve = ", ".join(f"{value}" for value in points)
        classic = ", ".join(f"{value}" for value in design.CLASSIC_EASING[name])
        lines.append(
            f"    readonly property var {prop}: tokens.classic ? [{classic}, 1.0, 1.0] : [{curve}, 1.0, 1.0]"
        )
    lines.append("")
    for name, (damping, response) in design.SPRING.items():
        prop = "spring" + name[0].upper() + name[1:]
        lines.append(f"    readonly property real {prop}Damping: {damping}")
        lines.append(f"    readonly property real {prop}Response: {response}")
    return lines


def type_lines() -> list[str]:
    lines = ["", "    // --- typography ---------------------------------------------------------", ""]
    lines.append(f'    readonly property string typeface: "{design.TYPEFACE}"')
    lines.append(
        f'    readonly property string typefaceFallback: "{design.TYPEFACE_FALLBACK}"'
    )
    lines.append("")
    lines.append("    // The type scale is in density independent pixels. It follows the")
    lines.append("    // user's font size: gridUnit is the height of one line of the desktop")
    lines.append("    // font, 18 pixels at the default size Material's scale assumes.")
    lines.append(
        "    readonly property real scale: Kirigami.Units.gridUnit / 18"
    )
    lines.append("")
    def pick(style: str, index: int) -> str:
        values = [design.type_style(style, g)[index] for g in design.GENERATIONS]
        if len(set(values)) == 1:
            return str(values[0])
        return f"[{', '.join(str(v) for v in values)}][tokens.generationIndex]"
    for style in design.TYPE_SCALE:
        lines.append(
            f"    readonly property font {style}: Qt.font({{"
            f" family: tokens.typeface, pixelSize: Math.round({pick(style, 0)} * tokens.scale),"
            f" weight: {pick(style, 2)}, letterSpacing: {pick(style, 3)} }})"
        )
    lines.append("    // Button labels: Material 3's label style; capitals spaced out in the older")
    lines.append("    // generations.")
    lines.append(
        "    readonly property font button: Qt.font({ family: tokens.typeface,"
        " pixelSize: Math.round(14 * tokens.scale), weight: 500, letterSpacing: tokens.buttonTracking,"
        " capitalization: tokens.buttonUppercase ? Font.AllUppercase : Font.MixedCase })"
    )
    lines.append("    readonly property int buttonLineHeight: Math.round(20 * tokens.scale)")
    lines.append("")
    for style in design.TYPE_SCALE:
        prop = style + "LineHeight"
        lines.append(
            f"    readonly property int {prop}: Math.round({pick(style, 1)} * tokens.scale)"
        )
    return lines


def render() -> str:
    parts = [HEADER.format(seed=design.SEED, default=design.DEFAULT_GENERATION, colour=design.DEFAULT_COLOUR,
                           colour_ids="[" + ", ".join(f'"{c}"' for c in design.COLOURS) + "]")]
    parts.append("\n".join(colour_lines()))
    parts.append("\n".join(accent_lines()))
    parts.append("\n".join(scheme_lines()))
    parts.append("\n".join(shape_lines()))
    parts.append("\n".join(spacing_lines()))
    parts.append("\n".join(state_lines()))
    parts.append("\n".join(motion_lines()))
    parts.append("\n".join(type_lines()))
    parts.append(FOOTER)
    return "\n".join(parts) + "\n"


def palette_file() -> str:
    info = design.COLOURS[design.COLOUR]
    md3 = {mode: design.palette("md3", mode == "dark") for mode in ("dark", "light")}
    lines = [
        "[Colour]",
        f"id={design.COLOUR}",
        f"order={list(design.COLOURS).index(design.COLOUR)}",
        f"seed={design.SEED.lstrip('#')}",
        f"name={info['en']}",
        f"name_ru={info['ru']}",
    ]
    for mode in ("dark", "light"):
        for role in ("primary", "secondaryContainer", "tertiary"):
            lines.append(f"{mode}_{role}={md3[mode][role].lstrip('#')}")
    for generation in design.GENERATIONS:
        for mode in ("dark", "light"):
            lines.append("")
            lines.append(f"[{generation}-{mode}]")
            roles = design.palette(generation, mode == "dark")
            for role in sorted(roles):
                lines.append(f"{qml_name(role)}={roles[role].lstrip('#')}")
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[1] == "--palette":
        output = pathlib.Path(argv[2])
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(palette_file(), encoding="utf-8")
        print(f"colour palette: {output}")
        return 0
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    output = pathlib.Path(argv[1])
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(render(), encoding="utf-8")
    print(f"design tokens: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
