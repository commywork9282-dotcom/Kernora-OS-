#!/usr/bin/env python3
"""usage: gen-browser-theme OUTPUT.xpi USERCHROME.css
"""

from __future__ import annotations

import json
import pathlib
import sys
import zipfile

import kernora_design as design
import m3color

THEME_ID = "theme@kernora.os"


def colours(roles: dict[str, str]) -> dict[str, str]:
    return {
        "frame": roles["surfaceContainer"],
        "frame_inactive": roles["surfaceContainerLow"],
        "tab_background_text": roles["onSurfaceVariant"],
        "tab_text": roles["onSurface"],
        "tab_selected": roles["surfaceContainerHighest"],
        "tab_loading": roles["primary"],
        "toolbar": roles["surfaceContainerHigh"],
        "toolbar_text": roles["onSurface"],
        "toolbar_top_separator": roles["surfaceContainerHigh"],
        "toolbar_bottom_separator": roles["surfaceContainerHigh"],
        "toolbar_vertical_separator": roles["outlineVariant"],
        "toolbar_field": roles["surfaceContainerHighest"],
        "toolbar_field_text": roles["onSurface"],
        "toolbar_field_border": roles["surfaceContainerHighest"],
        "toolbar_field_focus": roles["surfaceContainerHighest"],
        "toolbar_field_text_focus": roles["onSurface"],
        "toolbar_field_border_focus": roles["primary"],
        "toolbar_field_highlight": roles["primaryContainer"],
        "toolbar_field_highlight_text": roles["onPrimaryContainer"],
        "icons": roles["onSurfaceVariant"],
        "icons_attention": roles["primary"],
        "button_background_hover": roles["surfaceContainerHighest"],
        "button_background_active": roles["secondaryContainer"],
        "popup": roles["surfaceContainer"],
        "popup_text": roles["onSurface"],
        "popup_border": roles["surfaceContainer"],
        "popup_highlight": roles["secondaryContainer"],
        "popup_highlight_text": roles["onSecondaryContainer"],
        "sidebar": roles["surfaceContainerLow"],
        "sidebar_text": roles["onSurface"],
        "sidebar_border": roles["surfaceContainerLow"],
        "sidebar_highlight": roles["secondaryContainer"],
        "sidebar_highlight_text": roles["onSecondaryContainer"],
        "ntp_background": roles["surface"],
        "ntp_card_background": roles["surfaceContainer"],
        "ntp_text": roles["onSurface"],
    }


def mix(roles: dict[str, str], base: str, layer: str, amount: float) -> str:
    a = m3color.rgb_from_hex(roles[base])
    b = m3color.rgb_from_hex(roles[layer])
    return m3color.hex_from_rgb(tuple(round(a[i] + (b[i] - a[i]) * amount) for i in range(3)))


def alpha(roles: dict[str, str], role: str, amount: float) -> str:
    r, g, b = m3color.rgb_from_hex(roles[role])
    return f"rgba({r}, {g}, {b}, {amount})"


def button_colours(r: dict[str, str]) -> str:
    return f"""button[dlgtype] {{
    background-color: {r["secondaryContainer"]} !important;
    color: {r["onSecondaryContainer"]} !important;
    outline-color: {r["primary"]} !important;
  }}

  button[dlgtype]:hover {{
    background-color: {mix(r, "secondaryContainer", "onSecondaryContainer", 0.08)} !important;
  }}

  button[dlgtype]:hover:active {{
    background-color: {mix(r, "secondaryContainer", "onSecondaryContainer", 0.12)} !important;
  }}

  button[dlgtype][default] {{
    background-color: {r["primary"]} !important;
    color: {r["onPrimary"]} !important;
  }}

  button[dlgtype][default]:hover {{
    background-color: {mix(r, "primary", "onPrimary", 0.08)} !important;
  }}

  button[dlgtype][default]:hover:active {{
    background-color: {mix(r, "primary", "onPrimary", 0.12)} !important;
  }}

  button[dlgtype][disabled] {{
    background-color: {alpha(r, "onSurface", 0.12)} !important;
    color: {alpha(r, "onSurface", 0.38)} !important;
  }}"""


def chrome_stylesheet() -> str:
    corner = design.corner("button", "md3")
    radius = "9999px" if corner == design.FULL else f"{corner}px"
    return f"""@namespace url("http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul");

button[dlgtype] {{
  appearance: none !important;
  min-width: 64px !important;
  min-height: 40px !important;
  margin: 12px 0 0 !important;
  margin-inline-start: 8px !important;
  padding: 0 24px !important;
  border: none !important;
  border-radius: {radius} !important;
  font-weight: 500 !important;
  outline-offset: 2px !important;
}}

button[dlgtype]:focus-visible {{
  outline-style: solid !important;
  outline-width: 2px !important;
}}

@media (prefers-color-scheme: light) {{
  {button_colours(design.LIGHT)}
}}

@media (prefers-color-scheme: dark) {{
  {button_colours(design.DARK)}
}}
"""


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    manifest = {
        "manifest_version": 2,
        "name": "Kernora",
        "version": "1.0",
        "description": "The Kernora Material 3 colours for the browser.",
        "browser_specific_settings": {"gecko": {"id": THEME_ID}},
        "theme": {"colors": colours(design.LIGHT), "properties": {"color_scheme": "light", "content_color_scheme": "system"}},
        "dark_theme": {"colors": colours(design.DARK), "properties": {"color_scheme": "dark", "content_color_scheme": "system"}},
    }
    output = pathlib.Path(argv[1])
    output.parent.mkdir(parents=True, exist_ok=True)
    info = zipfile.ZipInfo("manifest.json", date_time=(2026, 1, 1, 0, 0, 0))
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = 0o644 << 16
    with zipfile.ZipFile(output, "w") as archive:
        archive.writestr(info, json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    stylesheet = pathlib.Path(argv[2])
    stylesheet.parent.mkdir(parents=True, exist_ok=True)
    stylesheet.write_text(chrome_stylesheet(), encoding="utf-8")
    print(f"browser theme: {output}, {stylesheet}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
