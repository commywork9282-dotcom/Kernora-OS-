#!/usr/bin/env python3
"""usage: gen-browser-theme OUTPUT.xpi
"""

from __future__ import annotations

import json
import pathlib
import sys
import zipfile

import kernora_design as design

THEME_ID = "theme@kernora.os"


def colours(roles: dict[str, str]) -> dict[str, str]:
    return {
        "frame": roles["surfaceContainer"],
        "frame_inactive": roles["surfaceContainerLow"],
        "tab_background_text": roles["onSurfaceVariant"],
        "tab_text": roles["onSurface"],
        "tab_selected": roles["surfaceContainerHighest"],
        "tab_loading": roles["primary"],
        "toolbar": roles["surfaceContainerHigh"],
        "toolbar_text": roles["onSurface"],
        "toolbar_top_separator": roles["surfaceContainerHigh"],
        "toolbar_bottom_separator": roles["surfaceContainerHigh"],
        "toolbar_vertical_separator": roles["outlineVariant"],
        "toolbar_field": roles["surfaceContainerHighest"],
        "toolbar_field_text": roles["onSurface"],
        "toolbar_field_border": roles["surfaceContainerHighest"],
        "toolbar_field_focus": roles["surfaceContainerHighest"],
        "toolbar_field_text_focus": roles["onSurface"],
        "toolbar_field_border_focus": roles["primary"],
        "toolbar_field_highlight": roles["primaryContainer"],
        "toolbar_field_highlight_text": roles["onPrimaryContainer"],
        "icons": roles["onSurfaceVariant"],
        "icons_attention": roles["primary"],
        "button_background_hover": roles["surfaceContainerHighest"],
        "button_background_active": roles["secondaryContainer"],
        "popup": roles["surfaceContainer"],
        "popup_text": roles["onSurface"],
        "popup_border": roles["surfaceContainer"],
        "popup_highlight": roles["secondaryContainer"],
        "popup_highlight_text": roles["onSecondaryContainer"],
        "sidebar": roles["surfaceContainerLow"],
        "sidebar_text": roles["onSurface"],
        "sidebar_border": roles["surfaceContainerLow"],
        "sidebar_highlight": roles["secondaryContainer"],
        "sidebar_highlight_text": roles["onSecondaryContainer"],
        "ntp_background": roles["surface"],
        "ntp_card_background": roles["surfaceContainer"],
        "ntp_text": roles["onSurface"],
    }


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    manifest = {
        "manifest_version": 2,
        "name": "Kernora",
        "version": "1.0",
        "description": "The Kernora Material 3 colours for the browser.",
        "browser_specific_settings": {"gecko": {"id": THEME_ID}},
        "theme": {"colors": colours(design.LIGHT), "properties": {"color_scheme": "light", "content_color_scheme": "system"}},
        "dark_theme": {"colors": colours(design.DARK), "properties": {"color_scheme": "dark", "content_color_scheme": "system"}},
    }
    output = pathlib.Path(argv[1])
    output.parent.mkdir(parents=True, exist_ok=True)
    info = zipfile.ZipInfo("manifest.json", date_time=(2026, 1, 1, 0, 0, 0))
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = 0o644 << 16
    with zipfile.ZipFile(output, "w") as archive:
        archive.writestr(info, json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    print(f"browser theme: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
