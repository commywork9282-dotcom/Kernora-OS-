def stylesheet() -> str:
    classes = {
        "ColorScheme-Text": DARK["onSurface"],
        "ColorScheme-Background": DARK["surfaceContainer"],
        "ColorScheme-Highlight": DARK["primary"],
        "ColorScheme-HighlightedText": DARK["onPrimary"],
        "ColorScheme-ButtonBackground": DARK["surfaceContainerHighest"],
        "ColorScheme-ButtonText": DARK["onSurface"],
        "ColorScheme-ViewBackground": DARK["surfaceContainer"],
        "ColorScheme-NegativeText": DARK["error"],
        "ColorScheme-NeutralText": DARK["neutralYellow"],
        "ColorScheme-PositiveText": DARK["positive"],
    }
    rules = "\n".join(f"      .{name} {{ color:{value}; }}" for name, value in classes.items())
    return (
        '  <defs>\n'
        '    <style type="text/css" id="current-color-scheme">\n'
        f"{rules}\n"
        "    </style>\n"
        "{gradients}"
        "  </defs>\n"
    )


def fmt(value: float) -> str:
    text = f"{value:.4f}".rstrip("0").rstrip(".")
    return text if text not in ("", "-0") else "0"


class Sheet:

    def __init__(self) -> None:
        self.parts: list[str] = []
        self.gradients: list[str] = []
        self.cursor_y = 0.0
        self.cursor_x = 0.0
        self.row_height = 0.0
        self.width = 0.0

    def place(self, width: float, height: float) -> tuple[float, float]:
        if self.cursor_x + width > 1600:
            self.cursor_x = 0.0
            self.cursor_y += self.row_height + 16
            self.row_height = 0.0
        x, y = self.cursor_x, self.cursor_y
        self.cursor_x += width + 16
        self.row_height = max(self.row_height, height)
        self.width = max(self.width, self.cursor_x)
        return x, y

    def add(self, text: str) -> None:
        self.parts.append("  " + text)

    def hint(self, element: str, width: float, height: float) -> None:
        x, y = self.place(max(width, 1), max(height, 1))
        self.add(
            f'<rect id="{element}" x="{fmt(x)}" y="{fmt(y)}" '
            f'width="{fmt(width)}" height="{fmt(height)}" fill="none"/>'
        )

    def render(self) -> str:
        height = self.cursor_y + self.row_height + 16
        gradients = "".join("    " + g + "\n" for g in self.gradients)
        head = stylesheet().replace("{gradients}", gradients)
        return (
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            "<!-- Kernora Plasma theme. Generated by tools/gen-plasma-theme from the\n"
            f"     Material 3 tokens (seed {design.SEED}); do not edit by hand. -->\n"
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{fmt(self.width)}" '
            f'height="{fmt(height)}">\n'
            + head
            + "\n".join(self.parts)
            + "\n</svg>\n"
        )


def paint(css_class: str, opacity: float) -> str:
    return (
        f'class="{css_class}" fill="currentColor" '
        f'fill-opacity="{fmt(opacity)}" stroke="none"'
    )


EDGE = 4.0


def corner_path(x: float, y: float, r: float, corner: str) -> str:
    if r <= 0:
        return f"M{fmt(x)},{fmt(y)}h1v1h-1z"
    if corner == "topleft":
        return (f"M{fmt(x)},{fmt(y + r)}A{fmt(r)},{fmt(r)} 0 0 1 {fmt(x + r)},{fmt(y)}"
                f"H{fmt(x + r)}V{fmt(y + r)}Z")
    if corner == "topright":
        return (f"M{fmt(x)},{fmt(y)}A{fmt(r)},{fmt(r)} 0 0 1 {fmt(x + r)},{fmt(y + r)}"
                f"H{fmt(x)}Z")
    if corner == "bottomright":
        return (f"M{fmt(x)},{fmt(y)}H{fmt(x + r)}A{fmt(r)},{fmt(r)} 0 0 1 {fmt(x)},{fmt(y + r)}Z")
    return (f"M{fmt(x)},{fmt(y)}H{fmt(x + r)}V{fmt(y + r)}"
            f"A{fmt(r)},{fmt(r)} 0 0 1 {fmt(x)},{fmt(y)}Z")


def ring_corner_path(x: float, y: float, r: float, width: float, corner: str) -> str:
    inner = max(r - width, 0.0)
    if corner == "topleft":
        cx, cy = x + r, y + r
        a0, a1 = 180, 270
    elif corner == "topright":
        cx, cy = x, y + r
        a0, a1 = 270, 360
    elif corner == "bottomright":
        cx, cy = x, y
        a0, a1 = 0, 90
    else:
        cx, cy = x + r, y
        a0, a1 = 90, 180

    def point(radius: float, angle: float) -> tuple[float, float]:
        rad = math.radians(angle)
        return cx + radius * math.cos(rad), cy + radius * math.sin(rad)

    ox0, oy0 = point(r, a0)
    ox1, oy1 = point(r, a1)
    ix1, iy1 = point(inner, a1)
    ix0, iy0 = point(inner, a0)
    path = (f"M{fmt(ox0)},{fmt(oy0)}A{fmt(r)},{fmt(r)} 0 0 1 {fmt(ox1)},{fmt(oy1)}"
            f"L{fmt(ix1)},{fmt(iy1)}")
    if inner > 0:
        path += f"A{fmt(inner)},{fmt(inner)} 0 0 0 {fmt(ix0)},{fmt(iy0)}"
    else:
        path += f"L{fmt(ix0)},{fmt(iy0)}"
    return path + "Z"


def frame(
    sheet: Sheet,
    prefix: str,
    radius: float,
    css_class: str,
    opacity: float,
    margins: float | tuple[float, float, float, float] | None = None,
    insets: float | None = None,
    mask: bool = False,
    ring: float | None = None,
) -> None:
    r = max(float(radius), 1.0)
    names = {
        "topleft": (0, 0), "top": (r, 0), "topright": (r + EDGE, 0),
        "left": (0, r), "center": (r, r), "right": (r + EDGE, r),
        "bottomleft": (0, r + EDGE), "bottom": (r, r + EDGE),
        "bottomright": (r + EDGE, r + EDGE),
    }
    box_x, box_y = sheet.place(2 * r + EDGE, 2 * r + EDGE)
    attributes = paint(css_class, opacity)

    for element_prefix in ([prefix] + ([f"mask-{prefix}"] if mask else [])):
        if element_prefix != prefix:
            box_x, box_y = sheet.place(2 * r + EDGE, 2 * r + EDGE)
        for name, (dx, dy) in names.items():
            x, y = box_x + dx, box_y + dy
            element = f"{element_prefix}{name}"
            is_mask = element_prefix != prefix
            fill = 'fill="#000000"' if is_mask else attributes
            if name in ("topleft", "topright", "bottomleft", "bottomright"):
                if ring is not None and not is_mask:
                    d = ring_corner_path(x, y, r, ring, name)
                else:
                    d = corner_path(x, y, r, name)
                sheet.add(f'<path id="{element}" d="{d}" {fill}/>')
                continue
            if name == "center":
                if ring is not None and not is_mask:
                    sheet.add(
                        f'<rect id="{element}" x="{fmt(x)}" y="{fmt(y)}" '
                        f'width="{fmt(EDGE)}" height="{fmt(EDGE)}" fill="none"/>'
                    )
                    continue
                w, h = EDGE, EDGE
            elif name in ("top", "bottom"):
                w, h = EDGE, r
            else:
                w, h = r, EDGE
            if ring is not None and not is_mask:
                if name == "top":
                    h = ring
                elif name == "bottom":
                    y, h = y + r - ring, ring
                elif name == "left":
                    w = ring
                else:
                    x, w = x + r - ring, ring
                sheet.add(
                    f'<g id="{element}">'
                    f'<rect x="{fmt(box_x + dx)}" y="{fmt(box_y + dy)}" '
                    f'width="{fmt(EDGE if name in ("top", "bottom") else r)}" '
                    f'height="{fmt(r if name in ("top", "bottom") else EDGE)}" fill="none"/>'
                    f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" {attributes}/>'
                    "</g>"
                )
                continue
            sheet.add(
                f'<rect id="{element}" x="{fmt(x)}" y="{fmt(y)}" '
                f'width="{fmt(w)}" height="{fmt(h)}" {fill}/>'
            )

    if margins is not None:
        top, right, bottom, left = (
            margins if isinstance(margins, tuple) else (margins,) * 4
        )
        sheet.hint(f"{prefix}hint-top-margin", top, top)
        sheet.hint(f"{prefix}hint-right-margin", right, right)
        sheet.hint(f"{prefix}hint-bottom-margin", bottom, bottom)
        sheet.hint(f"{prefix}hint-left-margin", left, left)
    if insets is not None:
        for side in ("top", "right", "bottom", "left"):
            sheet.hint(f"{prefix}hint-{side}-inset", insets, insets)


def shadow(sheet: Sheet, size: float, radius: float, alpha: float, gradient_id: str,
           cutout: bool = False) -> None:
    tile = size + radius
    extents = {side: round(size * (0.6 if side == "top" else 1.0))
               for side in ("top", "right", "bottom", "left")}
    stops = (
        f'<stop offset="0" stop-color="#000000" stop-opacity="{fmt(alpha)}"/>'
        f'<stop offset="{fmt(radius / tile)}" stop-color="#000000" stop-opacity="{fmt(alpha)}"/>'
        f'<stop offset="{fmt((radius + size * 0.35) / tile)}" stop-color="#000000" stop-opacity="{fmt(alpha * 0.45)}"/>'
        f'<stop offset="{fmt((radius + size * 0.7) / tile)}" stop-color="#000000" stop-opacity="{fmt(alpha * 0.12)}"/>'
        f'<stop offset="1" stop-color="#000000" stop-opacity="0"/>'
    )
    corners = {
        "topleft": (tile, tile),
        "topright": (0, tile),
        "bottomleft": (tile, 0),
        "bottomright": (0, 0),
    }
    for name, (cx, cy) in corners.items():
        x, y = sheet.place(tile, tile)
        gid = f"{gradient_id}-{name}"
        sheet.gradients.append(
            f'<radialGradient id="{gid}" gradientUnits="userSpaceOnUse" '
            f'cx="{fmt(x + cx)}" cy="{fmt(y + cy)}" r="{fmt(tile)}">{stops}</radialGradient>'
        )
        if cutout:
            outer = f"M{fmt(x)},{fmt(y)}h{fmt(tile)}v{fmt(tile)}h{fmt(-tile)}Z"
            sheet.add(
                f'<path id="shadow-{name}" d="{outer}{shadow_hole(x, y, tile, radius, extents, name)}" '
                f'fill-rule="evenodd" fill="url(#{gid})"/>'
            )
            continue
        sheet.add(
            f'<rect id="shadow-{name}" x="{fmt(x)}" y="{fmt(y)}" width="{fmt(tile)}" '
            f'height="{fmt(tile)}" fill="url(#{gid})"/>'
        )

    edge_stops = (
        f'<stop offset="0" stop-color="#000000" stop-opacity="{fmt(alpha)}"/>'
        f'<stop offset="0.35" stop-color="#000000" stop-opacity="{fmt(alpha * 0.45)}"/>'
        f'<stop offset="0.7" stop-color="#000000" stop-opacity="{fmt(alpha * 0.12)}"/>'
        f'<stop offset="1" stop-color="#000000" stop-opacity="0"/>'
    )
    edges = {
        "top": (1, size, (0, 1, 0, 0)),
        "bottom": (1, size, (0, 0, 0, 1)),
        "left": (size, 1, (1, 0, 0, 0)),
        "right": (size, 1, (0, 0, 1, 0)),
    }
    for name, (w, h, (x1, y1, x2, y2)) in edges.items():
        x, y = sheet.place(w, h)
        gid = f"{gradient_id}-{name}"
        sheet.gradients.append(
            f'<linearGradient id="{gid}" gradientUnits="userSpaceOnUse" '
            f'x1="{fmt(x + x1 * w)}" y1="{fmt(y + y1 * h)}" '
            f'x2="{fmt(x + x2 * w)}" y2="{fmt(y + y2 * h)}">{edge_stops}</linearGradient>'
        )
        if cutout and name == "top" and extents["top"] + SHADOW_SEAM < h:
            sheet.add(
                f'<g id="shadow-{name}">'
                f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" fill="none"/>'
                f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" '
                f'height="{fmt(extents["top"] + SHADOW_SEAM)}" fill="url(#{gid})"/>'
                "</g>"
            )
            continue
        sheet.add(
            f'<rect id="shadow-{name}" x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" '
            f'height="{fmt(h)}" fill="url(#{gid})"/>'
        )
    x, y = sheet.place(1, 1)
    sheet.add(f'<rect id="shadow-center" x="{fmt(x)}" y="{fmt(y)}" width="1" height="1" fill="none"/>')
    for side, extent in extents.items():
        sheet.hint(f"shadow-hint-{side}-margin", extent, extent)


def shadow_hole(x: float, y: float, tile: float, radius: float,
                extents: dict[str, int], corner: str) -> str:
    r = max(radius - SHADOW_SEAM, 0.0)
    left = x + extents["left"] + SHADOW_SEAM
    right = x + tile - extents["right"] - SHADOW_SEAM
    top = y + extents["top"] + SHADOW_SEAM
    bottom = y + tile - extents["bottom"] - SHADOW_SEAM
    end_x, end_y = x + tile, y + tile
    if corner == "topleft":
        return (f"M{fmt(left)},{fmt(top + r)}A{fmt(r)},{fmt(r)} 0 0 1 {fmt(left + r)},{fmt(top)}"
                f"H{fmt(end_x)}V{fmt(end_y)}H{fmt(left)}Z")
    if corner == "topright":
        return (f"M{fmt(x)},{fmt(top)}H{fmt(right - r)}A{fmt(r)},{fmt(r)} 0 0 1 {fmt(right)},{fmt(top + r)}"
                f"V{fmt(end_y)}H{fmt(x)}Z")
    if corner == "bottomleft":
        return (f"M{fmt(left)},{fmt(y)}H{fmt(end_x)}V{fmt(bottom)}H{fmt(left + r)}"
                f"A{fmt(r)},{fmt(r)} 0 0 1 {fmt(left)},{fmt(bottom - r)}Z")
    return (f"M{fmt(x)},{fmt(y)}H{fmt(right)}V{fmt(bottom - r)}"
            f"A{fmt(r)},{fmt(r)} 0 0 1 {fmt(right - r)},{fmt(bottom)}H{fmt(x)}Z")


def panel_background(opacity: float = PANEL_OPACITY) -> str:
    sheet = Sheet()
    frame(sheet, "", PANEL_RADIUS, "ColorScheme-Background", opacity,
          margins=PANEL_PADDING, insets=0, mask=True)
    frame(sheet, "thick-", PANEL_RADIUS, "ColorScheme-Background", opacity,
          margins=PANEL_PADDING)
    frame(sheet, "floating-", PANEL_RADIUS, "ColorScheme-Background", opacity,
          margins=PANEL_FLOAT_GAP)
    shadow(sheet, SHADOW_PANEL[0], PANEL_RADIUS, SHADOW_PANEL[1], "panel-shadow", cutout=True)
    return sheet.render()


