def metadata(plugin: str = "kernora", name: str = "Kernora", name_ru: str = "Kernora") -> str:
    return json.dumps(
        {
            "KPlugin": {
                "Authors": [{"Name": "Kernora Developers"}],
                "Category": "",
                "Description": f"{design.GENERATION_TITLE[design.GENERATION]} desktop theme of Kernora OS",
                "Description[ru]": f"Тема рабочего стола Kernora OS в стиле {design.GENERATION_TITLE[design.GENERATION]}",
                "EnabledByDefault": True,
                "Id": plugin,
                "License": "GPL-2.0+",
                "Name": name,
                "Name[ru]": name_ru,
                "Version": "1.0",
            },
            "X-Plasma-API": "5.0",
        },
        indent=4,
    ) + "\n"


PLASMARC = """[Wallpaper]
defaultWallpaperTheme=Kernora
defaultFileSuffix=.png
defaultWidth=1672
defaultHeight=941

[BlurBehindEffect]
enabled=true

[ContrastEffect]
enabled=false

[AdaptiveTransparency]
enabled=true
"""


SHARED = ("dialogs", "icons", "solid", "widgets")


def link_shared(theme: pathlib.Path, base: pathlib.Path) -> None:
    theme.mkdir(parents=True, exist_ok=True)
    for name in SHARED:
        link = theme / name
        if link.is_symlink() or link.is_file():
            link.unlink()
        elif link.exists():
            shutil.rmtree(link)
        link.symlink_to(os.path.relpath(base / name, theme))


def main(argv: list[str]) -> int:
    if len(argv) not in (3, 4):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    symbols = pathlib.Path(argv[1])
    output = pathlib.Path(argv[2])
    base = pathlib.Path(argv[3]) if len(argv) == 4 else None
    if base is not None:
        link_shared(output, base)
        return write_variants(output, base)

    files = {
        "widgets/panel-background.svg": panel_background(),
        "solid/widgets/panel-background.svg": panel_background(1.0),
        "dialogs/background.svg": dialog_background(),
        "solid/dialogs/background.svg": dialog_background(),
        "widgets/background.svg": widget_background(),
        "widgets/tooltip.svg": tooltip(),
        "solid/widgets/tooltip.svg": tooltip(),
        "widgets/tasks.svg": tasks(),
        "widgets/listitem.svg": listitem(),
        "widgets/viewitem.svg": viewitem(),
        "widgets/line.svg": line(),
        "widgets/margins-highlight.svg": margins_highlight(),
        "widgets/scrollbar.svg": scrollbar(),
        "widgets/plasmoidheading.svg": plasmoidheading(),
        "widgets/slider.svg": slider(),
        "widgets/tabbar.svg": tabbar(),
        "widgets/button.svg": button(),
        "widgets/lineedit.svg": lineedit(),
    }
    for sheet_name, content in icon_sheets(symbols).items():
        files[f"icons/{sheet_name}.svg"] = content

    for relative, content in files.items():
        path = output / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
    print(f"plasma theme: {len(files)} SVG files in {output}")
    return write_variants(output, None)


def write_variants(output: pathlib.Path, base: pathlib.Path | None) -> int:
    label = design.GENERATION_LABEL[design.GENERATION]
    name = f"Kernora{design.COLOUR_LABEL}{label}"
    name_ru = f"Kernora{design.COLOUR_LABEL_RU}{label}"
    (output / "metadata.json").write_text(metadata(output.name, name, name_ru), encoding="utf-8")
    (output / "plasmarc").write_text(PLASMARC, encoding="utf-8")
    (output / "colors").write_text(
        kde_colors.render(True, THEME_SURFACES, name=f"{name} Plasma", selection=kde_colors.ACCENT_SELECTION), encoding="utf-8"
    )

    light = output.parent / f"{output.name}-light"
    if light.is_symlink() or light.is_file():
        light.unlink()
    elif light.exists():
        shutil.rmtree(light)
    if base is None:
        shutil.copytree(output, light)
    else:
        link_shared(light, base)
        (light / "plasmarc").write_text(PLASMARC, encoding="utf-8")
    (light / "metadata.json").write_text(
        metadata(f"{output.name}-light", f"{name} Light", f"{name_ru}, светлая"), encoding="utf-8")
    (light / "colors").write_text(
        kde_colors.render(False, THEME_SURFACES, name=f"{name} Plasma Light", selection=kde_colors.ACCENT_SELECTION), encoding="utf-8"
    )
    print(f"plasma theme: {output} and {light}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
