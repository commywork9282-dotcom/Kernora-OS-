THEME_ICON_SHEETS = (
    "audio", "battery", "computer", "configure", "device", "disk", "document",
    "drive", "edit", "go", "input", "keyboard", "klipper", "list", "mail",
    "media", "network", "notification", "phone", "preferences", "printer",
    "search", "system", "user", "video", "view", "window", "zoom",
)

SYMBOL_BODY = re.compile(r"<svg[^>]*>(.*)</svg>\s*$", re.S)


def icon_sheets(symbols: pathlib.Path) -> dict[str, str]:
    by_sheet: dict[str, list[tuple[str, str]]] = {name: [] for name in THEME_ICON_SHEETS}
    for symbol, fill, _context, names in symbols_map.ICONS:
        source = symbols / symbols_map.asset_name(symbol, fill)
        body = SYMBOL_BODY.search(source.read_text(encoding="utf-8")).group(1).strip()
        for name in symbols_map.aliases(names):
            sheet_name = name.split("-", 1)[0]
            if sheet_name in by_sheet and name not in {n for n, _ in by_sheet[sheet_name]}:
                by_sheet[sheet_name].append((name, body))

    result: dict[str, str] = {}
    for sheet_name, icons in by_sheet.items():
        if not icons:
            continue
        sheet = Sheet()
        for name, body in icons:
            x, y = sheet.place(24, 24)
            sheet.add(
                f'<g id="{name}"><rect x="{fmt(x)}" y="{fmt(y)}" width="24" height="24" fill="none"/>'
                f'<g transform="translate({fmt(x)},{fmt(y)}) scale(0.025) translate(0,960)" '
                f'class="ColorScheme-Text" fill="currentColor">{body}</g></g>'
            )
        result[sheet_name] = sheet.render()
    return result


