def tasks() -> str:
    sheet = Sheet()
    states = {
        "normal-": ("ColorScheme-Text", 0.06),
        "minimized-": ("ColorScheme-Text", 0.03),
        "hover-": ("ColorScheme-Text", STATE["hover"] + 0.04),
        "launcher-hover-": ("ColorScheme-Text", STATE["hover"] + 0.04),
        "focus-": ("ColorScheme-Highlight", 0.24),
        "focus-hover-": ("ColorScheme-Highlight", 0.32),
        "attention-": ("ColorScheme-NeutralText", 0.32),
        "progress-": ("ColorScheme-Highlight", 0.30),
    }
    for prefix, (css_class, opacity) in states.items():
        chip(sheet, prefix, TASK_CHIP_RADIUS, TASK_CHIP_INSET, css_class, opacity,
             margins=TASK_PADDING if prefix == "normal-" else None)
    return sheet.render()


def chip(sheet: Sheet, prefix: str, radius: float, inset: float, css_class: str,
         opacity: float, margins: float | None = None) -> None:
    r = max(float(radius), 1.0)
    side = inset + r
    box_x, box_y = sheet.place(2 * side + EDGE, 2 * side + EDGE)
    attributes = paint(css_class, opacity)
    pieces = {
        "topleft": ((0, 0), (side, side), "corner", (inset, inset)),
        "top": ((side, 0), (EDGE, side), (0, inset, EDGE, r), None),
        "topright": ((side + EDGE, 0), (side, side), "corner", (0, inset)),
        "left": ((0, side), (side, EDGE), (inset, 0, r, EDGE), None),
        "center": ((side, side), (EDGE, EDGE), (0, 0, EDGE, EDGE), None),
        "right": ((side + EDGE, side), (side, EDGE), (0, 0, r, EDGE), None),
        "bottomleft": ((0, side + EDGE), (side, side), "corner", (inset, 0)),
        "bottom": ((side, side + EDGE), (EDGE, side), (0, 0, EDGE, r), None),
        "bottomright": ((side + EDGE, side + EDGE), (side, side), "corner", (0, 0)),
    }
    for name, ((dx, dy), (w, h), shape, offset) in pieces.items():
        x, y = box_x + dx, box_y + dy
        if shape == "corner":
            body = f'<path d="{corner_path(x + offset[0], y + offset[1], r, name)}" {attributes}/>'
        else:
            sx, sy, sw, sh = shape
            body = (f'<rect x="{fmt(x + sx)}" y="{fmt(y + sy)}" width="{fmt(sw)}" '
                    f'height="{fmt(sh)}" {attributes}/>')
        sheet.add(
            f'<g id="{prefix}{name}">'
            f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" fill="none"/>'
            f"{body}</g>"
        )
    if margins is not None:
        for edge in ("top", "right", "bottom", "left"):
            sheet.hint(f"{prefix}hint-{edge}-margin", margins, margins)


def listitem() -> str:
    sheet = Sheet()
    frame(sheet, "normal-", ITEM_RADIUS, "ColorScheme-Text", 0.0, margins=ITEM_PADDING)
    frame(sheet, "hover-", ITEM_RADIUS, "ColorScheme-Text", STATE["hover"])
    frame(sheet, "pressed-", ITEM_RADIUS, "ColorScheme-Highlight", 0.22, margins=ITEM_PADDING)
    frame(sheet, "section-", ITEM_RADIUS, "ColorScheme-Text", 0.0, margins=ITEM_PADDING)
    x, y = sheet.place(24, 1)
    sheet.add(f'<rect id="separator" x="{fmt(x)}" y="{fmt(y)}" width="24" height="1" '
              f'{paint("ColorScheme-Text", 0.12)}/>')
    return sheet.render()


def viewitem() -> str:
    sheet = Sheet()
    frame(sheet, "normal-", ITEM_RADIUS, "ColorScheme-Text", 0.0)
    frame(sheet, "hover-", ITEM_RADIUS, "ColorScheme-Text", STATE["hover"])
    frame(sheet, "selected-", ITEM_RADIUS, "ColorScheme-Highlight", 0.22)
    frame(sheet, "selected+hover-", ITEM_RADIUS, "ColorScheme-Highlight", 0.30)
    return sheet.render()


def line() -> str:
    sheet = Sheet()
    x, y = sheet.place(32, 1)
    sheet.add(f'<rect id="horizontal-line" x="{fmt(x)}" y="{fmt(y)}" width="32" height="1" '
              f'{paint("ColorScheme-Text", 0.12)}/>')
    x, y = sheet.place(1, 32)
    sheet.add(f'<rect id="vertical-line" x="{fmt(x)}" y="{fmt(y)}" width="1" height="32" '
              f'{paint("ColorScheme-Text", 0.12)}/>')
    return sheet.render()


def margins_highlight() -> str:
    sheet = Sheet()
    for element, opacity in (("fill", 0.16), ("topleft", 0.08), ("topright", 0.08),
                             ("bottomleft", 0.08), ("bottomright", 0.08)):
        x, y = sheet.place(16, 16)
        sheet.add(f'<rect id="{element}" x="{fmt(x)}" y="{fmt(y)}" width="16" height="16" '
                  f'{paint("ColorScheme-Highlight", opacity)}/>')
    return sheet.render()


def scrollbar() -> str:
    sheet = Sheet()
    for orientation in ("vertical", "horizontal"):
        frame(sheet, f"background-{orientation}-", 4, "ColorScheme-Text", 0.0)
    frame(sheet, "slider-", 4, "ColorScheme-Text", 0.32)
    frame(sheet, "mouseover-slider-", 4, "ColorScheme-Text", 0.52)
    sheet.hint("hint-scrollbar-size", 10, 10)
    return sheet.render()


def plasmoidheading() -> str:
    sheet = Sheet()
    frame(sheet, "header-", DIALOG_RADIUS, "ColorScheme-Background", 0.0)
    frame(sheet, "footer-", DIALOG_RADIUS, "ColorScheme-Background", 0.0)
    for side in ("top", "right", "bottom", "left"):
        sheet.hint(f"hint-{side}-margin", 8, 8)
    sheet.hint("hint-stretch-borders", 1, 1)
    return sheet.render()


def slider() -> str:
    sheet = Sheet()
    track = 16
    frame(sheet, "groove-", track / 2, "ColorScheme-Highlight", 0.22,
          margins=track / 2)
    frame(sheet, "groove-highlight-", track / 2, "ColorScheme-Highlight", 1.0,
          margins=track / 2)

    handle_w, handle_h = 4, 32
    for orientation, (w, h) in (("horizontal", (handle_w, handle_h)),
                                ("vertical", (handle_h, handle_w))):
        x, y = sheet.place(w, h)
        sheet.add(f'<rect id="{orientation}-slider-handle" x="{fmt(x)}" y="{fmt(y)}" '
                  f'width="{w}" height="{h}" rx="2" {paint("ColorScheme-Highlight", 1.0)}/>')
        ring_w, ring_h = (w + 6, h + 6)
        x, y = sheet.place(ring_w, ring_h)
        for state, opacity in (("focus", 0.30), ("hover", 0.16)):
            sheet.add(f'<rect id="{orientation}-slider-{state}" x="{fmt(x)}" y="{fmt(y)}" '
                      f'width="{ring_w}" height="{ring_h}" rx="5" '
                      f'{paint("ColorScheme-Highlight", opacity)}/>')
            x, y = sheet.place(ring_w, ring_h)
    sheet.hint("hint-handle-size", 16, handle_h)
    return sheet.render()


def tabbar() -> str:
    sheet = Sheet()
    bar = 3.0
    r = 8.0
    names = {
        "topleft": (0, 0, r, r), "top": (r, 0, EDGE, r), "topright": (r + EDGE, 0, r, r),
        "left": (0, r, r, EDGE), "center": (r, r, EDGE, EDGE), "right": (r + EDGE, r, r, EDGE),
        "bottomleft": (0, r + EDGE, r, r), "bottom": (r, r + EDGE, EDGE, r),
        "bottomright": (r + EDGE, r + EDGE, r, r),
    }
    ox, oy = sheet.place(2 * r + EDGE, 2 * r + EDGE)
    for name, (dx, dy, w, h) in names.items():
        x, y = ox + dx, oy + dy
        parts = [f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" fill="none"/>']
        top = y + h - bar
        cap = bar / 2
        if name == "bottom":
            parts.append(f'<rect x="{fmt(x)}" y="{fmt(top)}" width="{fmt(w)}" height="{fmt(bar)}" '
                         f'{paint("ColorScheme-Highlight", 1.0)}/>')
        elif name == "bottomleft":
            parts.append(f'<path d="M{fmt(x + w)},{fmt(top)}H{fmt(x + cap)}A{fmt(cap)},{fmt(cap)} 0 0 0 '
                         f'{fmt(x + cap)},{fmt(y + h)}H{fmt(x + w)}Z" {paint("ColorScheme-Highlight", 1.0)}/>')
        elif name == "bottomright":
            parts.append(f'<path d="M{fmt(x)},{fmt(top)}H{fmt(x + w - cap)}A{fmt(cap)},{fmt(cap)} 0 0 1 '
                         f'{fmt(x + w - cap)},{fmt(y + h)}H{fmt(x)}Z" {paint("ColorScheme-Highlight", 1.0)}/>')
        sheet.add(f'<g id="active-tab-{name}">' + "".join(parts) + "</g>")
    for side in ("top", "right", "bottom", "left"):
        sheet.hint(f"active-tab-hint-{side}-margin", 6, 6)
    for edge in ("north", "south", "east", "west"):
        frame(sheet, f"{edge}-active-tab-", 4, "ColorScheme-Highlight", 0.0, margins=6)
    return sheet.render()


def button() -> str:
    sheet = Sheet()
    frame(sheet, "normal-", BUTTON_RADIUS, "ColorScheme-ButtonBackground", 1.0,
          margins=(6, 12, 6, 12))
    frame(sheet, "hover-", BUTTON_RADIUS, "ColorScheme-Text", STATE["hover"],
          margins=FLUSH)
    frame(sheet, "pressed-", BUTTON_RADIUS, "ColorScheme-Highlight", 0.30,
          margins=(6, 12, 6, 12))
    frame(sheet, "focus-", BUTTON_RADIUS, "ColorScheme-Highlight", 1.0,
          margins=2, ring=2)
    frame(sheet, "toolbutton-hover-", BUTTON_RADIUS, "ColorScheme-Text", STATE["hover"],
          margins=6)
    frame(sheet, "toolbutton-pressed-", BUTTON_RADIUS, "ColorScheme-Text", 0.14,
          margins=6)
    frame(sheet, "toolbutton-focus-", BUTTON_RADIUS, "ColorScheme-Highlight", 1.0,
