def lineedit() -> str:
    sheet = Sheet()
    frame(sheet, "base-", FIELD_RADIUS, "ColorScheme-Text", 0.08, margins=(6, 14, 6, 14))
    frame(sheet, "hover-", FIELD_RADIUS, "ColorScheme-Text", 0.30, ring=1, margins=FLUSH)
    frame(sheet, "focus-", FIELD_RADIUS, "ColorScheme-Highlight", 1.0, ring=2, margins=FLUSH)
    frame(sheet, "focusframe-", FIELD_RADIUS, "ColorScheme-Highlight", 1.0, ring=2,
