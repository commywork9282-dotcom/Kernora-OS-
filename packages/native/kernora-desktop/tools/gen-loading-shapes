#!/usr/bin/env python3
"""usage: gen-loading-shapes OUTPUT_FILE
"""

import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import material_shapes

SEQUENCE = ["softBurst", "cookie9", "gem", "pill", "sunny", "cookie4", "oval"]
SAMPLES = 96


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    definitions = material_shapes.shape_definitions()
    shapes = [material_shapes.polar_radii(definitions[name], SAMPLES) for name in SEQUENCE]
    text = (".pragma library\n\n"
            f"var samples = {SAMPLES};\n"
            f"var names = {json.dumps(SEQUENCE)};\n"
            f"var shapes = {json.dumps(shapes, separators=(',', ':'))};\n")
    pathlib.Path(argv[1]).write_text(text, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
