#!/usr/bin/env python3
"""usage: gen-plymouth-theme LOGO.svg SYMBOLS_DIR OUTPUT_DIR
"""

from __future__ import annotations

import pathlib
import re
import sys

import kernora_design as design
import material_shapes

THEME = "kernora"
SEQUENCE = ["softBurst", "cookie9", "gem", "pill", "sunny", "cookie4", "oval"]
SHAPE_SIZE = 38
SHAPE_CANVAS = 56
LOGO_SIZE = 128
ENTRY_WIDTH = 320
ENTRY_HEIGHT = 56


def rgb(hex_colour: str) -> tuple[float, float, float]:
    value = hex_colour.lstrip("#")
    return tuple(int(value[i:i + 2], 16) / 255 for i in (0, 2, 4))


def svg(width: int, height: int, body: str) -> str:
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
            f'viewBox="0 0 {width} {height}">{body}</svg>\n')


def shape_svg(name: str, colour: str) -> str:
    paths = material_shapes.all_paths(scale=SHAPE_SIZE)
    offset = (SHAPE_CANVAS - SHAPE_SIZE) / 2
    return svg(SHAPE_CANVAS, SHAPE_CANVAS,
               f'<path transform="translate({offset} {offset})" fill="{colour}" d="{paths[name]}"/>')


def logo_svg(source: str, colour: str) -> str:
    text = re.sub(r'fill="#[0-9a-fA-F]{6}"', f'fill="{colour}"', source)
    text = re.sub(r'width="\d+" height="\d+"', f'width="{LOGO_SIZE}" height="{LOGO_SIZE}"', text, count=1)
    return text


def symbol_svg(path: pathlib.Path, size: int, colour: str) -> str:
    text = path.read_text(encoding="utf-8")
    text = re.sub(r'width="[^"]*" height="[^"]*"', f'width="{size}" height="{size}"', text, count=1)
    return text.replace("<path ", f'<path fill="{colour}" ', 1)


SCRIPT = r"""// Kernora boot splash. Generated by tools/gen-plymouth-theme.

Window.SetBackgroundTopColor(%(bg)s);
Window.SetBackgroundBottomColor(%(bg)s);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

// --- the mark ---------------------------------------------------------------

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen.x + screen.w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen.y + screen.h * 0.42 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(0);

// --- the loading indicator ---------------------------------------------------

shape_count = %(count)d;
for (i = 0; i < shape_count; i++)
    shapes[i] = Image("shape-" + i + ".png");

indicator.x = screen.x + screen.w / 2;
indicator.y = screen.y + screen.h * 0.42 + logo.image.GetHeight() / 2 + 72;
indicator.a = Sprite();
indicator.b = Sprite();
indicator.a.SetZ(10);
indicator.b.SetZ(11);

// Frames per shape at Plymouth's 50 Hz, and the share of it spent handing
// over to the next one.
hold = 36;
blend = 14;
tick = 0;

fun ease(t) {
    // Material's emphasized curve, near enough: fast out, slow in.
    return 1 - (1 - t) * (1 - t) * (1 - t);
}

fun place(sprite, image) {
    sprite.SetImage(image);
    sprite.SetX(indicator.x - image.GetWidth() / 2);
    sprite.SetY(indicator.y - image.GetHeight() / 2);
}

fun refresh_callback() {
    tick++;
    // The mark fades in over the first half second.
    if (tick <= 25)
        logo.sprite.SetOpacity(tick / 25);

    current = Math.Int(tick / hold) %% shape_count;
    next = (current + 1) %% shape_count;
    phase = tick %% hold;
    // A steady turn, a little faster during a hand-over.
    angle = tick * 0.07;
    place(indicator.a, shapes[current].Rotate(angle));
    if (phase >= hold - blend) {
        f = ease((phase - (hold - blend)) / blend);
        place(indicator.b, shapes[next].Rotate(angle));
        indicator.a.SetOpacity(1 - f);
        indicator.b.SetOpacity(f);
    } else {
        indicator.a.SetOpacity(1);
        indicator.b.SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- a passphrase or a question ------------------------------------------------

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.x = screen.x + screen.w / 2 - entry.image.GetWidth() / 2;
entry.y = screen.y + screen.h * 0.68;
entry.sprite.SetX(entry.x);
entry.sprite.SetY(entry.y);
entry.sprite.SetOpacity(0);
entry.sprite.SetZ(20);

lock.image = Image("lock.png");
lock.sprite = Sprite(lock.image);
lock.sprite.SetX(entry.x + 16);
lock.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - lock.image.GetHeight() / 2);
lock.sprite.SetOpacity(0);
lock.sprite.SetZ(21);

bullet.image = Image("bullet.png");
prompt.sprite = Sprite();
prompt.sprite.SetZ(21);
answer.sprite = Sprite();
answer.sprite.SetZ(21);
bullets = [];
bullet_count = 0;

fun hide_bullets() {
    for (i = 0; i < bullet_count; i++)
        bullets[i].SetOpacity(0);
}

fun show_prompt(text) {
    prompt.image = Image.Text(text, %(text)s, 1, "Sans 12");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(screen.x + screen.w / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(entry.y - prompt.image.GetHeight() - 16);
    prompt.sprite.SetOpacity(1);
    entry.sprite.SetOpacity(1);
    lock.sprite.SetOpacity(1);
}

fun display_password_callback(text, count) {
    show_prompt(text);
    answer.sprite.SetOpacity(0);
    hide_bullets();
    // As many dots as fit the field.
    fit = Math.Int((entry.image.GetWidth() - 72) / (bullet.image.GetWidth() + 6));
    if (count > fit)
        count = fit;
    for (i = 0; i < count; i++) {
        if (!bullets[i])
            bullets[i] = Sprite(bullet.image);
        bullets[i].SetX(entry.x + 56 + i * (bullet.image.GetWidth() + 6));
        bullets[i].SetY(entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2);
        bullets[i].SetZ(22);
        bullets[i].SetOpacity(1);
    }
    if (count > bullet_count)
        bullet_count = count;
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(text, value) {
    show_prompt(text);
    hide_bullets();
    answer.image = Image.Text(value, %(text)s, 1, "Sans 12");
    answer.sprite.SetImage(answer.image);
    answer.sprite.SetX(entry.x + 56);
    answer.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - answer.image.GetHeight() / 2);
    answer.sprite.SetOpacity(1);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    answer.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    lock.sprite.SetOpacity(0);
    hide_bullets();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// --- messages -----------------------------------------------------------------

message.sprite = Sprite();
message.sprite.SetZ(30);

fun message_callback(text) {
    message.image = Image.Text(text, %(soft)s, 1, "Sans 10");
    message.sprite.SetImage(message.image);
    message.sprite.SetX(screen.x + screen.w / 2 - message.image.GetWidth() / 2);
    message.sprite.SetY(screen.y + screen.h - message.image.GetHeight() - 48);
}
Plymouth.SetMessageFunction(message_callback);
"""


def main(argv: list[str]) -> int:
    if len(argv) != 4:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    logo = pathlib.Path(argv[1])
    symbols = pathlib.Path(argv[2])
    output = pathlib.Path(argv[3])
    output.mkdir(parents=True, exist_ok=True)
    dark = design.DARK

    def triple(hex_colour: str) -> str:
        return ", ".join(f"{c:.3f}" for c in rgb(hex_colour))

    (output / f"{THEME}.plymouth").write_text(
        "[Plymouth Theme]\n"
        "Name=Kernora\n"
        "Description=The Lumo mark and Material 3's loading indicator\n"
        "ModuleName=script\n"
        "\n"
        "[script]\n"
        f"ImageDir=/usr/share/plymouth/themes/{THEME}\n"
        f"ScriptFile=/usr/share/plymouth/themes/{THEME}/{THEME}.script\n",
        encoding="utf-8")
    (output / f"{THEME}.script").write_text(SCRIPT % {
        "bg": triple(dark["surface"]),
        "count": len(SEQUENCE),
        "text": triple(dark["onSurface"]),
        "soft": triple(dark["onSurfaceVariant"]),
    }, encoding="utf-8")

    (output / "logo.svg").write_text(logo_svg(logo.read_text(encoding="utf-8"), dark["onSurface"]), encoding="utf-8")
    for index, name in enumerate(SEQUENCE):
        (output / f"shape-{index}.svg").write_text(shape_svg(name, dark["primary"]), encoding="utf-8")
    radius = ENTRY_HEIGHT / 2
    (output / "entry.svg").write_text(svg(ENTRY_WIDTH, ENTRY_HEIGHT,
        f'<rect x="1" y="1" width="{ENTRY_WIDTH - 2}" height="{ENTRY_HEIGHT - 2}" rx="{radius - 1}" '
        f'fill="{dark["surfaceContainerHighest"]}" stroke="{dark["primary"]}" stroke-width="2"/>'), encoding="utf-8")
    (output / "bullet.svg").write_text(svg(12, 12, f'<circle cx="6" cy="6" r="5" fill="{dark["onSurface"]}"/>'),
                                       encoding="utf-8")
    (output / "lock.svg").write_text(symbol_svg(symbols / "lock_24px.svg", 24, dark["onSurfaceVariant"]),
                                     encoding="utf-8")
    print(f"Plymouth theme: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
