def _read_png(data: bytes) -> tuple[int, int, bytes]:
    assert data[:8] == b"\x89PNG\r\n\x1a\n"
    pos, idat, width = 8, b"", 0
    while pos < len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        chunk = data[pos + 8:pos + 8 + length]
        if kind == b"IHDR":
            width, height, depth, colour, _, _, interlace = struct.unpack(">IIBBBBB", chunk)
            if depth != 8 or colour != 6 or interlace:
                raise ValueError("expected 8-bit RGBA, non-interlaced")
        elif kind == b"IDAT":
            idat += chunk
        pos += 12 + length
    raw = zlib.decompress(idat)
    stride = width * 4
    out = bytearray()
    prev = bytearray(stride)
    i = 0
    for _ in range(height):
        f = raw[i]
        line = bytearray(raw[i + 1:i + 1 + stride])
        i += 1 + stride
        for x in range(stride):
            a = line[x - 4] if x >= 4 else 0
            b = prev[x]
            c = prev[x - 4] if x >= 4 else 0
            if f == 1:
                line[x] = (line[x] + a) & 255
            elif f == 2:
                line[x] = (line[x] + b) & 255
            elif f == 3:
                line[x] = (line[x] + ((a + b) >> 1)) & 255
            elif f == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                line[x] = (line[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        out += line
        prev = line
    return width, height, bytes(out)


def _argb(rgba: bytes) -> bytes:
    out = bytearray(len(rgba))
    for i in range(0, len(rgba), 4):
        r, g, b, a = rgba[i:i + 4]
        out[i] = b * a // 255
        out[i + 1] = g * a // 255
        out[i + 2] = r * a // 255
        out[i + 3] = a
    return bytes(out)


def write_xcursor(target: pathlib.Path, images: list[tuple[int, int, int, int, int, int, bytes]]) -> None:
    header = 16
    toc = 12 * len(images)
    chunks = []
    position = header + toc
    entries = []
    for nominal, w, h, xhot, yhot, delay, rgba in images:
        chunk = struct.pack("<IIIIIIIII", 36, 0xFFFD0002, nominal, 1, w, h, xhot, yhot, delay) + _argb(rgba)
        entries.append(struct.pack("<III", 0xFFFD0002, nominal, position))
        chunks.append(chunk)
        position += len(chunk)
    with open(target, "wb") as f:
        f.write(struct.pack("<4sIII", b"Xcur", header, 0x10000, len(images)))
        f.write(b"".join(entries))
        f.write(b"".join(chunks))


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    out = pathlib.Path(argv[1])
    if out.exists():
        shutil.rmtree(out)
    (out / "cursors").mkdir(parents=True)
    (out / "cursors_scalable").mkdir()
    rsvg = shutil.which("rsvg-convert")
    if not rsvg:
        print("gen-cursor-theme: rsvg-convert is required", file=sys.stderr)
        return 1

    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = pathlib.Path(tmp)
        for name, (frames, (hx, hy)) in designs().items():
            scalable = out / "cursors_scalable" / name
            scalable.mkdir()
            metadata = []
            images = []
            animated = len(frames) > 1
            for index, document in enumerate(frames):
                filename = f"{name}-{index + 1:02d}.svg" if animated else f"{name}.svg"
                (scalable / filename).write_text(document, encoding="utf-8")
                entry = {"filename": filename, "hotspot_x": hx, "hotspot_y": hy, "nominal_size": NOMINAL}
                if animated:
                    entry = {"filename": filename, "delay": FRAME_DELAY, "hotspot_x": hx, "hotspot_y": hy, "nominal_size": NOMINAL}
                metadata.append(entry)
            (scalable / "metadata.json").write_text(json.dumps(metadata, indent=4) + "\n", encoding="utf-8")
            for nominal in SIZES:
                px = round(nominal * CANVAS / NOMINAL)
                scale = px / CANVAS
                for index in range(len(frames)):
                    source = scalable / metadata[index]["filename"]
                    png = tmpdir / f"{name}-{nominal}-{index}.png"
                    subprocess.run([rsvg, "-w", str(px), "-h", str(px), "-o", str(png), str(source)], check=True)
                    w, h, rgba = _read_png(png.read_bytes())
                    images.append((nominal, w, h, min(w - 1, round(hx * scale)), min(h - 1, round(hy * scale)),
                                   FRAME_DELAY if animated else 0, rgba))
            write_xcursor(out / "cursors" / name, images)
    for link, target in ALIASES.items():
        os.symlink(target, out / "cursors" / link)
        os.symlink(target, out / "cursors_scalable" / link)

    (out / "index.theme").write_text(
        "[Icon Theme]\n"
        "Name=Kernora\n"
        "Comment=Kernora's cursors: Material shapes, with Material 3 Expressive's loading indicator\n"
        "Comment[ru]=Курсоры Kernora: формы Material и индикатор загрузки Material 3 Expressive\n"
        "Inherits=breeze_cursors\n",
        encoding="utf-8",
    )
    (out / "cursor.theme").write_text("[Icon Theme]\nInherits=kernora_cursors\n", encoding="utf-8")
    print(f"cursor theme: {len(designs())} cursors, {len(ALIASES)} names linked, in {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
