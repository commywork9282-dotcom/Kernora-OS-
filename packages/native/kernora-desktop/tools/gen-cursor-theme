LOADER_SHAPES = ["softBurst", "cookie9", "pill", "sunny", "cookie4"]
FRAMES_PER_SHAPE = 8
FRAME_DELAY = 36
RAYS = 120


def _radii(name: str) -> list[float]:
    cubics = material_shapes.normalized(material_shapes.shape_definitions()[name])
    points = []
    for c in cubics:
        for i in range(24):
            p = material_shapes._point_on(c, i / 24)
            points.append((p.x - 0.5, p.y - 0.5))
    radii = []
    for k in range(RAYS):
        a = 2 * math.pi * k / RAYS
        dx, dy = math.cos(a), math.sin(a)
        best = 0.0
        for i in range(len(points)):
            (x1, y1), (x2, y2) = points[i], points[(i + 1) % len(points)]
            ex, ey = x2 - x1, y2 - y1
            den = dx * ey - dy * ex
            if abs(den) < 1e-12:
                continue
            t = (x1 * ey - y1 * ex) / den
            u = (x1 * dy - y1 * dx) / den
            if t > 0 and -1e-9 <= u <= 1 + 1e-9:
                best = max(best, t)
        radii.append(best)
    return radii


def _ease(u: float) -> float:
    return u * u * u * (u * (u * 6 - 15) + 10)


def loader_frames(cx: float, cy: float, container: float, size: float) -> list[str]:
    shapes = [_radii(n) for n in LOADER_SHAPES]
    total = len(shapes) * FRAMES_PER_SHAPE
    frames = []
    for f in range(total):
        k, step = divmod(f, FRAMES_PER_SHAPE)
        u = _ease(step / FRAMES_PER_SHAPE)
        a, b = shapes[k], shapes[(k + 1) % len(shapes)]
        radii = [ra + (rb - ra) * u for ra, rb in zip(a, b)]
        turn = 360 * f / total * 2 + 90 * (k + u)
        pts = []
        for i, r in enumerate(radii):
            ang = 2 * math.pi * i / RAYS + math.radians(turn)
            pts.append(f"{cx + math.cos(ang) * r * size:.2f},{cy + math.sin(ang) * r * size:.2f}")
        shape = f'<polygon points="{" ".join(pts)}" fill="{LOADER}"/>'
        frames.append(
            f'<g opacity="0.32" filter="url(#shadow)" transform="translate(0 0.8)"><circle cx="{cx}" cy="{cy}" r="{container + 1.2}" fill="#000"/></g>'
            f'<circle cx="{cx}" cy="{cy}" r="{container + 1.2}" fill="{PAPER}"/>'
            f'<circle cx="{cx}" cy="{cy}" r="{container}" fill="{CONTAINER}"/>{shape}')
    return frames


