DEFS = """<defs>
<filter id="shadow" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
<feGaussianBlur stdDeviation="0.75"/>
</filter>
</defs>"""


def svg(body: str) -> str:
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{CANVAS}" height="{CANVAS}" '
            f'viewBox="0 0 {CANVAS} {CANVAS}">{DEFS}{body}</svg>\n')


def glyph(parts: list[str], transform: str = "", outline: float = 2.4) -> str:
    t = f' transform="{transform}"' if transform else ""
    shadow = "".join(p.replace("/>", f' fill="#000" stroke="#000" stroke-width="{outline}" stroke-linejoin="round"/>') for p in parts)
    white = "".join(p.replace("/>", f' fill="{PAPER}" stroke="{PAPER}" stroke-width="{outline}" stroke-linejoin="round" stroke-linecap="round"/>') for p in parts)
    ink = "".join(p.replace("/>", f' fill="{INK}" stroke="{INK}" stroke-width="0.5" stroke-linejoin="round"/>') for p in parts)
    return (f'<g{t}><g opacity="0.32" filter="url(#shadow)" transform="translate(0 0.8)">{shadow}</g>'
            f'{white}{ink}</g>')


def strokes(lines: list[str], width: float = 2.0, transform: str = "", outline: float = 2.2) -> str:
    t = f' transform="{transform}"' if transform else ""
    shadow = "".join(f'<path d="{d}" fill="none" stroke="#000" stroke-width="{width + outline}" stroke-linecap="round" stroke-linejoin="round"/>' for d in lines)
    white = "".join(f'<path d="{d}" fill="none" stroke="{PAPER}" stroke-width="{width + outline}" stroke-linecap="round" stroke-linejoin="round"/>' for d in lines)
    ink = "".join(f'<path d="{d}" fill="none" stroke="{INK}" stroke-width="{width}" stroke-linecap="round" stroke-linejoin="round"/>' for d in lines)
    return (f'<g{t}><g opacity="0.32" filter="url(#shadow)" transform="translate(0 0.8)">{shadow}</g>'
            f'{white}{ink}</g>')


def path(d: str) -> str:
    return f'<path d="{d}"/>'


def rect(x: float, y: float, w: float, h: float, r: float, rotate: float = 0, cx: float = 0, cy: float = 0) -> str:
    rot = f' transform="rotate({rotate} {cx} {cy})"' if rotate else ""
    return f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{r}"{rot}/>'


def circle(cx: float, cy: float, r: float) -> str:
    return f'<circle cx="{cx}" cy="{cy}" r="{r}"/>'


