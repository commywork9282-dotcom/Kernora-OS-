#!/usr/bin/env python3
"""usage: gen-aurorae-theme OUTPUT_DIRECTORY
"""

from __future__ import annotations

import pathlib
import re
import sys

import kernora_design as design
import m3color

TOOLS = pathlib.Path(__file__).resolve().parent
SYMBOLS = TOOLS.parent / "data" / "symbols"

THEME = "kernora" + ("" if design.GENERATION == "md3" else f"-{design.GENERATION}")

TITLE = 30
TITLE_EDGE = 4
RADIUS = design.corner("window")
PAD_SIDE = 28
PAD_TOP = 18
PAD_BOTTOM = 38
BUTTON = 30
GLYPH = 18
BUTTON_SPACING = 4
EDGE = 8
ANIMATION = 150

SHADOW_ACTIVE = 0.50
SHADOW_INACTIVE = 0.28
STOPS = [(0.0, 1.0), (0.14, 0.72), (0.32, 0.40), (0.52, 0.17), (0.74, 0.05), (1.0, 0.0)]

BAR = TITLE + 2 * TITLE_EDGE
LEFT = PAD_SIDE + RADIUS
TOP = PAD_TOP + BAR


def fmt(value: float) -> str:
    text = f"{value:.3f}".rstrip("0").rstrip(".")
    return text if text not in ("-0", "") else "0"


def kde(colour: str) -> str:
    r, g, b = m3color.rgb_from_hex(colour)
    return f"{r},{g},{b}"


class Doc:
    def __init__(self) -> None:
        self.defs: list[str] = []
        self.parts: list[str] = []
        self.count = 0
        self.width = 0.0
        self.height = 0.0

    def gradient(self, markup: str) -> str:
        self.count += 1
        gid = f"s{self.count}"
        self.defs.append(markup.replace("@ID@", gid))
        return gid

    def element(self, name: str, x: float, y: float, w: float, h: float, body: str) -> None:
        self.parts.append(
            f'<g id="{name}"><rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" '
            f'fill="#000" opacity="0"/>{body}</g>'
        )
        self.width = max(self.width, x + w)
        self.height = max(self.height, y + h)

    def render(self) -> str:
        return (
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{fmt(self.width)}" height="{fmt(self.height)}" '
            f'viewBox="0 0 {fmt(self.width)} {fmt(self.height)}">\n'
            f"<!-- Generated by tools/gen-aurorae-theme from the Kernora palette ({design.SEED}). -->\n"
            "<defs>\n" + "\n".join(self.defs) + "\n</defs>\n"
            + "\n".join(self.parts) + "\n</svg>\n"
        )


def stops(alpha: float, start: float = 0.0) -> str:
    out = [f'<stop offset="0" stop-color="#000" stop-opacity="{alpha:.3f}"/>']
    for offset, level in STOPS:
        position = start + (1 - start) * offset
        out.append(f'<stop offset="{position:.4f}" stop-color="#000" stop-opacity="{alpha * level:.4f}"/>')
    return "".join(out)


def linear(doc: Doc, x1, y1, x2, y2, alpha: float) -> str:
    return doc.gradient(
        f'<linearGradient id="@ID@" gradientUnits="userSpaceOnUse" x1="{fmt(x1)}" y1="{fmt(y1)}" '
        f'x2="{fmt(x2)}" y2="{fmt(y2)}">{stops(alpha)}</linearGradient>'
    )


def radial(doc: Doc, cx, cy, rx, ry, inner: float, alpha: float) -> str:
    return doc.gradient(
        f'<radialGradient id="@ID@" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="1" fx="0" fy="0" '
        f'gradientTransform="translate({fmt(cx)} {fmt(cy)}) scale({fmt(rx)} {fmt(ry)})">'
        f"{stops(alpha, inner)}</radialGradient>"
    )


def rect(x, y, w, h, fill: str) -> str:
    if w <= 0 or h <= 0:
        return ""
    return f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" fill="{fill}"/>'


KAPPA = 0.5522847498


def frame(doc: Doc, prefix: str, ox: float, oy: float, bar: str, body: str, shadow: float) -> None:
    span = 16
    k = KAPPA * RADIUS

    def corner_top(x: float, y: float, flip: bool) -> str:
        def px(v: float) -> float:
            return x + (LEFT - v if flip else v)

        cx, cy = LEFT, PAD_TOP + RADIUS
        g = radial(doc, px(cx), y + cy, LEFT, cy, RADIUS / LEFT, shadow)
        side = linear(doc, px(PAD_SIDE), 0, px(0), 0, shadow)
        quarter_x = x if not flip else x
        markup = rect(quarter_x, y, LEFT, cy, f"url(#{g})")
        markup += rect(px(PAD_SIDE) if flip else x, y + cy, PAD_SIDE, TOP - cy, f"url(#{side})")
        path = (
            f"M {fmt(px(PAD_SIDE))} {fmt(y + TOP)} L {fmt(px(PAD_SIDE))} {fmt(y + PAD_TOP + RADIUS)} "
            f"C {fmt(px(PAD_SIDE))} {fmt(y + PAD_TOP + RADIUS - k)} {fmt(px(LEFT - k))} {fmt(y + PAD_TOP)} "
            f"{fmt(px(LEFT))} {fmt(y + PAD_TOP)} L {fmt(px(LEFT))} {fmt(y + TOP)} Z"
        )
        markup += f'<path d="{path}" fill="{bar}"/>'
        return markup

    x, y = ox, oy
    doc.element(f"{prefix}-topleft", x, y, LEFT, TOP, corner_top(x, y, False))
    x += LEFT
    top_shadow = linear(doc, 0, y + PAD_TOP, 0, y, shadow)
    doc.element(f"{prefix}-top", x, y, span, TOP,
                rect(x, y, span, PAD_TOP, f"url(#{top_shadow})") + rect(x, y + PAD_TOP, span, BAR, bar))
    x += span
    doc.element(f"{prefix}-topright", x, y, LEFT, TOP, corner_top(x, y, True))

    x, y = ox, oy + TOP
    left_shadow = linear(doc, x + PAD_SIDE, 0, x, 0, shadow)
    doc.element(f"{prefix}-left", x, y, LEFT, span,
                rect(x, y, PAD_SIDE, span, f"url(#{left_shadow})") + rect(x + PAD_SIDE, y, RADIUS, span, body))
    doc.element(f"{prefix}-center", x + LEFT, y, span, span, rect(x + LEFT, y, span, span, body))
    right_shadow = linear(doc, x + LEFT + span + RADIUS, 0, x + LEFT + span + LEFT, 0, shadow)
    doc.element(f"{prefix}-right", x + LEFT + span, y, LEFT, span,
                rect(x + LEFT + span, y, RADIUS, span, body)
                + rect(x + LEFT + span + RADIUS, y, PAD_SIDE, span, f"url(#{right_shadow})"))

    y += span
    below = linear(doc, 0, y, 0, y + PAD_BOTTOM, shadow)

    def corner_bottom(x0: float, flip: bool) -> str:
        edge_x = x0 + (RADIUS if flip else PAD_SIDE)
        g = radial(doc, edge_x, y, PAD_SIDE, PAD_BOTTOM, 0, shadow)
        if flip:
            return rect(x0, y, RADIUS, PAD_BOTTOM, f"url(#{below})") + rect(edge_x, y, PAD_SIDE, PAD_BOTTOM, f"url(#{g})")
        return rect(x0, y, PAD_SIDE, PAD_BOTTOM, f"url(#{g})") + rect(edge_x, y, RADIUS, PAD_BOTTOM, f"url(#{below})")

    doc.element(f"{prefix}-bottomleft", ox, y, LEFT, PAD_BOTTOM, corner_bottom(ox, False))
    doc.element(f"{prefix}-bottom", ox + LEFT, y, span, PAD_BOTTOM, rect(ox + LEFT, y, span, PAD_BOTTOM, f"url(#{below})"))
    doc.element(f"{prefix}-bottomright", ox + LEFT + span, y, LEFT, PAD_BOTTOM, corner_bottom(ox + LEFT + span, True))


def decoration(roles: dict[str, str]) -> str:
    doc = Doc()
    body = roles["surface"]
    height = TOP + 16 + PAD_BOTTOM + 20
    frame(doc, "decoration", 0, 0, roles["surfaceContainer"], body, SHADOW_ACTIVE)
    frame(doc, "decoration-inactive", 0, height, roles["surfaceContainerLow"], body, SHADOW_INACTIVE)
    for hint in ("hint-stretch-borders", "decoration-hint-stretch-borders",
                 "decoration-inactive-hint-stretch-borders"):
        doc.element(hint, 0, 3 * height, 4, 4, "")
    y = 2 * height
    for prefix, colour in (("decoration-maximized", roles["surfaceContainer"]),
                           ("decoration-maximized-inactive", roles["surfaceContainerLow"])):
        doc.element(f"{prefix}-center", 0, y, 16, BAR, rect(0, y, 16, BAR, colour))
        y += BAR + 20
    return doc.render()


def symbol_path(name: str) -> str:
    text = (SYMBOLS / f"{name}_24px.svg").read_text(encoding="utf-8")
    return re.search(r'<path d="([^"]+)"', text).group(1)


def glyph(name: str, x: float, y: float, colour: str, opacity: float = 1.0) -> str:
    scale = GLYPH / 960
    offset = (BUTTON - GLYPH) / 2
    alpha = f' fill-opacity="{opacity:.3f}"' if opacity < 1 else ""
    return (f'<path transform="translate({fmt(x + offset)} {fmt(y + offset)}) scale({scale:.6f}) translate(0 960)" '
            f'd="{symbol_path(name)}" fill="{colour}"{alpha}/>')


def circle(x: float, y: float, colour: str, opacity: float = 1.0) -> str:
    alpha = f' fill-opacity="{opacity:.3f}"' if opacity < 1 else ""
    return f'<circle cx="{fmt(x + BUTTON / 2)}" cy="{fmt(y + BUTTON / 2)}" r="{fmt(BUTTON / 2)}" fill="{colour}"{alpha}/>'


def button(roles: dict[str, str], symbol: str, close: bool) -> str:
    doc = Doc()
    ink = roles["onSurfaceVariant"]
    strong = roles["onSurface"]
    states: list[tuple[str, str]] = []
    if close:
        hover = circle(0, 0, roles["errorContainer"]) + glyph(symbol, 0, 0, roles["onErrorContainer"])
        pressed = (circle(0, 0, roles["errorContainer"]) + circle(0, 0, roles["onErrorContainer"], 0.14)
                   + glyph(symbol, 0, 0, roles["onErrorContainer"]))
    else:
        hover = circle(0, 0, strong, 0.10) + glyph(symbol, 0, 0, strong)
        pressed = circle(0, 0, strong, 0.18) + glyph(symbol, 0, 0, strong)
    states = [
        ("active", glyph(symbol, 0, 0, ink)),
        ("hover", hover),
        ("pressed", pressed),
        ("inactive", glyph(symbol, 0, 0, roles["outline"])),
        ("hover-inactive", hover),
        ("pressed-inactive", pressed),
        ("deactivated", glyph(symbol, 0, 0, strong, 0.38)),
        ("deactivated-inactive", glyph(symbol, 0, 0, strong, 0.38)),
    ]
    for index, (state, markup) in enumerate(states):
        x = index * (BUTTON + 4)
        doc.element(f"{state}-center", x, 0, BUTTON, BUTTON, f'<g transform="translate({fmt(x)} 0)">{markup}</g>')
    return doc.render()


BUTTONS = {
    "close": ("close", True),
    "maximize": ("crop_square", False),
    "restore": ("filter_none", False),
    "minimize": ("remove", False),
    "alldesktops": ("keep", False),
    "keepabove": ("arrow_upward", False),
    "keepbelow": ("arrow_downward", False),
    "shade": ("expand_less", False),
    "help": ("help", False),
}


def rc(roles: dict[str, str]) -> str:
    lines = [
        "# Kernora window decoration. Generated by tools/gen-aurorae-theme; do not edit.",
        "[General]",
        f"ActiveTextColor={kde(roles['onSurface'])}",
        f"InactiveTextColor={kde(roles['onSurfaceVariant'])}",
        "TitleAlignment=Center",
        "TitleVerticalAlignment=Center",
        f"Animation={ANIMATION}",
        "Shadow=true",
        "",
        "[Layout]",
        "BorderLeft=0",
        "BorderRight=0",
        "BorderBottom=0",
        f"TitleEdgeTop={TITLE_EDGE}",
        f"TitleEdgeBottom={TITLE_EDGE}",
        f"TitleEdgeLeft={EDGE}",
        f"TitleEdgeRight={EDGE}",
        f"TitleEdgeTopMaximized={TITLE_EDGE}",
        f"TitleEdgeBottomMaximized={TITLE_EDGE}",
        f"TitleEdgeLeftMaximized={EDGE}",
        f"TitleEdgeRightMaximized={EDGE}",
        "TitleBorderLeft=8",
        "TitleBorderRight=8",
        f"TitleHeight={TITLE}",
        f"ButtonWidth={BUTTON}",
        f"ButtonHeight={BUTTON}",
        f"ButtonSpacing={BUTTON_SPACING}",
        "ButtonMarginTop=0",
        "ButtonMarginTopMaximized=0",
        "ExplicitButtonSpacer=8",
        f"PaddingLeft={PAD_SIDE}",
        f"PaddingRight={PAD_SIDE}",
        f"PaddingTop={PAD_TOP}",
        f"PaddingBottom={PAD_BOTTOM}",
        "",
    ]
    return "\n".join(lines)


METADATA = """[Desktop Entry]
Name={name}
Name[ru]={name_ru}
Comment=Material 3 window decoration of Kernora OS
Comment[ru]=Оформление окон Kernora OS в стиле Material 3
X-KDE-PluginInfo-Name={plugin}
X-KDE-PluginInfo-Author=Kernora Developers
X-KDE-PluginInfo-License=GPL-2.0-or-later
"""

_LABEL = design.GENERATION_LABEL[design.GENERATION]
VARIANTS = (
    (THEME, design.DARK, f"Kernora{_LABEL}", f"Kernora{_LABEL}"),
    (THEME + "-light", design.LIGHT, f"Kernora{_LABEL} Light", f"Kernora{_LABEL}, светлое"),
)


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    for plugin, roles, name, name_ru in VARIANTS:
        output = pathlib.Path(argv[1]) / plugin
        output.mkdir(parents=True, exist_ok=True)
        (output / "metadata.desktop").write_text(
            METADATA.format(name=name, name_ru=name_ru, plugin=plugin), encoding="utf-8")
        (output / f"{plugin}rc").write_text(rc(roles), encoding="utf-8")
        (output / "decoration.svg").write_text(decoration(roles), encoding="utf-8")
        for button_name, (symbol, close) in BUTTONS.items():
            (output / f"{button_name}.svg").write_text(button(roles, symbol, close), encoding="utf-8")
        print(f"aurorae theme: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
