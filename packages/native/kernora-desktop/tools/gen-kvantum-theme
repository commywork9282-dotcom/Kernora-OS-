class Palette:
    def __init__(self, dark: bool) -> None:
        self.dark = dark
        self.roles = design.DARK if dark else design.LIGHT

    def __getitem__(self, role: str) -> str:
        return self.roles[role]

    def over(self, base: str, layer: str, amount: float) -> str:
        a = m3color.rgb_from_hex(self.roles[base])
        b = m3color.rgb_from_hex(self.roles[layer])
        return m3color.hex_from_rgb(tuple(round(a[i] + (b[i] - a[i]) * amount) for i in range(3)))

    def alpha(self, role: str, amount: float) -> str:
        return self.roles[role] + f"{round(amount * 255):02x}"


class Fill:

    def __init__(self, colour: str, opacity: float = 1.0) -> None:
        self.colour = colour
        self.opacity = opacity

    def attrs(self) -> str:
        if self.opacity >= 1:
            return f'fill="{self.colour}"'
        return f'fill="{self.colour}" fill-opacity="{self.opacity:.3f}"'


def fmt(value: float) -> str:
    text = f"{value:.3f}".rstrip("0").rstrip(".")
    return text if text not in ("-0", "") else "0"


class Sheet:

    WIDTH = 1600
    GAP = 6

    def __init__(self) -> None:
        self.parts: list[str] = []
        self.defs: list[str] = []
        self.ids: set[str] = set()
        self.x = 0.0
        self.y = 0.0
        self.row = 0.0
        self.gradients = 0

    def place(self, w: float, h: float) -> tuple[float, float]:
        if self.x + w > self.WIDTH:
            self.x = 0.0
            self.y += self.row + self.GAP
            self.row = 0.0
        x, y = self.x, self.y
        self.x += w + self.GAP
        self.row = max(self.row, h)
        return x, y

    def newline(self) -> None:
        if self.x:
            self.x = 0.0
            self.y += self.row + self.GAP * 3
            self.row = 0.0

    def add(self, name: str, w: float, h: float, body) -> None:
        if name in self.ids:
            raise ValueError(f"duplicate SVG object {name}")
        self.ids.add(name)
        x, y = self.place(w, h)
        self.parts.append(
            f'<g id="{name}"><rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" '
            f'fill="#000" opacity="0"/>{body(x, y)}</g>'
        )

    def blank(self, name: str, w: float = 4, h: float = 4) -> None:
        self.add(name, w, h, lambda x, y: "")

    def gradient(self, markup: str) -> str:
        self.gradients += 1
        gid = f"g{self.gradients}"
        self.defs.append(markup.replace("@ID@", gid))
        return gid

    def render(self) -> str:
        height = self.y + self.row + self.GAP
        return (
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{self.WIDTH}" height="{fmt(height)}" '
            f'viewBox="0 0 {self.WIDTH} {fmt(height)}">\n'
            f"<!-- Generated by tools/gen-kvantum-theme from the Kernora palette ({design.SEED}). -->\n"
            "<defs>\n" + "\n".join(self.defs) + "\n</defs>\n"
            + "\n".join(self.parts)
            + "\n</svg>\n"
        )


KAPPA = 0.5522847498


def corner_outline(ox: float, oy: float, r: float, far_x: float, far_y: float) -> list[tuple]:
    k = KAPPA * r
    return [
        ("M", ox, far_y),
        ("L", ox, oy + r),
        ("C", ox, oy + r - k, ox + r - k, oy, ox + r, oy),
        ("L", far_x, oy),
        ("L", far_x, far_y),
        ("Z",),
    ]


def transform_commands(commands: list[tuple], fn) -> list[tuple]:
    out = []
    for c in commands:
        op, values = c[0], c[1:]
        mapped = []
        for i in range(0, len(values), 2):
            mapped.extend(fn(values[i], values[i + 1]))
        out.append((op, *mapped))
    return out


def path_data(commands: list[tuple]) -> str:
    return " ".join(c[0] + " " + " ".join(fmt(v) for v in c[1:]) if len(c) > 1 else c[0] for c in commands)


class Slices:

    def __init__(self, left, top, right, bottom, radius, fill=None, ring=None, inset_x=0.0, inset_y=0.0):
        self.left, self.top, self.right, self.bottom = left, top, right, bottom
        self.radius = radius
        self.fill = fill
        self.ring = ring
        self.inset_x = inset_x
        self.inset_y = inset_y

    def _corner(self, w: float, h: float, flip_x: bool, flip_y: bool):
        ix, iy, r = self.inset_x, self.inset_y, self.radius

        def body(x, y):
            def place(px, py):
                if flip_x:
                    px = w - px
                if flip_y:
                    py = h - py
                return (x + px, y + py)

            markup = ""
            outer = transform_commands(corner_outline(ix, iy, r, w, h), place)
            if self.ring:
                ring_fill, width = self.ring
                inner = transform_commands(
                    corner_outline(ix + width, iy + width, max(r - width, 0), w, h), place)
                if self.fill:
                    markup += f'<path d="{path_data(inner)}" {self.fill.attrs()}/>'
                markup += (f'<path d="{path_data(outer)} {path_data(inner)}" '
                           f'fill-rule="evenodd" {ring_fill.attrs()}/>')
            elif self.fill:
                markup += f'<path d="{path_data(outer)}" {self.fill.attrs()}/>'
            return markup

        return body

    def _edge(self, w: float, h: float, side: str):
        def body(x, y):
            if side == "top":
                rect, band = (0, self.inset_y, w, h - self.inset_y), (0, self.inset_y, w, None)
            elif side == "bottom":
                rect, band = (0, 0, w, h - self.inset_y), (0, h - self.inset_y, w, None)
            elif side == "left":
                rect, band = (self.inset_x, 0, w - self.inset_x, h), (self.inset_x, 0, None, h)
            else:
                rect, band = (0, 0, w - self.inset_x, h), (w - self.inset_x, 0, None, h)
            markup = ""
            rx, ry, rw, rh = rect
            if self.ring:
                ring_fill, width = self.ring
                bx, by, bw, bh = band
                if side in ("top", "bottom"):
                    ring_rect = (bx, by if side == "top" else by - width, bw, width)
                    fill_rect = (rx, ry + (width if side == "top" else 0), rw, rh - width)
                else:
                    ring_rect = (bx if side == "left" else bx - width, by, width, bh)
                    fill_rect = (rx + (width if side == "left" else 0), ry, rw - width, rh)
                if self.fill:
                    markup += rect_markup(x, y, *fill_rect, self.fill)
                markup += rect_markup(x, y, *ring_rect, ring_fill)
            elif self.fill:
                markup += rect_markup(x, y, rx, ry, rw, rh, self.fill)
            return markup

        return body

    def emit(self, sheet: Sheet, name: str, interior: bool = True, span: float = 12) -> None:
        l, t, r, b = self.left, self.top, self.right, self.bottom
        sheet.add(f"{name}-topleft", l, t, self._corner(l, t, False, False))
        sheet.add(f"{name}-top", span, t, self._edge(span, t, "top"))
        sheet.add(f"{name}-topright", r, t, self._corner(r, t, True, False))
        sheet.add(f"{name}-left", l, span, self._edge(l, span, "left"))
        if interior:
            fill = self.fill
            sheet.add(name, span, span, lambda x, y: rect_markup(x, y, 0, 0, span, span, fill) if fill else "")
        sheet.add(f"{name}-right", r, span, self._edge(r, span, "right"))
        sheet.add(f"{name}-bottomleft", l, b, self._corner(l, b, False, True))
        sheet.add(f"{name}-bottom", span, b, self._edge(span, b, "bottom"))
        sheet.add(f"{name}-bottomright", r, b, self._corner(r, b, True, True))
        sheet.newline()


def rect_markup(x, y, rx, ry, rw, rh, fill: Fill | None, radius: float = 0) -> str:
    if fill is None or rw <= 0 or rh <= 0:
        return ""
    corner = f' rx="{fmt(radius)}"' if radius else ""
    return (f'<rect x="{fmt(x + rx)}" y="{fmt(y + ry)}" width="{fmt(rw)}" height="{fmt(rh)}"'
            f"{corner} {fill.attrs()}/>")


def symbol_path(name: str) -> str:
    text = (SYMBOLS / f"{name}_24px.svg").read_text(encoding="utf-8")
    return re.search(r'<path d="([^"]+)"', text).group(1)


def glyph(name: str, x: float, y: float, size: float, fill: Fill, rotate: float = 0) -> str:
    scale = size / 960
    spin = f" rotate({fmt(rotate)} 480 -480)" if rotate else ""
    return (f'<path transform="translate({fmt(x)} {fmt(y)}) scale({scale:.6f}) translate(0 960){spin}" '
            f'd="{symbol_path(name)}" {fill.attrs()}/>')


def circle(cx, cy, r, fill: Fill) -> str:
    return f'<circle cx="{fmt(cx)}" cy="{fmt(cy)}" r="{fmt(r)}" {fill.attrs()}/>'


def ring_circle(cx, cy, r, width, fill: Fill) -> str:
    return (f'<circle cx="{fmt(cx)}" cy="{fmt(cy)}" r="{fmt(r - width / 2)}" fill="none" '
            f'stroke="{fill.colour}" stroke-width="{fmt(width)}"'
            + (f' stroke-opacity="{fill.opacity:.3f}"' if fill.opacity < 1 else "") + "/>")


def rounded_rect(x, y, w, h, r, fill: Fill) -> str:
    return rect_markup(x, y, 0, 0, w, h, fill, r)


def rounded_ring(x, y, w, h, r, width, fill: Fill) -> str:
    half = width / 2
    return (f'<rect x="{fmt(x + half)}" y="{fmt(y + half)}" width="{fmt(w - width)}" height="{fmt(h - width)}" '
            f'rx="{fmt(max(r - half, 0))}" fill="none" stroke="{fill.colour}" stroke-width="{fmt(width)}"'
            + (f' stroke-opacity="{fill.opacity:.3f}"' if fill.opacity < 1 else "") + "/>")


SHADOW_STOPS = [(0.0, 1.0), (0.18, 0.62), (0.38, 0.30), (0.6, 0.11), (0.8, 0.03), (1.0, 0.0)]


def shadowed_surface(sheet: Sheet, name: str, depth: int, frame: int, radius: int,
                     surface: Fill, border: Fill | None, shadow_alpha: float) -> None:
    size = depth + frame

    def stops(start: float) -> str:
        out = [f'<stop offset="0" stop-color="#000" stop-opacity="{shadow_alpha:.3f}"/>']
        for offset, level in SHADOW_STOPS:
            position = start + (1 - start) * offset
            out.append(f'<stop offset="{position:.4f}" stop-color="#000" stop-opacity="{shadow_alpha * level:.4f}"/>')
        return "".join(out)

    edge_start = frame / size

    def corner(flip_x: bool, flip_y: bool):
        def body(x, y):
            cx = x + (0 if flip_x else size)
            cy = y + (0 if flip_y else size)
            gid = sheet.gradient(
                f'<radialGradient id="@ID@" gradientUnits="userSpaceOnUse" cx="{fmt(cx)}" cy="{fmt(cy)}" '
                f'r="{size}" fx="{fmt(cx)}" fy="{fmt(cy)}">'
                + stops(max(edge_start - 0.001, 0)) + "</radialGradient>")
            shadow = f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{size}" height="{size}" fill="url(#{gid})"/>'
            slices = Slices(size, size, size, size, radius, fill=surface,
                            ring=(border, 1) if border else None, inset_x=depth, inset_y=depth)
            return shadow + slices._corner(size, size, flip_x, flip_y)(x, y)
        return body

    def edge(side: str, w: float, h: float):
        def body(x, y):
            if side == "top":
                x1, y1, x2, y2 = x, y + size, x, y
            elif side == "bottom":
                x1, y1, x2, y2 = x, y, x, y + size
            elif side == "left":
                x1, y1, x2, y2 = x + size, y, x, y
            else:
                x1, y1, x2, y2 = x, y, x + size, y
            gid = sheet.gradient(
                f'<linearGradient id="@ID@" gradientUnits="userSpaceOnUse" x1="{fmt(x1)}" y1="{fmt(y1)}" '
                f'x2="{fmt(x2)}" y2="{fmt(y2)}">' + stops(edge_start) + "</linearGradient>")
            shadow = f'<rect x="{fmt(x)}" y="{fmt(y)}" width="{fmt(w)}" height="{fmt(h)}" fill="url(#{gid})"/>'
            slices = Slices(size, size, size, size, radius, fill=surface,
                            ring=(border, 1) if border else None, inset_x=depth, inset_y=depth)
            return shadow + slices._edge(w, h, side)(x, y)
        return body

    span = 12
    sheet.add(f"{name}-shadow-topleft", size, size, corner(False, False))
    sheet.add(f"{name}-shadow-top", span, size, edge("top", span, size))
    sheet.add(f"{name}-shadow-topright", size, size, corner(True, False))
    sheet.add(f"{name}-shadow-left", size, span, edge("left", size, span))
    sheet.add(f"{name}-shadow-right", size, span, edge("right", size, span))
    sheet.add(f"{name}-shadow-bottomleft", size, size, corner(False, True))
    sheet.add(f"{name}-shadow-bottom", span, size, edge("bottom", span, size))
    sheet.add(f"{name}-shadow-bottomright", size, size, corner(True, True))
    marker = Fill("#ff00ff")
    sheet.add(f"{name}-shadow-hint-top", 4, depth, lambda x, y: rect_markup(x, y, 0, 0, 4, depth, marker))
    sheet.add(f"{name}-shadow-hint-bottom", 4, depth, lambda x, y: rect_markup(x, y, 0, 0, 4, depth, marker))
    sheet.add(f"{name}-shadow-hint-left", depth, 4, lambda x, y: rect_markup(x, y, 0, 0, depth, 4, marker))
    sheet.add(f"{name}-shadow-hint-right", depth, 4, lambda x, y: rect_markup(x, y, 0, 0, depth, 4, marker))
    sheet.newline()


def build(dark: bool) -> tuple[str, str]:
    p = Palette(dark)
    s = Sheet()
    F = Fill

    def layer(role: str, amount: float) -> Fill:
        return F(p[role], amount)

    tonal = p["secondaryContainer"]
    b = BUTTON_FRAME
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(tonal)).emit(s, "button-normal")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(p.over("secondaryContainer", "onSecondaryContainer", 0.08))).emit(s, "button-focused")
    Slices(b, b, b, b, BUTTON_PRESSED_SHAPE, fill=F(p.over("secondaryContainer", "onSecondaryContainer", 0.14))).emit(s, "button-pressed")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(p["primary"])).emit(s, "button-toggled")
    Slices(b, b, b, b, BUTTON_SHAPE, ring=(F(p["primary"]), 2)).emit(s, "button-focus", interior=False)
    s.blank("expand-button-normal")

    Slices(b, b, b, b, BUTTON_SHAPE).emit(s, "tbutton-normal")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=layer("onSurface", 0.08)).emit(s, "tbutton-focused")
    Slices(b, b, b, b, BUTTON_PRESSED_SHAPE, fill=layer("onSurface", 0.12)).emit(s, "tbutton-pressed")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(tonal)).emit(s, "tbutton-toggled")
    Slices(b, b, b, b, BUTTON_SHAPE, ring=(F(p["primary"]), 2)).emit(s, "tbutton-focus", interior=False)
    s.blank("expand-tbutton-normal")

    e = FIELD_EXPANSION // 2
    field = p["surfaceContainerHighest"]
    Slices(e, e, e, e, FIELD_SHAPE, fill=F(field)).emit(s, "lineedit-normal")
    Slices(e, e, e, e, FIELD_SHAPE, fill=F(field), ring=(F(p["primary"]), 2)).emit(s, "lineedit-focused")
    s.blank("expand-lineedit-normal")
    Slices(e, e, e, e, FIELD_SHAPE, fill=F(field)).emit(s, "combo-normal")
    Slices(e, e, e, e, FIELD_SHAPE, fill=F(p.over("surfaceContainerHighest", "onSurface", 0.08))).emit(s, "combo-focused")
    Slices(e, e, e, e, FIELD_SHAPE, fill=F(p.over("surfaceContainerHighest", "onSurface", 0.12)),
           ring=(F(p["primary"]), 2)).emit(s, "combo-pressed")
    Slices(e, e, e, e, FIELD_SHAPE, fill=F(field), ring=(F(p["primary"]), 2)).emit(s, "combo-toggled")
    Slices(e, e, e, e, FIELD_SHAPE, ring=(F(p["primary"]), 2)).emit(s, "combo-focus", interior=False)
    s.blank("expand-combo-normal")

    i = ITEM_EXPANSION // 2
    Slices(i, i, i, i, ITEM_SHAPE).emit(s, "itemview-normal")
    Slices(i, i, i, i, ITEM_SHAPE, fill=layer("onSurface", 0.08)).emit(s, "itemview-focused")
    Slices(i, i, i, i, ITEM_SHAPE, fill=F(p["primaryContainer"])).emit(s, "itemview-toggled")
    Slices(i, i, i, i, ITEM_SHAPE, fill=F(p["primaryContainer"])).emit(s, "itemview-pressed")
    s.blank("expand-itemview-normal")

    Slices(b, b, b, b, BUTTON_SHAPE).emit(s, "tab-normal")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=layer("onSurface", 0.08)).emit(s, "tab-focused")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(tonal)).emit(s, "tab-toggled")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(p.over("secondaryContainer", "onSecondaryContainer", 0.12))).emit(s, "tab-pressed")
    Slices(b, b, b, b, BUTTON_SHAPE, ring=(F(p["primary"]), 2)).emit(s, "tab-focus", interior=False)
    s.blank("expand-tab-normal")
    s.blank("tab-separator-normal")
    s.blank("tab-separator-toggled")

    c = CARD_EXPANSION // 2
    Slices(c, c, c, c, CARD_SHAPE, fill=F(p["surfaceContainerLow"])).emit(s, "group-normal")
    s.blank("expand-group-normal")
    Slices(c, c, c, c, CARD_SHAPE, fill=F(p["surfaceContainerLow"])).emit(s, "tabframe-normal")
    s.blank("expand-tabframe-normal")

    r = FRAME_RADIUS
    Slices(r, r, r, r, FRAME_SHAPE, ring=(F(p["outlineVariant"]), 1)).emit(s, "common-normal")
    Slices(r, r, r, r, FRAME_SHAPE, ring=(F(p["primary"]), 1)).emit(s, "common-focused")

    Slices(2, 2, 2, 2, 2, ring=(F(p["primary"]), 2)).emit(s, "focus", interior=False)

    menu_surface = F(p["surfaceContainerHigh"])
    hairline = F(p["outlineVariant"], 0.5)
    shadowed_surface(s, "menu", MENU_SHADOW, MENU_RADIUS, MENU_SHAPE, menu_surface,
                     None if CLASSIC else hairline, 0.5 if CLASSIC else 0.42 if dark else 0.16)
    Slices(MENU_RADIUS, MENU_RADIUS, MENU_RADIUS, MENU_RADIUS, MENU_SHAPE,
           fill=menu_surface, ring=None if CLASSIC else (hairline, 1)).emit(s, "menu-normal")
    side = MENU_ITEM_INSET + MENU_ITEM_RADIUS
    mr = 0 if CLASSIC else MENU_ITEM_RADIUS
    mh = MENU_ITEM_RADIUS
    Slices(side, mh, side, mh, mr, fill=F(tonal), inset_x=MENU_ITEM_INSET).emit(s, "menuitem-toggled")
    Slices(side, mh, side, mh, mr, fill=F(p.over("secondaryContainer", "onSecondaryContainer", 0.12)),
           inset_x=MENU_ITEM_INSET).emit(s, "menuitem-pressed")
    Slices(side, mh, side, mh, mr, fill=F(tonal), inset_x=MENU_ITEM_INSET).emit(s, "menuitem-focused")
    s.add("menuitem-separator", 40, 9, lambda x, y: rect_markup(x, y, 0, 4, 40, 1, F(p["outlineVariant"])))
    s.add("menuitem-tearoff-normal", 20, 8, lambda x, y: rect_markup(x, y, 2, 3.5, 12, 1, F(p["outline"])))
    s.add("menuitem-tearoff-focused", 20, 8, lambda x, y: rect_markup(x, y, 2, 3.5, 12, 1, F(p["primary"])))
    s.newline()

    Slices(b, b, b, b, BUTTON_SHAPE).emit(s, "menubaritem-normal")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=layer("onSurface", 0.08)).emit(s, "menubaritem-focused")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(tonal)).emit(s, "menubaritem-toggled")
    Slices(b, b, b, b, BUTTON_SHAPE, fill=F(tonal)).emit(s, "menubaritem-pressed")
    s.blank("expand-menubaritem-normal")
    s.blank("menubar-normal")

    tip = F(p["inverseSurface"])
    shadowed_surface(s, "tooltip", TOOLTIP_SHADOW, TOOLTIP_RADIUS, TOOLTIP_SHAPE, tip, None,
                     0.35 if dark else 0.14)
    Slices(TOOLTIP_RADIUS, TOOLTIP_RADIUS, TOOLTIP_RADIUS, TOOLTIP_RADIUS, TOOLTIP_SHAPE,
           fill=tip).emit(s, "tooltip-normal")

    h = SCROLL_WIDTH // 2
    Slices(h, h, h, h, h, fill=layer("onSurfaceVariant", 0.42)).emit(s, "scrollbarslider-normal", interior=False)
    Slices(h, h, h, h, h, fill=layer("onSurfaceVariant", 0.70)).emit(s, "scrollbarslider-focused", interior=False)
    Slices(h, h, h, h, h, fill=layer("onSurface", 0.82)).emit(s, "scrollbarslider-pressed", interior=False)
    for state in ("normal", "focused", "pressed"):
        s.blank(f"grip-{state}")
    Slices(h, h, h, h, h).emit(s, "scrollgroove-normal", interior=False)

    t = SLIDER_TRACK // 2
    Slices(t, t, t, t, t, fill=F(p["secondaryContainer"])).emit(s, "slider-normal")
    Slices(t, t, t, t, t, fill=F(p["primary"])).emit(s, "slider-toggled")
    s.add("slider-tick-normal", 5, 1, lambda x, y: rect_markup(x, y, 0, 0, 5, 1, F(p["outline"])))
    s.newline()
    across, along = SLIDER_HANDLE_ACROSS, SLIDER_HANDLE_ALONG
    gap_fill = F(p["surface"])

    def handle(bar: float, halo: Fill | None):
        def body(x, y):
            markup = ""
            if halo:
                markup += rounded_rect(x, y + along / 2 - 7, across, 14, 7, halo)
            markup += rect_markup(x, y, (across - SLIDER_TRACK) / 2 - 1, 0, SLIDER_TRACK + 2, along, gap_fill)
            markup += rounded_rect(x, y + (along - bar) / 2, across, bar, bar / 2, F(p["primary"]))
            return markup
        return body

    s.add("slidercursor-normal", across, along, handle(4, None))
    s.add("slidercursor-focused", across, along, handle(4, layer("primary", 0.16)))
    s.add("slidercursor-pressed", across, along, handle(2, layer("primary", 0.22)))
    s.add("slidercursor-disabled", across, along, handle(4, None))
    s.newline()

    q = PROGRESS_THICKNESS // 2
    Slices(q, q, q, q, q, fill=F(p["secondaryContainer"])).emit(s, "progress-normal")
    Slices(q, q, q, q, q, fill=F(p["primary"])).emit(s, "progress-pattern-normal")
    Slices(q, q, q, q, q, fill=F(p["onSurface"], 0.38)).emit(s, "progress-pattern-disabled")

    n = CHECK_SIZE
    box = 16
    o = (n - box) / 2
    outline = F(p["onSurfaceVariant"])
    hover_outline = F(p["onSurface"])

    def checkbox(state: str, hover: bool):
        def body(x, y):
            markup = ""
            if hover:
                halo = layer("primary" if state != "off" else "onSurface", 0.14)
                markup += rounded_rect(x, y, n, n, 7, halo)
            if state == "off":
                markup += rounded_ring(x + o, y + o, box, box, 3, 2, hover_outline if hover else outline)
            else:
                markup += rounded_rect(x + o, y + o, box, box, 3, F(p["primary"]))
                symbol = "check" if state == "on" else "remove"
                markup += glyph(symbol, x + 2, y + 2, 16, F(p["onPrimary"]))
            return markup
        return body

    for state, prefix in (("off", "checkbox"), ("on", "checkbox-checked"), ("mixed", "checkbox-tristate")):
        s.add(f"{prefix}-normal", n, n, checkbox(state, False))
        s.add(f"{prefix}-focused", n, n, checkbox(state, True))
        s.add(f"{prefix}-pressed", n, n, checkbox(state, True))
    s.newline()

    def radio(on: bool, hover: bool):
        def body(x, y):
            markup = ""
            cx, cy = x + n / 2, y + n / 2
            if hover:
                markup += circle(cx, cy, n / 2, layer("primary" if on else "onSurface", 0.14))
            ring = F(p["primary"]) if on else (hover_outline if hover else outline)
            markup += ring_circle(cx, cy, 8, 2, ring)
            if on:
                markup += circle(cx, cy, 4, F(p["primary"]))
            return markup
        return body

    for on, prefix in ((False, "radio"), (True, "radio-checked")):
        s.add(f"{prefix}-normal", n, n, radio(on, False))
        s.add(f"{prefix}-focused", n, n, radio(on, True))
        s.add(f"{prefix}-pressed", n, n, radio(on, True))
    s.newline()

    menu_check = F(p["onSurface"])
    for prefix in ("menu-checkbox", "menu-radio"):
        s.blank(f"{prefix}-normal", n, n)
        s.blank(f"{prefix}-focused", n, n)
        s.add(f"{prefix}-checked-normal", n, n, lambda x, y: glyph("check", x, y, n, menu_check))
        s.add(f"{prefix}-checked-focused", n, n, lambda x, y: glyph("check", x, y, n, menu_check))
    s.add("menu-checkbox-tristate-normal", n, n, lambda x, y: glyph("remove", x, y, n, menu_check))
    s.add("menu-checkbox-tristate-focused", n, n, lambda x, y: glyph("remove", x, y, n, menu_check))
    s.newline()

    arrow_states = {
        "normal": F(p["onSurfaceVariant"]),
        "focused": F(p["onSurface"]),
        "pressed": F(p["primary"]),
        "toggled": F(p["onSecondaryContainer"]),
        "disabled": F(p["onSurface"], 0.38),
    }
    directions = {"up": "expand_less", "down": "expand_more", "left": "chevron_left", "right": "chevron_right"}
    for base in ("arrow", "menuitem"):
        for direction, symbol in directions.items():
            if base == "menuitem" and direction in ("up", "down"):
                continue
            for state, fill in arrow_states.items():
                if base == "menuitem" and state in ("toggled", "pressed"):
                    fill = F(p["onSecondaryContainer"])
                s.add(f"{base}-{direction}-{state}", INDICATOR, INDICATOR,
                      lambda x, y, symbol=symbol, fill=fill: glyph(symbol, x, y, INDICATOR, fill))
        s.newline()
    for state, fill in arrow_states.items():
        s.add(f"carrow-{state}", INDICATOR, INDICATOR,
              lambda x, y, fill=fill: glyph("expand_more", x, y, INDICATOR, fill))
    s.newline()
    for direction, symbol in {"up": "expand_less", "down": "expand_more", "plus": "add", "minus": "remove"}.items():
        for state, fill in arrow_states.items():
            s.add(f"sarrow-{direction}-{state}", INDICATOR, INDICATOR,
                  lambda x, y, symbol=symbol, fill=fill: glyph(symbol, x, y, INDICATOR, fill))
    s.newline()
    for state, fill in arrow_states.items():
        s.add(f"tree-plus-{state}", INDICATOR, INDICATOR,
              lambda x, y, fill=fill: glyph("chevron_right", x, y, INDICATOR, fill))
        s.add(f"tree-minus-{state}", INDICATOR, INDICATOR,
              lambda x, y, fill=fill: glyph("expand_more", x, y, INDICATOR, fill))
    s.newline()
    for state, fill in arrow_states.items():
        s.add(f"harrow-up-{state}", INDICATOR, INDICATOR,
              lambda x, y, fill=fill: glyph("arrow_upward", x + 2, y + 2, INDICATOR - 4, fill))
        s.add(f"harrow-down-{state}", INDICATOR, INDICATOR,
              lambda x, y, fill=fill: glyph("arrow_downward", x + 2, y + 2, INDICATOR - 4, fill))
    s.newline()

    def close_button(fill: Fill, halo: Fill | None):
        def body(x, y):
            markup = circle(x + 8, y + 8, 8, halo) if halo else ""
            return markup + glyph("close", x + 1, y + 1, 14, fill)
        return body

    s.add("tab-close-normal", 16, 16, close_button(F(p["onSurfaceVariant"]), None))
    s.add("tab-close-focused", 16, 16, close_button(F(p["onSurface"]), layer("onSurface", 0.12)))
    s.add("tab-close-pressed", 16, 16, close_button(F(p["onSurface"]), layer("onSurface", 0.2)))
    s.add("tab-close-disabled", 16, 16, close_button(F(p["onSurface"], 0.38), None))
    s.add("tab-close-toggled", 16, 16, close_button(F(p["onSecondaryContainer"]), None))
    s.add("tab-close-toggledFocused", 16, 16,
          close_button(F(p["onSecondaryContainer"]), layer("onSecondaryContainer", 0.14)))
    s.add("tab-close-toggledPressed", 16, 16,
          close_button(F(p["onSecondaryContainer"]), layer("onSecondaryContainer", 0.22)))
    s.add("tab-tear", 2, 24, lambda x, y: rect_markup(x, y, 0, 0, 2, 24, F(p["outlineVariant"])))
    s.newline()

    divider = F(p["outlineVariant"])
    for state, fill in (("normal", None), ("focused", layer("onSurface", 0.06)),
                        ("pressed", layer("onSurface", 0.10)), ("toggled", None)):
        name = f"header-{state}"
        s.add(name, 12, 12, lambda x, y, fill=fill: rect_markup(x, y, 0, 0, 12, 12, fill))
        s.add(f"{name}-bottom", 12, 1, lambda x, y: rect_markup(x, y, 0, 0, 12, 1, divider))
        s.add(f"{name}-bottomright", 1, 1, lambda x, y: rect_markup(x, y, 0, 0, 1, 1, divider))
        for position in ("top", "left", "right", "topleft", "topright", "bottomleft"):
            s.blank(f"{name}-{position}", 1, 1)
        s.newline()
    s.add("header-separator", 1, 20, lambda x, y: rect_markup(x, y, 0, 4, 1, 12, divider))
    s.newline()

    s.blank("splitter-normal")
    s.blank("splitter-focused")
    s.blank("splitter-pressed")
    s.add("splitter-grip-normal", 4, 32, lambda x, y: rounded_rect(x + 1, y, 2, 32, 1, layer("outline", 0.6)))
    s.add("splitter-grip-focused", 4, 32, lambda x, y: rounded_rect(x, y, 4, 32, 2, F(p["primary"])))
    s.add("splitter-grip-pressed", 4, 32, lambda x, y: rounded_rect(x, y, 4, 32, 2, F(p["primary"])))

    s.blank("toolbar-normal")
    s.blank("toolbar-handle")
    s.add("toolbar-separator", 8, 24, lambda x, y: rect_markup(x, y, 3.5, 4, 1, 16, F(p["outlineVariant"])))
    s.blank("sizegrip-normal")
    s.blank("sizegrip-focused")
    s.blank("dock-normal")
    s.blank("button-default-indicator")
    s.newline()

    s.add("dial", 64, 64, lambda x, y: ring_circle(x + 32, y + 32, 32, 6, F(p["secondaryContainer"])))
    s.add("dial-notches", 64, 64, lambda x, y: ring_circle(x + 32, y + 32, 32, 1, F(p["outline"])))
    s.add("dial-handle", 12, 12, lambda x, y: circle(x + 6, y + 6, 6, F(p["primary"])))
    s.newline()

    Slices(4, 4, 4, 4, 4, fill=F(p["surfaceContainer"])).emit(s, "titlebar-normal")
    Slices(4, 4, 4, 4, 4, fill=F(p["surfaceContainerHigh"])).emit(s, "titlebar-focused")
    for action, symbol in {"close": "close", "maximize": "crop_square", "restore": "filter_none",
                           "minimize": "minimize", "shade": "expand_less", "menu": "more_vert"}.items():
        for state, fill in arrow_states.items():
            if action == "menu" and state != "normal":
                continue
            s.add(f"mdi-{action}-{state}", INDICATOR, INDICATOR,
                  lambda x, y, symbol=symbol, fill=fill: glyph(symbol, x, y, INDICATOR, fill))
    s.newline()

    return config(p), s.render()


