        "Menu",
        frame="true", frame__element="menu", interior="true", interior__element="menu",
        frame__top=MENU_RADIUS, frame__bottom=MENU_RADIUS, frame__left=MENU_RADIUS, frame__right=MENU_RADIUS,
        text__normal__color=p["onSurface"],
    )
    item_side = MENU_ITEM_INSET + MENU_ITEM_RADIUS
    section(
        "MenuItem",
        frame="true", frame__element="menuitem", interior="true", interior__element="menuitem",
        indicator__element="menuitem", indicator__size=INDICATOR,
        frame__top=MENU_ITEM_RADIUS, frame__bottom=MENU_ITEM_RADIUS, frame__left=item_side, frame__right=item_side,
        frame__expansion=0,
        text__margin__top=0, text__margin__bottom=0, text__margin__left=0, text__margin__right=4,
        text__iconspacing=12,
        min_height=36,
        text__normal__color=p["onSurface"], text__focus__color=on_tonal,
        text__press__color=on_tonal, text__toggle__color=on_tonal,
        **text_off,
    )
    section(
        "MenuBar",
        frame="false", interior="false", frame__element="menubar", interior__element="menubar",
        text__normal__color=p["onSurface"],
    )
    section(
        "MenuBarItem",
        inherits="PanelButtonCommand",
        frame__element="menubaritem", interior__element="menubaritem",
        frame__top=4, frame__bottom=4, frame__left=4, frame__right=4,
        frame__expansion=BUTTON_FRAME * 2 + 12, focusFrame="false",
        text__margin__top=4, text__margin__bottom=4, text__margin__left=10, text__margin__right=10,
        min_height=0,
        text__normal__color=p["onSurface"], text__focus__color=p["onSurface"],
        text__press__color=on_tonal, text__toggle__color=on_tonal,
    )
    section(
        "TitleBar",
        frame="false", interior="true", interior__element="titlebar",
        indicator__element="mdi", indicator__size=INDICATOR,
        text__normal__color=p["onSurfaceVariant"], text__focus__color=p["onSurface"],
        text__bold="true", text__boldness=1,
        text__margin__top=2, text__margin__bottom=2, text__margin__left=6, text__margin__right=6,
    )
    section(
        "ComboBox",
        inherits="PanelButtonCommand",
        frame__element="combo", interior__element="combo",
        frame__top=FIELD_FRAME, frame__bottom=FIELD_FRAME, frame__left=FIELD_FRAME, frame__right=FIELD_FRAME,
        frame__expansion=FIELD_EXPANSION,
        focusFrame="false",
        indicator__element="carrow", indicator__size=INDICATOR,
        text__margin__top=4, text__margin__bottom=4, text__margin__left=10, text__margin__right=6,
        min_height=36,
        text__normal__color=p["onSurface"], text__focus__color=p["onSurface"],
        text__press__color=p["onSurface"], text__toggle__color=p["onSurface"],
    )
    section("ToolbarComboBox", inherits="ComboBox",
            text__normal__color=p["onSurface"], text__focus__color=p["onSurface"],
            text__press__color=p["onSurface"], text__toggle__color=p["onSurface"])
    section(
        "GroupBox",
        frame="true", frame__element="group", interior="true", interior__element="group",
        frame__top=4, frame__bottom=4, frame__left=4, frame__right=4,
        frame__expansion=CARD_EXPANSION,
        text__margin__top=2, text__margin__bottom=6, text__margin__left=4, text__margin__right=4,
        text__normal__color=p["primary"], text__focus__color=p["primary"],
        text__bold="true", text__boldness=1,
    )
    section(
        "ToolTip",
        frame="true", frame__element="tooltip", interior="true", interior__element="tooltip",
        frame__top=TOOLTIP_RADIUS, frame__bottom=TOOLTIP_RADIUS,
        frame__left=TOOLTIP_RADIUS, frame__right=TOOLTIP_RADIUS,
        text__margin__top=0, text__margin__bottom=0, text__margin__left=2, text__margin__right=2,
        text__normal__color=p["inverseOnSurface"], text__focus__color=p["inverseOnSurface"],
        **text_off,
    )
    section("Window", interior="false", frame="false")
    section("Dialog", interior="false", frame="false")

    lines = [
        f"# Kernora {'Dark' if dark else 'Light'} for Kvantum. Generated by tools/gen-kvantum-theme",
        f"# from the Kernora palette ({design.SEED}); do not edit.",
        "",
    ]
    for name, values in sections:
        lines.append(f"[{name}]")
        for key, value in values.items():
            lines.append(f"{key}={value}")
        lines.append("")
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    output = pathlib.Path(argv[1]) / THEME
    output.mkdir(parents=True, exist_ok=True)
    for dark, name in ((False, THEME), (True, THEME + "Dark")):
        kvconfig, svg = build(dark)
        (output / f"{name}.kvconfig").write_text(kvconfig, encoding="utf-8")
        (output / f"{name}.svg").write_text(svg, encoding="utf-8")
    print(f"kvantum theme: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
