#!/usr/bin/env python3
"""usage: gen-emoji-data EMOJI_TEST CLDR_COMMON OUTPUT.js
"""

from __future__ import annotations

import json
import pathlib
import re
import sys
import xml.etree.ElementTree as ElementTree

GROUPS = {
    "Smileys & Emotion": "smileys",
    "People & Body": "people",
    "Animals & Nature": "nature",
    "Food & Drink": "food",
    "Travel & Places": "travel",
    "Activities": "activities",
    "Objects": "objects",
    "Symbols": "symbols",
    "Flags": "flags",
}
LANGUAGES = ("en", "ru")
VARIATIONS = {0x1F3FB, 0x1F3FC, 0x1F3FD, 0x1F3FE, 0x1F3FF, 0x1F9B0, 0x1F9B1, 0x1F9B2, 0x1F9B3}
LINE = re.compile(r"^([0-9A-F ]+?)\s*;\s*fully-qualified\s*#")


def annotations(common: pathlib.Path, language: str) -> tuple[dict[str, str], dict[str, str]]:
    names: dict[str, str] = {}
    keywords: dict[str, str] = {}
    for directory in ("annotations", "annotationsDerived"):
        path = common / directory / f"{language}.xml"
        for element in ElementTree.parse(path).getroot().iter("annotation"):
            key = element.get("cp", "").replace("️", "")
            text = (element.text or "").strip()
            if not key or not text or text == "↑↑↑":
                continue
            if element.get("type") == "tts":
                names.setdefault(key, text)
            else:
                keywords.setdefault(key, text)
    return names, keywords


def main(argv: list[str]) -> int:
    if len(argv) != 4:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    emoji_test = pathlib.Path(argv[1])
    common = pathlib.Path(argv[2])
    output = pathlib.Path(argv[3])

    names = {language: annotations(common, language) for language in LANGUAGES}

    groups: list[dict[str, object]] = []
    current: dict[str, object] | None = None
    for line in emoji_test.read_text(encoding="utf-8").splitlines():
        if line.startswith("# group: "):
            title = line[len("# group: "):].strip()
            current = None
            if title in GROUPS:
                current = {"id": GROUPS[title], "emoji": []}
                groups.append(current)
            continue
        match = LINE.match(line)
        if not match or current is None:
            continue
        points = [int(part, 16) for part in match.group(1).split()]
        if VARIATIONS.intersection(points):
            continue
        text = "".join(chr(point) for point in points)
        key = text.replace("️", "")
        comment = line.split("#", 1)[1].strip()
        fallback = re.sub(r"^\S+\s+E\d+\.\d+\s+", "", comment)
        entry_names = []
        search = []
        for language in LANGUAGES:
            language_names, language_keywords = names[language]
            name = language_names.get(key, fallback if language == "en" else "")
            entry_names.append(name)
            search.append(name)
            search.append(language_keywords.get(key, "").replace(" | ", " "))
        entry = [text, *entry_names, " ".join(search).lower()]
        if key != text:
            entry.append(key)
        current["emoji"].append(entry)

    missing = [group for group in GROUPS.values() if group not in {g["id"] for g in groups}]
    if missing:
        print(f"gen-emoji-data: groups missing from {emoji_test}: {missing}", file=sys.stderr)
        return 1
    count = sum(len(group["emoji"]) for group in groups)
    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("w", encoding="utf-8") as file:
        file.write("// Kernora emoji, generated by tools/gen-emoji-data from Unicode's\n")
        file.write("// emoji-test.txt and CLDR's annotations. Do not edit.\n")
        file.write("// Data: Copyright 1991-2024 Unicode, Inc., Unicode License v3\n")
        file.write("// (see debian/copyright).\n")
        file.write(".pragma library\n\n")
        file.write("var groups = ")
        json.dump(groups, file, ensure_ascii=False, separators=(",", ":"))
        file.write(";\n")
    print(f"emoji: {count} in {len(groups)} groups -> {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
