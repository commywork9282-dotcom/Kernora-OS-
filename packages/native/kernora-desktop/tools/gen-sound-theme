def write_wav(path: pathlib.Path, samples: list[float]) -> None:
    with wave.open(str(path), "wb") as out:
        out.setnchannels(1)
        out.setsampwidth(2)
        out.setframerate(RATE)
        out.writeframes(b"".join(struct.pack("<h", max(-32767, min(32767, round(v * 32767)))) for v in samples))


def main(argv: list[str]) -> int:
    if len(argv) not in (2, 3):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    root = pathlib.Path(argv[1]) / THEME
    stereo = root / "stereo"
    stereo.mkdir(parents=True, exist_ok=True)
    only = set(argv[2].split(",")) if len(argv) == 3 else None
    for name, render in SOUNDS.items():
        if only is None or name in only:
            write_wav(stereo / f"{name}.wav", render())
    for alias, target in ALIASES.items():
        link = stereo / f"{alias}.wav"
        if link.is_symlink() or link.exists():
            link.unlink()
        os.symlink(f"{target}.wav", link)
    (root / "index.theme").write_text(
        "[Sound Theme]\n"
        "Name=Kernora\n"
        "Comment=Kernora sounds\n"
        "Inherits=freedesktop\n"
        "Directories=stereo\n"
        "Example=theme-demo\n"
        "\n"
        "[stereo]\n"
        "OutputProfile=stereo\n",
        encoding="utf-8",
    )
    print(f"sound theme: {root} ({len(SOUNDS)} sounds, {len(ALIASES)} aliases)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
