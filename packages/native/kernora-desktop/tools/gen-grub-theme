#!/usr/bin/env python3
"""usage: gen-grub-theme LOGO.svg OUTPUT_DIR [dark|light]
"""

from __future__ import annotations

import pathlib
import re
import sys

import kernora_design as design

ITEM_HEIGHT = 24
ITEM_RADIUS = 20
ITEM_GAP = 8
LOGO_SIZE = 96
MENU_WIDTH = 600


def svg(width: int, height: int, body: str) -> str:
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
            f'viewBox="0 0 {width} {height}">{body}</svg>\n')


def nine_slice(prefix: str, radius: int, fill: str) -> dict[str, str]:
    r = radius
    pieces = {
        "nw": svg(r, r, f'<path fill="{fill}" d="M{r} 0A{r} {r} 0 0 0 0 {r}L{r} {r}Z"/>'),
        "ne": svg(r, r, f'<path fill="{fill}" d="M0 0A{r} {r} 0 0 1 {r} {r}L0 {r}Z"/>'),
        "sw": svg(r, r, f'<path fill="{fill}" d="M0 0L{r} 0L{r} {r}A{r} {r} 0 0 1 0 0Z"/>'),
        "se": svg(r, r, f'<path fill="{fill}" d="M0 0L{r} 0A{r} {r} 0 0 1 0 {r}Z"/>'),
        "n": svg(1, r, f'<rect width="1" height="{r}" fill="{fill}"/>'),
        "s": svg(1, r, f'<rect width="1" height="{r}" fill="{fill}"/>'),
        "w": svg(r, 1, f'<rect width="{r}" height="1" fill="{fill}"/>'),
        "e": svg(r, 1, f'<rect width="{r}" height="1" fill="{fill}"/>'),
        "c": svg(1, 1, f'<rect width="1" height="1" fill="{fill}"/>'),
    }
    return {f"{prefix}_{name}.svg": body for name, body in pieces.items()}


def theme_txt(dark: dict[str, str]) -> str:
    return f"""# Kernora boot menu. Generated by tools/gen-grub-theme.
title-text: ""
desktop-color: "{dark["surface"]}"
terminal-font: "Roboto Regular Regular 16"
terminal-box: "terminal_*.png"

+ image {{
    left = 50%-{LOGO_SIZE // 2}
    top = 14%
    file = "logo.png"
}}

+ label {{
    left = 0
    top = 14%+{LOGO_SIZE + 20}
    width = 100%
    align = "center"
    text = "Kernora OS"
    font = "Roboto Regular Regular 24"
    color = "{dark["onSurface"]}"
}}

+ boot_menu {{
    left = 50%-{MENU_WIDTH // 2}
    top = 14%+{LOGO_SIZE + 88 + ITEM_RADIUS}
    width = {MENU_WIDTH}
    height = 50%
    item_font = "Roboto Regular Regular 16"
    selected_item_font = "Roboto Medium Regular 16"
    item_color = "{dark["onSurfaceVariant"]}"
    selected_item_color = "{dark["onSecondaryContainer"]}"
    item_height = {ITEM_HEIGHT}
    item_padding = 0
    item_spacing = {ITEM_RADIUS * 2 + ITEM_GAP}
    item_pixmap_style = "item_*.png"
    selected_item_pixmap_style = "select_*.png"
    icon_width = 0
    icon_height = 0
    item_icon_space = 4
    scrollbar = false
}}
"""


def main(argv: list[str]) -> int:
    if len(argv) not in (3, 4) or (len(argv) == 4 and argv[3] not in ("dark", "light")):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    logo = pathlib.Path(argv[1])
    output = pathlib.Path(argv[2])
    output.mkdir(parents=True, exist_ok=True)
    dark = design.LIGHT if len(argv) == 4 and argv[3] == "light" else design.DARK

    (output / "theme.txt").write_text(theme_txt(dark), encoding="utf-8")
    text = logo.read_text(encoding="utf-8")
    text = re.sub(r'fill="#[0-9a-fA-F]{6}"', f'fill="{dark["onSurface"]}"', text)
    text = re.sub(r'width="\d+" height="\d+"', f'width="{LOGO_SIZE}" height="{LOGO_SIZE}"', text, count=1)
    (output / "logo.svg").write_text(text, encoding="utf-8")

    pictures: dict[str, str] = {}
    pictures.update(nine_slice("item", ITEM_RADIUS, dark["surfaceContainer"]))
    pictures.update(nine_slice("select", ITEM_RADIUS, dark["secondaryContainer"]))
    pictures.update(nine_slice("terminal", 16, dark["surfaceContainer"]))
    for name, body in pictures.items():
        (output / name).write_text(body, encoding="utf-8")
    print(f"GRUB theme: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
