#!/usr/bin/env python3
"""usage: gen-icon-theme SYMBOL_DIRECTORY OUTPUT_DIRECTORY
"""

from __future__ import annotations

import os
import pathlib
import re
import sys

import kernora_design as design
import symbols_map

SVG_BODY = re.compile(r"<svg[^>]*>(.*)</svg>\s*$", re.S)
VIEW_BOX = re.compile(r'viewBox="0 -960 960 960"')

CONTEXT_NAMES = {
    "actions": "Actions",
    "apps": "Applications",
    "categories": "Categories",
    "devices": "Devices",
    "emblems": "Emblems",
    "mimetypes": "MimeTypes",
    "places": "Places",
    "status": "Status",
}

GRID_SCALE = 24.0 / 960.0

TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<!-- {name}: {credit}{fill}.
     Generated by tools/gen-icon-theme; edit the mapping, not this file. -->
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
  <defs>
    <style type="text/css" id="current-color-scheme">
      .ColorScheme-Text {{ color:{ink}; }}
    </style>
  </defs>
  <g class="ColorScheme-Text" fill="currentColor" transform="scale({scale}) translate(0,960)">
    {body}
  </g>
</svg>
"""


def convert(source: pathlib.Path, symbol: str, fill: bool, name: str, ink: str) -> str:
    text = source.read_text(encoding="utf-8")
    if not VIEW_BOX.search(text):
        raise SystemExit(f"{source.name}: unexpected viewBox, upstream cut changed")
    match = SVG_BODY.search(text)
    if match is None:
        raise SystemExit(f"{source.name}: could not read the drawing")
    body = match.group(1).strip()
    return TEMPLATE.format(
        name=name,
        credit=symbols_map.credit(symbol),
        fill=", filled" if fill else "",
        ink=ink,
        scale=f"{GRID_SCALE:.6f}".rstrip("0"),
        body=body,
    )


APP_TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<!-- {name}: themed application icon, {credit}.
     Generated by tools/gen-icon-theme. -->
<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48">
  <circle cx="24" cy="24" r="22" fill="{container}"/>
  <g fill="{ink}" transform="translate(10 10) scale({scale}) translate(0,960)">
    {body}
  </g>
</svg>
"""


def app_icon(source: pathlib.Path, symbol: str, name: str) -> str:
    text = source.read_text(encoding="utf-8")
    if not VIEW_BOX.search(text):
        raise SystemExit(f"{source.name}: unexpected viewBox, upstream cut changed")
    body = SVG_BODY.search(text).group(1).strip()
    return APP_TEMPLATE.format(
        name=name,
        credit=symbols_map.credit(symbol),
        container=design.LIGHT["primaryContainer"],
        ink=design.LIGHT["onPrimaryContainer"],
        scale=f"{28 / 960:.6f}",
        body=body,
    )


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    assets = pathlib.Path(argv[1])
    output = pathlib.Path(argv[2])
    ink = design.DARK["onSurfaceVariant"]

    written = 0
    linked = 0
    claimed: dict[str, str] = {}
    coloured = design.COLOUR != design.DEFAULT_COLOUR

    for symbol, fill, context, names in [] if coloured else symbols_map.ICONS:
        directory = output / "scalable" / context
        directory.mkdir(parents=True, exist_ok=True)

        all_names = symbols_map.aliases(names)
        primary = all_names[0]
        source = assets / symbols_map.asset_name(symbol, fill)
        if not source.exists():
            raise SystemExit(f"missing vendored symbol: {source}")

        (directory / f"{primary}.svg").write_text(
            convert(source, symbol, fill, primary, ink), encoding="utf-8"
        )
        claimed[primary] = context
        written += 1

        for alias in all_names[1:]:
            if alias in claimed:
                raise SystemExit(
                    f"duplicate icon name {alias!r} (already from {claimed[alias]})"
                )
            claimed[alias] = context
            link = directory / f"{alias}.svg"
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to(f"{primary}.svg")
            linked += 1

    apps = output / "scalable" / "apps"
    apps.mkdir(parents=True, exist_ok=True)
    for symbol, fill, names in symbols_map.APP_ICONS:
        source = assets / symbols_map.asset_name(symbol, fill)
        if coloured:
            names = [name for name in names if "." in name or "-" not in name]
            if not names:
                continue
        primary = names[0]
        for name in names:
            if name in claimed:
                raise SystemExit(f"duplicate icon name {name!r} (already from {claimed[name]})")
            claimed[name] = "apps"
        (apps / f"{primary}.svg").write_text(app_icon(source, symbol, primary), encoding="utf-8")
        written += 1
        for alias in names[1:]:
            link = apps / f"{alias}.svg"
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to(f"{primary}.svg")
            linked += 1

    directories = sorted(
        path.name for path in (output / "scalable").iterdir() if path.is_dir()
    )
    index = [
        "[Icon Theme]",
        f"Name=Kernora{design.COLOUR_LABEL}",
        "Comment=Kernora OS icons, drawn from Material Symbols Rounded",
        "Inherits=" + ("Kernora," if coloured else "") + "breeze-dark,breeze,hicolor",
        "Hidden=true" if coloured else "",
        "Directories=" + ",".join(f"scalable/{name}" for name in directories),
        "",
        "Example=start-here-kde",
        "",
    ]
    for name in directories:
        index += [
            f"[scalable/{name}]",
            "Size=24",
            "MinSize=8",
            "MaxSize=512",
            f"Context={CONTEXT_NAMES[name]}",
            "Type=Scalable",
            "",
        ]
    (output / "index.theme").write_text("\n".join(index), encoding="utf-8")

    print(f"icon theme: {written} drawings, {linked} aliases in {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
