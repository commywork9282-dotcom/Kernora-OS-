#!/usr/bin/env python3
"""usage: gen-terminal-theme OUTPUT_DIRECTORY
"""

from __future__ import annotations

import pathlib
import sys

import kernora_design as design
import m3color

ANSI_HUES = {
    "red": 25.0,
    "green": 145.0,
    "yellow": 85.0,
    "blue": 265.0,
    "magenta": 330.0,
    "cyan": 195.0,
}


def tone(hue: float, chroma: float, value: float) -> str:
    return m3color.hex_from_rgb(m3color.rgb_from_hct(hue, chroma, value))


def scheme(dark: bool) -> str:
    roles = design.DARK if dark else design.LIGHT
    normal_tone, bright_tone = (72, 82) if dark else (40, 32)
    seed = m3color.Hct.from_hex(design.SEED)
    grey = lambda value: tone(seed.hue, 6, value)
    lines = [
        f"# Kernora {'dark' if dark else 'light'} terminal colours. Generated by tools/gen-terminal-theme.",
        "",
        "[colors.primary]",
        f'background = "{roles["surface"]}"',
        f'foreground = "{roles["onSurface"]}"',
        "",
        "[colors.cursor]",
        f'cursor = "{roles["primary"]}"',
        f'text = "{roles["onPrimary"]}"',
        "",
        "[colors.selection]",
        f'background = "{roles["primaryContainer"]}"',
        f'text = "{roles["onPrimaryContainer"]}"',
        "",
        "[colors.search.matches]",
        f'background = "{roles["tertiaryContainer"]}"',
        f'foreground = "{roles["onTertiaryContainer"]}"',
        "",
        "[colors.search.focused_match]",
        f'background = "{roles["primary"]}"',
        f'foreground = "{roles["onPrimary"]}"',
        "",
    ]
    for section, value in (("normal", normal_tone), ("bright", bright_tone)):
        lines.append(f"[colors.{section}]")
        lines.append(f'black = "{grey(20 if dark else 25) if section == "normal" else grey(45 if dark else 45)}"')
        for name, hue in ANSI_HUES.items():
            lines.append(f'{name} = "{tone(design._harmonized_hue(hue), 48, value)}"')
        lines.append(f'white = "{grey(85 if dark else 70) if section == "normal" else grey(97 if dark else 85)}"')
        lines.append("")
    return "\n".join(lines)


SYSTEM = """# Kernora OS terminal defaults. Generated by tools/gen-terminal-theme;
# ~/.config/alacritty/alacritty.toml takes precedence.

[general]
# The dark colours, then the user's choice from Kernora Settings (a later
# import wins; a missing file is skipped).
import = [
    "/usr/share/kernora/terminal/dark.toml",
    "~/.config/alacritty/kernora-colors.toml",
]
live_config_reload = true

[window]
padding = { x = 16, y = 12 }
dynamic_padding = true
dynamic_title = true

# Debian's shell start-up files name the window after the prompt
# ("user@host: ~") only for xterm-like terminals; without this the window
# stays titled "Alacritty".
[env]
TERM = "xterm-256color"

[font]
normal = { family = "Hack", style = "Regular" }
size = 11.0

[cursor]
style = { shape = "Beam", blinking = "On" }
unfocused_hollow = true

[scrolling]
history = 20000

[selection]
save_to_clipboard = false
"""


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    output = pathlib.Path(argv[1])
    (output / "terminal").mkdir(parents=True, exist_ok=True)
    (output / "alacritty.toml").write_text(SYSTEM, encoding="utf-8")
    (output / "terminal" / "dark.toml").write_text(scheme(True), encoding="utf-8")
    (output / "terminal" / "light.toml").write_text(scheme(False), encoding="utf-8")
    print(f"terminal theme: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
