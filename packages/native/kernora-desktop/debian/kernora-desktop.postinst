#!/bin/sh
set -e

if [ "$1" = configure ]; then
    update-alternatives --install /usr/share/icons/default/index.theme x-cursor-theme \
        /usr/share/icons/kernora_cursors/cursor.theme 100
    if [ -d /boot/grub ]; then
        /usr/libexec/kernora-grub-theme || true
    fi
    if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
        update-grub || true
    fi
    greeter=/usr/share/sddm/themes/kernora/theme.conf.user
    if [ -f "$greeter" ] && grep -q '^wallpaper=org\.kernora\.tower$' "$greeter"; then
        sed -i 's/^wallpaper=org\.kernora\.tower$/wallpaper=org.kernora.shapes/' "$greeter"
    fi
    /usr/libexec/kernora-splash-wallpaper || true
    /usr/libexec/kernora-boot-theme || true
    active=$(/usr/sbin/plymouth-set-default-theme 2>/dev/null || true)
    splash=/usr/share/plymouth/themes/${active:-kernora}
    stamp=/var/lib/kernora/plymouth-theme
    if [ -d "$splash" ] && [ -x /usr/sbin/update-initramfs ]; then
        sum=$( { echo "${active:-kernora}"; cd "$splash" && find . -type f | LC_ALL=C sort | xargs md5sum; } | md5sum | cut -d' ' -f1)
        if [ "$sum" != "$(cat "$stamp" 2>/dev/null || true)" ]; then
            dpkg-trigger --no-await update-initramfs || update-initramfs -u || true
            install -d -m 0755 /var/lib/kernora
            printf '%s\n' "$sum" > "$stamp"
        fi
    fi
fi

#DEBHELPER#
