#!/bin/sh
set -e

if [ "$1" = remove ]; then
    update-alternatives --remove x-cursor-theme /usr/share/icons/kernora_cursors/cursor.theme || true
fi

shell=/usr/share/plasma/shells/org.kde.plasma.desktop/contents
notifications=/usr/share/plasma/plasmoids/org.kde.plasma.notifications/contents/ui
tasks=/usr/share/plasma/plasmoids/org.kde.plasma.taskmanager/contents/ui
folder=/usr/share/plasma/plasmoids/org.kde.desktopcontainment/contents/ui
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
    for file in "$shell/lockscreen/LockScreen.qml" "$shell/osd/Osd.qml" \
            "$shell/configuration/AppletConfiguration.qml" \
            "$shell/configuration/ConfigurationContainmentAppearance.qml" \
            "$shell/configuration/ConfigurationContainmentActions.qml" \
            "$shell/configuration/AboutPlugin.qml" "$shell/configuration/ConfigurationShortcuts.qml" \
            "$shell/explorer/WidgetExplorer.qml" "$shell/views/DesktopEditMode.qml" \
            "$shell/configuration/panelconfiguration/PanelRepresentation.qml" \
            "$folder/ConfigLocation.qml" "$folder/ConfigIcons.qml" "$folder/ConfigFilter.qml" \
            "$folder/ConfigOverlay.qml" "$folder/FolderView.qml" \
            /usr/share/plasma/plasmoids/org.kde.plasma.panelspacer/contents/ui/main.qml \
            "$notifications/main.qml" "$tasks/Badge.qml" "$tasks/ToolTipInstance.qml" "$tasks/AudioStream.qml" \
            /usr/share/kglobalaccel/org.kde.krunner.desktop \
            /usr/share/kglobalaccel/org.kde.plasma.emojier.desktop \
            /usr/share/plymouth/plymouthd.defaults; do
        dpkg-divert --package kernora-desktop --remove --rename \
            --divert "$file.kde" "$file"
    done
fi

#DEBHELPER#
