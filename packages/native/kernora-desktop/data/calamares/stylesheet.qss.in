#prettyRadioButton {
    background-color: @surfaceContainer@;
    border-radius: 20px;
    qproperty-warningColor: @error@;
}

#prettyRadioButton[checked="true"] {
    background-color: @secondaryContainer@;
}

#prettyRadioButton QLabel {
    background: transparent;
    color: @onSurface@;
}

#prettyRadioButton[checked="true"] QLabel {
    color: @onSecondaryContainer@;
}

BootInfoWidget QLabel,
DeviceInfoWidget QLabel {
    background: transparent;
    color: @onSurfaceVariant@;
}

ChoicePage QLabel {
    background: transparent;
}

ChoicePage QScrollArea,
ChoicePage QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

#partitionTreeView {
    background-color: @surfaceContainer@;
    alternate-background-color: @surfaceContainer@;
    border: none;
    border-radius: 16px;
    padding: 6px;
}

#CreatePartitionTableDialog #label {
    min-height: 40px;
}

#m_listFlags {
    background-color: @surfaceContainer@;
    alternate-background-color: @surfaceContainer@;
    border: none;
    border-radius: 16px;
    padding: 6px;
}

QMessageBox QLabel#qt_msgboxex_icon_label {
    max-width: 0px;
    max-height: 0px;
    margin: 0px;
    padding: 0px;
}

QMessageBox QLabel#qt_msgbox_label {
    color: @onSurface@;
}

#pixelPage {
    background-color: @surface@;
}

#pixelPage QLabel#pixelTitle {
    background: transparent;
    color: @onSurface@;
    font-size: 36px;
}

#pixelPage QLabel#pixelDescription {
    background: transparent;
    color: @onSurfaceVariant@;
    font-size: 16px;
}

#pixelPage QToolButton#pixelBack {
    background-color: @surfaceContainerHigh@;
    border: none;
    border-radius: 24px;
}

#pixelPage QToolButton#pixelBack:hover {
    background-color: @surfaceContainerHighest@;
}

#pixelPage QPushButton#pixelPrimary {
    background-color: @primary@;
    color: @onPrimary@;
    border: none;
    border-radius: 28px;
    padding: 0px 24px;
    font-size: 14px;
    font-weight: 500;
}

#pixelPage QPushButton#pixelPrimary:hover {
    background-color: @primaryFixed@;
}

#pixelPage QPushButton#pixelPrimary:disabled {
    background-color: @surfaceContainerHighest@;
    color: @outline@;
}

#slideshow QTabWidget::pane {
    border: none;
    margin: 0px;
    padding: 0px;
}
