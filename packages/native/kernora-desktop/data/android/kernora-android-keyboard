import os
import re
import subprocess
import sys

REAL = "/usr/bin/waydroid.waydroid"
DEVICE = "i32 1 s16 vendor:1,product:1 i32 1 i32 1"
LAYOUT = "com.android.inputdevices/com.android.inputdevices.InputDeviceReceiver/keyboard_layout_"
SET_CURRENT = 18
REMOVE = 21


def commands(current: int, names: list[str]) -> str:
    lines = ['[ "$(getprop ro.build.version.sdk)" = 33 ] || exit 0',
             f"service call input {SET_CURRENT} {DEVICE} s16 {LAYOUT}{names[current]}"]
    lines += [f"service call input {REMOVE} {DEVICE} s16 {LAYOUT}{name}"
              for index, name in enumerate(names) if index != current]
    return "\n".join(lines) + "\n"


def apply(current: int, names: list[str]) -> int:
    try:
        subprocess.run([REAL, "shell", "--", "sh", "-c", commands(current, names)], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60, check=False)
    except subprocess.TimeoutExpired:
        return 1
    return 0


def main() -> int:
    if os.geteuid() != 0:
        return 1
    arguments = sys.argv[1:]
    if len(arguments) >= 3 and arguments[0] == "layouts" and arguments[1].isdigit():
        names = arguments[2:]
        current = int(arguments[1])
        if len(names) <= 8 and current < len(names) and all(re.fullmatch(r"[a-z_]{2,40}", name) for name in names):
            return apply(current, names)
    print("usage: kernora-android-keyboard layouts CURRENT NAME...", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
