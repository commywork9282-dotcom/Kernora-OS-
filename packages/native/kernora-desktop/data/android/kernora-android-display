        self.subsurface: int | None = None
        self.hidden = False
        self.parent: Surface | None = None
        self.children: set[Surface] = set()
        self.xdg: int | None = None
        self.held_attach: bytes | None = None
        self.geometry: tuple[int, int, int, int] | None = None
        self.mapped = False
        self.show_at = 0.0
        self.app = ""
        self.toplevel: int | None = None
        self.listed_by = 0.0
        self.unlisted = False
        self.rebuilding = False
        self.announce_at = 0.0
        self.server_id: int | None = None
        self.viewport: int | None = None
        self.client_view: int | None = None
        self.client_surface: int | None = None
