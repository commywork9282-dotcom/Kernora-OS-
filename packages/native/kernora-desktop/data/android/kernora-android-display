def pad(size: int) -> int:
    return (size + 3) & ~3


def close_to(first: tuple[int, int], second: tuple[int, int]) -> bool:
    return abs(first[0] - second[0]) <= SLACK and abs(first[1] - second[1]) <= SLACK


def wayland_string(text: str) -> bytes:
    data = text.encode() + b"\0"
    return struct.pack("<I", len(data)) + data.ljust(pad(len(data)), b"\0")


def entry(app: str) -> str:
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for folder in (os.path.join(data, "applications"), SYSTEM_ENTRIES):
        path = os.path.join(folder, f"waydroid.{app}.desktop")
        if os.path.exists(path):
            return path
    return ""


def listed(app: str) -> bool:
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = entry(app)
    try:
        built = max((os.path.getmtime(item) for item in glob.glob(os.path.join(glob.escape(cache), "ksycoca6_*"))), default=0)
        return bool(path) and os.path.getmtime(path) <= built <= time.time() - MENU_SETTLES
    except OSError:
        return False


def rebuild_menu() -> None:
    def build() -> None:
        subprocess.run(["kbuildsycoca6"], check=False, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       env={**os.environ, "XDG_MENU_PREFIX": os.environ.get("XDG_MENU_PREFIX") or "plasma-"})

    threading.Thread(target=build, daemon=True).start()


def refresh_panel() -> None:
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    try:
        with open(os.path.join(config, "taskmanagerrulesrc"), "a", encoding="utf-8"):
            os.utime(os.path.join(config, "taskmanagerrulesrc"))
    except OSError:
        pass


