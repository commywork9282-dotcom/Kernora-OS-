#!/bin/bash
set -u

real=/usr/bin/waydroid.waydroid
state_dir=/var/lib/kernora/android
seed=${1:-}
mode=${2:-}
style=${3:-TONAL_SPOT}
density=${4:-}

[[ $seed =~ ^[0-9A-Fa-f]{6}$ ]] || exit 2
[[ $mode == dark || $mode == light ]] || exit 2
[[ $style == TONAL_SPOT || $style == SPRITZ ]] || exit 2
[[ -z $density || ( $density =~ ^[0-9]{3}$ && $density -ge 100 && $density -le 480 ) ]] || exit 2
(( EUID == 0 )) || exit 1
[[ -x $real ]] || exit 0
"$real" status 2>/dev/null | grep -q 'Session:.*RUNNING' || exit 0

android() {
  timeout 20 "$real" shell -- "$@" < /dev/null 2>/dev/null | cat
}

"$real" container unfreeze > /dev/null 2>&1 || true
json="{\"android.theme.customization.color_source\":\"preset\",\"android.theme.customization.system_palette\":\"${seed^^}\",\"android.theme.customization.accent_color\":\"${seed^^}\",\"android.theme.customization.theme_style\":\"$style\"}"
if [[ $(android settings get secure theme_customization_overlay_packages) != "$json" ]]; then
  android settings put secure theme_customization_overlay_packages "$json" > /dev/null
fi
night=no
[[ $mode == dark ]] && night=yes
if [[ $(android cmd uimode night) != "Night mode: $night" ]]; then
  android cmd uimode night "$night" > /dev/null
fi
if [[ -n $density ]]; then
  current=$(android wm density | sed -n 's/^Override density: //p' | tr -d '\r')
  [[ -n $current ]] || current=$(android wm density | sed -n 's/^Physical density: //p' | tr -d '\r')
  [[ $current == "$density" ]] || android wm density "$density" > /dev/null
fi
model=$(android getprop ro.product.model | tr -d '\r')
if [[ -n $model && $(android settings get global device_name | tr -d '\r') != "$model" ]]; then
  android settings put global device_name "$model" > /dev/null
fi
setting() {
  [[ $(android settings get "$1" "$2" | tr -d '\r') == "$3" ]] && return 1
  android settings put "$1" "$2" "$3" > /dev/null
}
setting global device_provisioned 1
setting secure user_setup_complete 1
setting global hide_error_dialogs 1
setting secure show_ime_with_hard_keyboard 0
setting system screen_off_timeout 1800000
setting global private_dns_mode off
for keyboard in $(android ime list -s -a | tr -d '\r'); do
  package=${keyboard%%/*}
  if android pm list packages -s "$package" | tr -d '\r' | grep -qx "package:$package"; then
    android pm disable-user --user 0 "$package" > /dev/null
  fi
done
for package in org.lineageos.waydroidupdater com.google.android.setupwizard org.lineageos.setupwizard; do
  if android pm list packages -e "$package" | tr -d '\r' | grep -qx "package:$package"; then
    android pm disable-user --user 0 "$package" > /dev/null
  fi
done
packages=$(android pm list packages -s | sed -n 's/^package://p' | tr -d '\r' | grep -E '^[A-Za-z0-9_.]+$' | LC_ALL=C sort)
if [[ -n $packages ]]; then
  install -d -m 0755 "$state_dir"
  printf '%s\n' "$packages" > "$state_dir/system-packages.new"
  chmod 0644 "$state_dir/system-packages.new"
  mv "$state_dir/system-packages.new" "$state_dir/system-packages"
fi
if android pm list packages -s com.google.android.gsf | grep -q .; then
  id=$(android sqlite3 -cmd ".timeout 8000" /data/data/com.google.android.gsf/databases/gservices.db \
    "select value from main where name = 'android_id';" | tr -cd '0-9')
  accounts=$(android dumpsys account | sed -n 's/^ *Accounts: \([0-9]*\).*/\1/p' | head -n 1)
  install -d -m 0755 "$state_dir"
  printf 'android_id=%s\naccounts=%s\ntime=%s\n' "$id" "$accounts" "$(date +%s)" > "$state_dir/google.new"
  chmod 0644 "$state_dir/google.new"
  mv "$state_dir/google.new" "$state_dir/google"
fi
