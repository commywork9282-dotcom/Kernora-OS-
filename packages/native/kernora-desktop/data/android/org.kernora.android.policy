<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-FileCopyrightText: 2026 Kernora Developers
     SPDX-License-Identifier: GPL-2.0-or-later -->
<policyconfig>
  <vendor>Kernora OS</vendor>
  <action id="org.kernora.android">
    <description>Manage Android apps</description>
    <description xml:lang="ru">Управление приложениями Android</description>
    <message>This change to Android apps needs administrator rights</message>
    <message xml:lang="ru">Для этого действия с приложениями Android нужны права администратора</message>
    <icon_name>org.kernora.android</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kernora-android</annotate>
  </action>
  <action id="org.kernora.android.sync">
    <description>Keep Android apps in step with Kernora</description>
    <description xml:lang="ru">Согласование приложений Android с Kernora</description>
    <message>Android apps follow the colour and the dark theme of Kernora</message>
    <message xml:lang="ru">Приложения Android следуют цвету и тёмной теме Kernora</message>
    <icon_name>org.kernora.android</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kernora-android-sync</annotate>
  </action>
  <action id="org.kernora.android.windows">
    <description>Open Android apps in computer-sized windows</description>
    <description xml:lang="ru">Открытие Android-приложений в окнах для компьютера</description>
    <message>Android apps open in windows sized for a computer</message>
    <message xml:lang="ru">Android-приложения открываются в окнах размером для компьютера</message>
    <icon_name>org.kernora.android</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kernora-android-windows</annotate>
  </action>
  <action id="org.kernora.android.keyboard">
    <description>Let Android apps follow the keyboard layout</description>
    <description xml:lang="ru">Раскладка клавиатуры в Android-приложениях</description>
    <message>Android apps type in the keyboard layout chosen in Kernora</message>
    <message xml:lang="ru">Android-приложения печатают в раскладке, выбранной в Kernora</message>
    <icon_name>org.kernora.android</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kernora-android-keyboard</annotate>
  </action>
  <action id="org.kernora.android.refresh">
    <description>Prepare Android apps for this computer</description>
    <description xml:lang="ru">Подготовка Android-приложений для этого компьютера</description>
    <message>Android apps are prepared for this computer's graphics and processor</message>
    <message xml:lang="ru">Android-приложения подготавливаются под видеокарту и процессор этого компьютера</message>
    <icon_name>org.kernora.android</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kernora-android-refresh</annotate>
  </action>
  <action id="org.kernora.android.report">
    <description>Save a report about Android apps</description>
    <description xml:lang="ru">Сохранение отчёта об Android-приложениях</description>
    <message>Reading the logs of Android apps for a report needs administrator rights</message>
    <message xml:lang="ru">Чтобы прочитать журналы Android-приложений для отчёта, нужны права администратора</message>
    <icon_name>org.kernora.android</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kernora-android-report</annotate>
  </action>
</policyconfig>
