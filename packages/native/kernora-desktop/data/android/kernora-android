#!/bin/bash
set -u

state_dir=/var/lib/kernora/android
state_file=$state_dir/state
done_file=$state_dir/done
work=/var/lib/waydroid
config=$work/waydroid.cfg
images=$work/images
overlay_source=/usr/share/kernora/android/KernoraCaption.apk
overlay_target=$work/overlay/system/product/overlay/KernoraCaption
sources=/etc/apt/sources.list.d/kernora-android.sources
template=/usr/share/kernora/apt/kernora-android.sources
real=/usr/bin/waydroid.waydroid
fetch=/usr/libexec/kernora-android-fetch

kind=
progress=0
remaining=
bytes=
bytes_total=

read_state() {
  sed -n "s/^$1=//p" "$state_file" 2>/dev/null | head -n 1
}

record() {
  mkdir -p "$state_dir"
  printf 'status=%s\nkind=%s\nprogress=%s\nremaining=%s\nbytes=%s\nbytes_total=%s\ntime=%s\n' \
    "$1" "$kind" "$progress" "$remaining" "$bytes" "$bytes_total" "$(date +%s)" > "$state_file.new"
  mv "$state_file.new" "$state_file"
}

finish() {
  record "$1"
  printf 'status=%s\nkind=%s\ntime=%s\n' "$1" "$kind" "$(date +%s)" > "$done_file.new"
  chmod 0644 "$done_file.new"
  mv "$done_file.new" "$done_file"
}

installed() {
  dpkg-query -W -f='${db:Status-Abbrev}\n' waydroid 2>/dev/null | grep -q '^ii'
}

initialized() {
  [[ -s $config && -s $images/system.img && -s $images/vendor.img ]]
}

current_kind() {
  case $(sed -n 's/^system_ota *= *//p' "$config" 2>/dev/null) in
    */GAPPS.json) echo gapps ;;
    */VANILLA.json) echo vanilla ;;
  esac
}

live_session() {
  [[ -e /run/live/medium ]]
}

online() {
  getent ahosts deb.debian.org > /dev/null 2>&1 && getent ahosts ota.waydro.id > /dev/null 2>&1
}

apt_get() {
  DEBIAN_FRONTEND=noninteractive apt-get -q -y \
    -o DPkg::Lock::Timeout=900 \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"
}

apt_progress() {
  local kind item share rest
  while IFS=: read -r kind item share rest; do
    [[ $share =~ ^[0-9]+ ]] || continue
    case $kind in
      dlstatus) progress=$(( 3 + BASH_REMATCH[0] * 6 / 100 )) ;;
      pmstatus) progress=$(( 9 + BASH_REMATCH[0] * 3 / 100 )) ;;
      *) continue ;;
    esac
    record installing
  done
}

install_packages() {
  install -m 0644 "$template" "$sources"
  installed && return 0
  apt_get update || true
  progress=2
  record installing
  apt_get update -o Dir::Etc::SourceList="$sources" -o Dir::Etc::SourceParts=- -o APT::Get::List-Cleanup=0 || return 1
  progress=3
  record installing
  apt_get -o APT::Status-Fd=3 install --no-install-recommends waydroid 3>&1 1>&2 | apt_progress
  return "${PIPESTATUS[0]}"
}

fetch_images() {
  PYTHONUNBUFFERED=1 "$fetch" setup "$1" 2>&1 | {
    local line word done total left
    while IFS= read -r line; do
      read -r word done total left <<< "$line"
      case $word in
        progress)
          [[ $done =~ ^[0-9]+$ && $total =~ ^[0-9]+$ && $left =~ ^-?[0-9]+$ ]] && (( total > 0 )) || continue
          progress=$(( 12 + done * 80 / total ))
          remaining=
          (( left >= 0 )) && remaining=$left
          bytes=$done
          bytes_total=$total
          record downloading
          ;;
        verifying | unpacking)
          progress=93
          remaining=
          record unpacking
          ;;
        *)
          printf '%s\n' "$line"
          ;;
      esac
    done
  }
  return "${PIPESTATUS[0]}"
}

download_images() {
  local type=VANILLA
  [[ $kind == gapps ]] && type=GAPPS
  if ! fetch_images "$type"; then
    echo "kernora-android: the quick download did not work, Waydroid downloads the image itself" >&2
    progress=12
    bytes=
    bytes_total=
    record downloading
  fi
  PYTHONUNBUFFERED=1 "$real" init -f -s "$type" 2>&1 | stdbuf -oL tr '\r' '\n' | {
    local line part=system shown=-1 done total share
    while IFS= read -r line; do
      case $line in
        *'[Downloading]'*)
          if [[ $line =~ ([0-9]+)(\.[0-9]+)?\ MB/([0-9]+)(\.[0-9]+)?\ MB ]]; then
            done=${BASH_REMATCH[1]}
            total=${BASH_REMATCH[3]}
            (( total > 0 )) || continue
            share=$(( done * 100 / total ))
            if [[ $part == system ]]; then
              progress=$(( 12 + share * 68 / 100 ))
            else
              progress=$(( 82 + share * 10 / 100 ))
            fi
            if (( progress != shown )); then
              shown=$progress
              record downloading
            fi
          fi
          continue
          ;;
        *Downloading\ http*vendor*)
          part=vendor
          ;;
        *Validating* | *Extracting*)
          progress=93
          [[ $part == system ]] && progress=81
          record unpacking
          ;;
      esac
      printf '%s\n' "$line"
    done
  }
  local status=("${PIPESTATUS[@]}")
  (( status[0] == 0 )) && initialized
}

discard_images() {
  rm -rf --one-file-system "$images" "$work/cache_http" "$config"
}

device_model() {
  case $(hostnamectl chassis 2>/dev/null) in
    laptop | convertible | tablet | handset) echo "Kernora Laptop" ;;
    *) echo "Kernora PC" ;;
  esac
}

write_properties() {
  python3 - "$config" "$(device_model)" <<'EOF'
import configparser
import sys

path, model = sys.argv[1:3]
cfg = configparser.ConfigParser()
cfg.read(path)
if not cfg.has_section("properties"):
    cfg.add_section("properties")
wanted = {
    "persist.waydroid.multi_windows": "true",
    "persist.waydroid.fake_wifi": "*",
    "ro.product.waydroid.brand": "Kernora",
    "ro.product.waydroid.manufacturer": "Kernora",
    "ro.product.waydroid.model": model,
}
for key, value in wanted.items():
    cfg["properties"][key] = value
with open(path, "w") as handle:
    cfg.write(handle)
EOF
}

properties_pending() {
  local key value
  while IFS='=' read -r key value; do
    key=${key% }
    value=${value# }
    [[ $key == ro.product.waydroid.* || $key == persist.waydroid.* ]] || continue
    grep -Fxq "$key=$value" "$work/waydroid_base.prop" 2>/dev/null || return 0
  done < <(sed -n '/^\[properties\]/,/^\[/p' "$config")
  return 1
}

configure() {
  write_properties
  "$real" upgrade -o
  install_overlay
}

install_overlay() {
  [[ -s $overlay_source ]] || return 0
  install -d -m 0755 "$overlay_target"
  install -m 0644 "$overlay_source" "$overlay_target/KernoraCaption.apk"
}

setup_android() {
  kind=$1
  progress=0
  if live_session; then
    record live
    return 1
  fi
  if initialized && [[ $(current_kind) == "$kind" ]]; then
    progress=100
    record ready
    return 0
  fi
  if ! online; then
    record offline
    return 1
  fi
  echo "kernora-android: setting up Android ($kind)"
  progress=1
  record installing
  if ! install_packages; then
    echo "kernora-android: Waydroid could not be installed" >&2
    finish failed
    return 1
  fi
  progress=12
  record downloading
  if ! download_images; then
    echo "kernora-android: the Android image could not be downloaded" >&2
    discard_images
    finish failed
    return 1
  fi
  rm -rf "$work/cache_http"
  progress=97
  bytes=
  bytes_total=
  record unpacking
  configure
  systemctl enable --now waydroid-container.service
  progress=100
  finish ready
  echo "kernora-android: Android is ready"
}

session_active() {
  "$real" status 2>/dev/null | grep -q 'Session:.*RUNNING'
}

apply_properties() {
  write_properties
  if properties_pending && ! session_active; then
    echo "kernora-android: applying the device properties"
    "$real" upgrade -o > /dev/null && install_overlay
  fi
}

update_android() {
  initialized || return 0
  live_session && return 0
  apply_properties
  online || return 0
  PYTHONUNBUFFERED=1 "$fetch" download 2>&1 | grep -v '^progress '
  (( PIPESTATUS[0] == 0 )) || return 0
  if session_active; then
    echo "kernora-android: a newer image is downloaded; it is installed once no app is open"
    return 0
  fi
  kind=$(current_kind)
  progress=0
  record updating
  echo "kernora-android: updating the image"
  if "$fetch" install && "$real" upgrade -o; then
    install_overlay
    echo "kernora-android: the image is up to date"
  else
    echo "kernora-android: the image could not be updated" >&2
  fi
  progress=100
  record ready
}

user_homes() {
  getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $6 }'
}

remove_android() {
  kind=$(current_kind)
  progress=0
  record removing
  systemctl disable --now waydroid-container.service 2>/dev/null || true
  local home
  while IFS= read -r home; do
    [[ -n $home && -d $home ]] || continue
    rm -rf --one-file-system "$home/.local/share/waydroid"
    rm -f "$home"/.local/share/applications/waydroid.*.desktop
  done < <(user_homes)
  if installed; then
    apt_get purge --autoremove waydroid
  fi
  rm -rf --one-file-system "$work"
  rm -f "$sources"
  apt_get update > /dev/null 2>&1 || true
  kind=
  record removed
}

cancel_setup() {
  case $(read_state status) in
    downloading | unpacking) ;;
    *) return 1 ;;
  esac
  systemctl stop 'kernora-android@setup-*.service' 2>/dev/null || true
  discard_images
  kind=$(read_state kind)
  progress=0
  record cancelled
}

print_status() {
  local status installed_flag=no ready=no size=0 container=inactive job=no
  installed && installed_flag=yes
  systemctl list-units --no-legend --state=activating,active 'kernora-android@*' 2>/dev/null | grep -q . && job=yes
  initialized && ready=yes
  if [[ $ready == yes ]]; then
    size=$(du -sb --apparent-size "$images" 2>/dev/null | cut -f1)
    container=$(systemctl is-active waydroid-container.service 2>/dev/null)
  fi
  status=$(read_state status)
  printf 'installed=%s\nready=%s\nkind=%s\nstatus=%s\nprogress=%s\nremaining=%s\nbytes=%s\nbytes_total=%s\ntime=%s\nsize=%s\ncontainer=%s\njob=%s\nlive=%s\n' \
    "$installed_flag" "$ready" "$(current_kind)" "${status:-}" "$(read_state progress)" "$(read_state remaining)" \
    "$(read_state bytes)" "$(read_state bytes_total)" "$(read_state time)" \
    "${size:-0}" "${container:-inactive}" "$job" "$(live_session && echo yes || echo no)"
  printf 'google_id=%s\ngoogle_accounts=%s\n' \
    "$(sed -n 's/^android_id=//p' "$state_dir/google" 2>/dev/null)" "$(sed -n 's/^accounts=//p' "$state_dir/google" 2>/dev/null)"
}

print_android_id() {
  initialized || return 1
  "$real" shell -- sqlite3 -cmd ".timeout 8000" /data/data/com.google.android.gsf/databases/gservices.db \
    "select value from main where name = 'android_id';" 2>/dev/null | tr -cd '0-9'
  echo
}

with_lock() {
  mkdir -p "$state_dir"
  exec 9> "$state_dir/lock" || { echo "kernora-android: cannot open $state_dir/lock" >&2; exit 1; }
  flock -w 3600 9 || { echo "kernora-android: another Android job did not finish" >&2; exit 1; }
  "$@"
}

require_root() {
  (( EUID == 0 )) || { echo "kernora-android: run as root" >&2; exit 1; }
}

case ${1:-} in
  status)
    print_status
    ;;
  setup-vanilla | setup-gapps)
    require_root
    with_lock setup_android "${1#setup-}"
    ;;
  remove)
    require_root
    with_lock remove_android
    ;;
  android-id)
    require_root
    print_android_id
    ;;
  refresh)
    require_root
    if initialized; then
      install_overlay
      apply_properties
    fi
    ;;
  update)
    require_root
    with_lock update_android
    ;;
  request)
    require_root
    case ${2:-} in
      setup-vanilla | setup-gapps)
        kind=${2#setup-}
        if live_session; then
          record live
          exit 0
        fi
        systemctl stop kernora-android-update.service 2>/dev/null || true
        record installing
        systemctl start --no-block "kernora-android@${2}.service"
        ;;
      remove)
        systemctl stop kernora-android-update.service 2>/dev/null || true
        systemctl start --no-block kernora-android@remove.service
        ;;
      cancel)
        cancel_setup
        ;;
      *) exit 2 ;;
    esac
    ;;
  *)
    echo "usage: kernora-android status|setup-vanilla|setup-gapps|remove|android-id|refresh|update|request setup-vanilla|setup-gapps|remove|cancel" >&2
    exit 2
    ;;
esac
