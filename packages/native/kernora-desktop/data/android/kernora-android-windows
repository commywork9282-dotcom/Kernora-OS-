import os
import re
import subprocess
import sys
import time

REAL = "/usr/bin/waydroid.waydroid"
DONE = "/var/lib/kernora/android/windows"
SCREENS = "/var/lib/kernora/android/screens"
SKIP = {
    "android",
    "com.android.launcher3",
    "com.android.packageinstaller",
    "com.android.permissioncontroller",
    "com.android.systemui",
    "com.google.android.packageinstaller",
    "com.google.android.permissioncontroller",
}
PORTRAIT = {
    "SCREEN_ORIENTATION_PORTRAIT",
    "SCREEN_ORIENTATION_REVERSE_PORTRAIT",
    "SCREEN_ORIENTATION_SENSOR_PORTRAIT",
    "SCREEN_ORIENTATION_USER_PORTRAIT",
}
TASK = re.compile(r"^(\s*)\* Task\{\w+ #(\d+) type=(\w+) (?:A=\d+:|I=)([\w.]+)\S*.* mode=(\S+) translucent=(\w+)")
ATTEMPTS = 8
BOUNDS = re.compile(r"mBounds=Rect\((-?\d+), (-?\d+) - (-?\d+), (-?\d+)\)")


def android(*command: str, timeout: float = 30) -> str:
    try:
        return subprocess.run([REAL, "shell", "--", *command], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True, timeout=timeout, check=False).stdout
    except subprocess.TimeoutExpired:
        return ""


def handled() -> set[str]:
    try:
        with open(DONE, encoding="utf-8") as handle:
            return set(handle.read().split())
    except OSError:
        return set()


def remember(package: str) -> None:
    os.makedirs(os.path.dirname(DONE), exist_ok=True)
    with open(DONE, "a", encoding="utf-8") as handle:
        handle.write(package + "\n")


def installed_at(package: str) -> str:
    found = re.search(r"firstInstallTime=(\S+ \S+)", android("sh", "-c", f"dumpsys package {package} | grep -m 1 firstInstallTime"))
    return f"{package}@{found.group(1).replace(' ', 'T')}" if found else package


def tasks() -> dict[int, dict]:
    found: dict[int, dict] = {}
    current = None
    for line in android("dumpsys", "activity", "activities").splitlines():
        match = TASK.match(line)
        if match:
            task_id = int(match.group(2))
            current = None
            if task_id not in found and match.group(3) == "standard":
                current = {"package": match.group(4), "freeform": match.group(5) == "freeform",
                           "translucent": match.group(6) == "true", "bounds": None, "orientations": set(),
                           "letterboxed": False}
                found[task_id] = current
            continue
        if current is None:
            continue
        bounds = BOUNDS.search(line)
        if bounds and current["bounds"] is None:
            current["bounds"] = tuple(int(value) for value in bounds.groups())
        if "requestedOrientation=" in line:
            current["orientations"].add(line.split("requestedOrientation=", 1)[1].strip())
        if "areBoundsLetterboxed=true" in line:
            current["letterboxed"] = True
    return found


def display() -> tuple[int, int] | None:
    output = android("wm", "size")
    match = re.search(r"Override size: (\d+)x(\d+)", output) or re.search(r"Physical size: (\d+)x(\d+)", output)
    return (int(match.group(1)), int(match.group(2))) if match else None


def area(size: tuple[int, int]) -> tuple[int, int, int, int]:
    try:
        with open(SCREENS, encoding="utf-8") as handle:
            found = [tuple(int(value) for value in line.split(",")) for line in handle.read().split()[:8]]
    except (OSError, ValueError):
        found = []
    if len(found) < 2 or any(len(screen) != 4 for screen in found):
        return 0, 0, size[0], size[1]
    left = min(screen[0] for screen in found)
    top = min(screen[1] for screen in found)
    ratio = size[0] / max(1, max(screen[0] + screen[2] for screen in found) - left)
    x, y, width, height = found[0]
    x, y = round((x - left) * ratio), round((y - top) * ratio)
    return x, y, min(round(width * ratio), size[0] - x), min(round(height * ratio), size[1] - y)


def target(size: tuple[int, int], count: int) -> tuple[int, int, int, int]:
    origin_x, origin_y, width_screen, height_screen = area(size)
    width = round(width_screen * 0.72)
    height = round(min(height_screen * 0.86, width * 0.66))
    shift = 32 * (count % 5)
    left = origin_x + min(max(0, (width_screen - width) // 2 - 64 + shift), width_screen - width)
    top = origin_y + min(max(0, (height_screen - height) // 2 - 32 + shift), height_screen - height)
    return left, top, left + width, top + height


def widen(task_id: int, count: int) -> bool | None:
    task = tasks().get(task_id)
    if task is None or not task["freeform"] or task["translucent"] or task["bounds"] is None:
        return None
    package = task["package"]
    if package in SKIP:
        return False
    key = installed_at(package)
    if key in handled():
        return False
    if task["orientations"] & PORTRAIT:
        remember(key)
        return False
    size = display()
    if size is None:
        return False
    left, top, right, bottom = target(size, count)
    old = task["bounds"]
    if (old[2] - old[0]) * (old[3] - old[1]) >= (right - left) * (bottom - top):
        remember(key)
        return False
    android("am", "task", "resize", str(task_id), str(left), str(top), str(right), str(bottom))
    time.sleep(1)
    after = tasks().get(task_id)
    if after is not None and after["letterboxed"]:
        android("am", "task", "resize", str(task_id), *(str(value) for value in old))
    remember(key)
    return True


def main() -> int:
    if os.geteuid() != 0 or not os.path.exists(REAL):
        return 1
    stream = subprocess.Popen([REAL, "shell", "--", "logcat", "-b", "events", "-v", "raw", "-T", "1", "wm_create_task:I", "*:S"],
                              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    time.sleep(1)
    count = 0
    for task_id in sorted(tasks()):
        count += bool(widen(task_id, count))
    for line in stream.stdout:
        match = re.match(r"\[\d+,(\d+)\]", line.strip())
        if not match:
            continue
        for _ in range(ATTEMPTS):
            time.sleep(0.6)
            result = widen(int(match.group(1)), count)
            if result is not None:
                count += result
                break
    return stream.wait()


if __name__ == "__main__":
    sys.exit(main())
