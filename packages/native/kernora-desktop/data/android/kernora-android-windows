import os
import re
import subprocess
import sys
import time

REAL = "/usr/bin/waydroid.waydroid"
SCREENS = "/var/lib/kernora/android/screens"
SKIP = {
    "android",
    "com.android.launcher3",
    "com.android.systemui",
}
TASK = re.compile(r"^(\s*)\* Task\{\w+ #(\d+) type=(\w+) (?:A=\d+:|I=)([\w.]+)\S*.* mode=(\S+) translucent=(\w+)")
ATTEMPTS = 8
AWAKE = "2147483647"
IDLE = "1800000"
EVENT = re.compile(r"^\w/(wm_create_task|wm_task_removed)\s*(?:\(\s*\d+\))?:\s*\[(\d+),\s*([^,\]]+)")
BOUNDS = re.compile(r"mBounds=Rect\((-?\d+), (-?\d+) - (-?\d+), (-?\d+)\)")


def android(*command: str, timeout: float = 30) -> str:
    try:
        return subprocess.run([REAL, "shell", "--", *command], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True, timeout=timeout, check=False).stdout
    except subprocess.TimeoutExpired:
        return ""


def tasks() -> dict[int, dict]:
    found: dict[int, dict] = {}
    current = None
    for line in android("dumpsys", "activity", "activities").splitlines():
        match = TASK.match(line)
        if match:
            task_id = int(match.group(2))
            current = None
            if task_id not in found and match.group(3) == "standard":
                current = {"package": match.group(4), "freeform": match.group(5) == "freeform", "bounds": None}
                found[task_id] = current
            continue
        if current is None:
            continue
        bounds = BOUNDS.search(line)
        if bounds and current["bounds"] is None:
            current["bounds"] = tuple(int(value) for value in bounds.groups())
    return found


def display() -> tuple[int, int] | None:
    output = android("wm", "size")
    match = re.search(r"Override size: (\d+)x(\d+)", output) or re.search(r"Physical size: (\d+)x(\d+)", output)
    return (int(match.group(1)), int(match.group(2))) if match else None


def monitors(size: tuple[int, int]) -> list[tuple[int, int, int, int]]:
    try:
        with open(SCREENS, encoding="utf-8") as handle:
            found = [tuple(int(value) for value in line.split(",")) for line in handle.read().split()[:8]]
    except (OSError, ValueError):
        return []
    if len(found) < 2 or any(len(screen) != 4 for screen in found):
        return []
    left = min(screen[0] for screen in found)
    top = min(screen[1] for screen in found)
    ratio = size[0] / max(1, max(screen[0] + screen[2] for screen in found) - left)
    return [(round((x - left) * ratio), round((y - top) * ratio), round(width * ratio), round(height * ratio))
            for x, y, width, height in found]


def inside(bounds: tuple[int, int, int, int], screen: tuple[int, int, int, int]) -> bool:
    x, y, width, height = screen
    return bounds[0] >= x and bounds[1] >= y and bounds[2] <= x + width and bounds[3] <= y + height


def place(task_id: int, screens: list[tuple[int, int, int, int]]) -> bool | None:
    task = tasks().get(task_id)
    if task is None or task["bounds"] is None:
        return None
    if not task["freeform"] or task["package"] in SKIP or any(inside(task["bounds"], screen) for screen in screens):
        return False
    left, top, right, bottom = task["bounds"]
    x, y, width, height = screens[0]
    if right - left > width or bottom - top > height:
        return False
    new_left = x + (width - (right - left)) // 2
    new_top = y + (height - (bottom - top)) // 2
    android("am", "task", "resize", str(task_id), str(new_left), str(new_top),
            str(new_left + right - left), str(new_top + bottom - top))
    return True


def keep_awake(busy: bool, current: list[str]) -> None:
    value = AWAKE if busy else IDLE
    if current == [value]:
        return
    android("settings", "put", "system", "screen_off_timeout", value)
    current[:] = [value]


def main() -> int:
    if os.geteuid() != 0 or not os.path.exists(REAL):
        return 1
    size = display()
    screens = monitors(size) if size else []
    stream = subprocess.Popen([REAL, "shell", "--", "logcat", "-b", "events", "-v", "tag", "-T", "1",
                               "wm_create_task:I", "wm_task_removed:I", "*:S"],
                              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    current: list[str] = []
    keep_awake(bool(tasks()), current)
    for line in stream.stdout:
        match = EVENT.match(line.strip())
        if not match:
            continue
        if match.group(1) == "wm_create_task":
            keep_awake(True, current)
            for _ in range(ATTEMPTS if screens else 0):
                time.sleep(0.6)
                if place(int(match.group(3)), screens) is not None:
                    break
        else:
            time.sleep(0.6)
            keep_awake(bool(tasks()), current)
    return stream.wait()


if __name__ == "__main__":
    sys.exit(main())
