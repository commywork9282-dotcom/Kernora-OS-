import configparser
import os
import pathlib
import re
import subprocess
import sys
import time

REAL = "/usr/bin/waydroid.waydroid"
UNIT = "kernora-android.service"
SYNC = "/usr/libexec/kernora-android-sync"
SYSTEM_PACKAGES = pathlib.Path("/var/lib/kernora/android/system-packages")
STORE = "com.android.vending"
WAIT = 300

TEXT = {
    "ru": {
        "source": "Android-приложения",
        "starting": ("Открываем приложение", "Это займёт несколько секунд."),
        "failed": ("Приложение не открылось", "Попробуйте ещё раз. Если не поможет, перезагрузите компьютер."),
    },
    "en": {
        "source": "Android apps",
        "starting": ("Opening the app", "This takes a few seconds."),
        "failed": ("The app didn't open", "Try again. If that doesn't help, restart the computer."),
    },
}


def language() -> str:
    for variable in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(variable, "")
        if value:
            return value.split(":")[0].split("_")[0]
    return "en"


def quiet(*command: str, timeout: float | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                          timeout=timeout, check=False)


def session_running() -> bool:
    return quiet("busctl", "--user", "status", "id.waydro.Session").returncode == 0


def booted() -> bool:
    try:
        return quiet(REAL, "prop", "get", "sys.boot_completed", timeout=20).stdout.strip() == "1"
    except subprocess.TimeoutExpired:
        return False


def unit_failed() -> bool:
    return quiet("systemctl", "--user", "-q", "is-failed", UNIT).returncode == 0


def session_started() -> float | None:
    value = quiet("systemctl", "--user", "show", "-p", "ExecMainStartTimestampMonotonic", "--value", UNIT).stdout.strip()
    if not value.isdigit() or int(value) == 0:
        return None
    return time.time() - (time.monotonic() - int(value) / 1000000)


def unlocked(since: float | None) -> bool:
    if since is None:
        time.sleep(3)
        return True
    log = quiet("journalctl", "--user", "-u", UNIT, "--since", f"@{int(since) - 1}", "-o", "cat", "--no-pager").stdout
    return "is ready" in log


def notify(key: str, timeout: int) -> int:
    if os.environ.get("KERNORA_ANDROID_QUIET") or (key == "starting" and os.environ.get("KERNORA_ANDROID_SPLASH")):
        return 0
    texts = TEXT.get(language(), TEXT["en"])
    title, body = texts[key]
    result = quiet("gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                   "--object-path", "/org/freedesktop/Notifications",
                   "--method", "org.freedesktop.Notifications.Notify",
                   texts["source"], "0", "org.kernora.android", title, body, "[]", "{}", str(timeout))
    found = re.search(r"uint32 (\d+)", result.stdout)
    return int(found.group(1)) if found else 0


def close(notification: int) -> None:
    if notification:
        quiet("gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
              "--object-path", "/org/freedesktop/Notifications",
              "--method", "org.freedesktop.Notifications.CloseNotification", str(notification))


def read_ini(path: str) -> configparser.ConfigParser:
    parser = configparser.ConfigParser(strict=False, interpolation=None)
    try:
        parser.read(os.path.expanduser(path), encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError):
        pass
    return parser


def kernora_theme() -> tuple[str, str, str]:
    colour = read_ini("~/.config/kernorarc").get("Style", "colour", fallback="kernora")
    if not re.fullmatch(r"[a-z-]+", colour):
        colour = "kernora"
    seed = read_ini(f"/usr/share/kernora/palettes/{colour}.conf").get("Colour", "seed", fallback="ff6a1e")
    if not re.fullmatch(r"[0-9A-Fa-f]{6}", seed):
        seed = "ff6a1e"
    scheme = read_ini("~/.config/kdeglobals").get("General", "ColorScheme", fallback="KernoraDark")
    return seed, "light" if scheme.endswith("Light") else "dark", "SPRITZ" if colour == "grey" else "TONAL_SPOT"


def hide_system_apps() -> None:
    try:
        system = set(SYSTEM_PACKAGES.read_text(encoding="utf-8").split()) - {STORE}
    except OSError:
        return
    folder = pathlib.Path(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))) / "applications"
    for entry in folder.glob("waydroid.*.desktop"):
        if entry.name[len("waydroid."):-len(".desktop")] not in system:
            continue
        lines = entry.read_text(encoding="utf-8").splitlines()
        if "NoDisplay=true" in lines:
            continue
        lines = [line for line in lines if not line.startswith("NoDisplay=")]
        index = lines.index("[Desktop Entry]") + 1 if "[Desktop Entry]" in lines else 0
        lines.insert(index, "NoDisplay=true")
        entry.write_text("\n".join(lines) + "\n", encoding="utf-8")


def sync() -> int:
    if not session_running():
        return 0
    seed, mode, style = kernora_theme()
    try:
        quiet("pkexec", SYNC, seed, mode, style, timeout=180)
    except subprocess.TimeoutExpired:
        pass
    hide_system_apps()
    return 0


def sync_after_boot() -> int:
    since = session_started()
    deadline = time.monotonic() + WAIT
    while time.monotonic() < deadline:
        if not session_running():
            return 0
        if booted() and unlocked(since):
            return sync()
        time.sleep(2)
    return 1


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--sync":
        return sync()
    if len(sys.argv) > 1 and sys.argv[1] == "--sync-after-boot":
        return sync_after_boot()
    if session_running() and booted() and unlocked(session_started()):
        return 0
    notification = notify("starting", 0)
    if not session_running() and quiet("systemctl", "--user", "start", UNIT).returncode != 0:
        close(notification)
        notify("failed", 8000)
        return 1
    since = session_started()
    deadline = time.monotonic() + WAIT
    while time.monotonic() < deadline:
        if booted() and unlocked(since):
            close(notification)
            return 0
        if unit_failed():
            break
        time.sleep(1)
    close(notification)
    notify("failed", 8000)
    return 1


if __name__ == "__main__":
    sys.exit(main())
