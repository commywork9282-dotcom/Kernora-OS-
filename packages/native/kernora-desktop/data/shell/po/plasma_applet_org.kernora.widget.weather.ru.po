msgid "Weather"
msgstr "Погода"

msgid "Choose a city"
msgstr "Выберите город"

msgid "No connection to the weather service"
msgstr "Нет связи с сервисом погоды"

msgid "Loading…"
msgstr "Загрузка…"

msgid "Location"
msgstr "Место"

msgid "Every Lumo weather widget uses this place. Forecasts come from Open-Meteo.com."
msgstr "Это место используют все виджеты погоды Lumo. Прогноз предоставляет Open-Meteo.com."

msgid "Remove"
msgstr "Убрать"

msgid "Choose another city"
msgstr "Выбрать другой город"

msgid "Search for a city"
msgstr "Найти город"

msgid "Searching…"
msgstr "Поиск…"

msgid "The weather service could not be reached."
msgstr "Не удалось связаться с сервисом погоды."

msgid "No place with this name."
msgstr "Места с таким названием не найдено."

msgid "Sunny"
msgstr "Солнечно"

msgid "Clear"
msgstr "Ясно"

msgid "Partly cloudy"
msgstr "Переменная облачность"

msgid "Fog"
msgstr "Туман"

msgid "Rain"
msgstr "Дождь"

msgid "Snow"
msgstr "Снег"

msgid "Thunderstorm"
msgstr "Гроза"

msgid "Cloudy"
msgstr "Облачно"
