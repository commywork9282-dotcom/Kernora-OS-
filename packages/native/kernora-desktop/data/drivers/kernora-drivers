#!/bin/bash
set -u

state_dir=/var/lib/kernora/drivers
state_file=$state_dir/state
config=/etc/kernora/drivers.conf
ready=/run/kernora-driver-ready
keyring=/usr/share/kernora/nvidia-archive-keyring.gpg
nvidia_url=https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/
nvidia_sources=/etc/apt/sources.list.d/kernora-nvidia.sources
nvidia_preferences=/etc/apt/preferences.d/kernora-nvidia.pref
debian_sources=/etc/apt/sources.list.d/kernora-nvidia-debian.sources
modprobe_options=/etc/modprobe.d/kernora-nvidia.conf
driver_packages=(nvidia-open nvidia-driver nvidia-kernel-open-dkms nvidia-kernel-dkms)

device=
family=none
gpu_name=

find_gpu() {
  local path id best=
  for path in /sys/bus/pci/devices/*; do
    [[ -r $path/vendor && $(<"$path/vendor") == 0x10de ]] || continue
    case $(<"$path/class") in
      0x0300* | 0x0302*) ;;
      *) continue ;;
    esac
    id=$(<"$path/device")
    if [[ -z $best ]] || (( id > best )); then
      best=$id
    fi
  done
  [[ -n $best ]] || return 0
  device=${best#0x}
  local number=$((16#$device))
  if (( number >= 0x1e00 )); then
    family=open
  elif (( number >= 0x1340 )); then
    family=legacy
  else
    family=none
  fi
  local text
  text=$(awk -v id="$device" '
    /^10de[ \t]/ { inside = 1; next }
    inside && /^[0-9a-f]/ { exit }
    inside && /^\t[0-9a-f]/ && $1 == id { sub(/^\t[0-9a-f]+[ \t]+/, ""); print; exit }
  ' /usr/share/misc/pci.ids 2>/dev/null)
  if [[ $text =~ \[([^]]+)\] ]]; then
    text=${BASH_REMATCH[1]}
  fi
  [[ -z $text ]] || gpu_name="NVIDIA $text"
}

driver_installed() {
  dpkg-query -W -f='${db:Status-Abbrev}\n' "${driver_packages[@]}" 2>/dev/null | grep -q '^ii'
}

automatic() {
  ! grep -qx 'automatic=false' "$config" 2>/dev/null
}

secure_boot() {
  mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'
}

live_session() {
  [[ -e /run/live/medium ]]
}

read_state() {
  sed -n "s/^$1=//p" "$state_file" 2>/dev/null | head -n 1
}

record() {
  mkdir -p "$state_dir"
  printf 'status=%s\ndevice=%s\nname=%s\ntime=%s\n' "$1" "$device" "$gpu_name" "$(date +%s)" > "$state_file.new"
  mv "$state_file.new" "$state_file"
}

online() {
  local host=deb.debian.org
  [[ $family == open ]] && host=developer.download.nvidia.com
  getent ahosts "$host" > /dev/null 2>&1
}

apt_get() {
  DEBIAN_FRONTEND=noninteractive apt-get -q -y \
    -o DPkg::Lock::Timeout=900 \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"
}

apt_update() {
  local attempt
  for attempt in $(seq 1 30); do
    apt_get update && return 0
    sleep 30
  done
  return 1
}

add_sources() {
  if [[ $family == open ]]; then
    cat > "$nvidia_sources" <<EOF
Types: deb
URIs: $nvidia_url
Suites: /
Signed-By: $keyring
EOF
    cat > "$nvidia_preferences" <<'EOF'
Package: *
Pin: origin developer.download.nvidia.com
Pin-Priority: 100

Package: *nvidia* libcuda* libnvcuvid* libnvoptix* libxnvctrl*
Pin: origin developer.download.nvidia.com
Pin-Priority: 600
EOF
  else
    cat > "$debian_sources" <<'EOF'
Types: deb
URIs: https://deb.debian.org/debian
Suites: trixie trixie-updates
Components: contrib non-free
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp

Types: deb
URIs: https://security.debian.org/debian-security
Suites: trixie-security
Components: contrib non-free
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
EOF
  fi
}

remove_sources() {
  rm -f "$nvidia_sources" "$nvidia_preferences" "$debian_sources"
}

module_built() {
  local kernel built=0
  for kernel in /lib/modules/*; do
    [[ -d $kernel/build ]] || continue
    find "$kernel" -name 'nvidia.ko*' -print -quit 2>/dev/null | grep -q . || return 1
    built=1
  done
  (( built == 1 ))
}

purge_driver() {
  local installed=() package
  for package in "${driver_packages[@]}"; do
    dpkg-query -W -f='${db:Status-Abbrev}\n' "$package" 2>/dev/null | grep -q '^i' && installed+=("$package")
  done
  (( ${#installed[@]} == 0 )) || apt_get purge --autoremove "${installed[@]}"
  rm -f "$modprobe_options"
  remove_sources
  apt_get clean
  apt_get update > /dev/null 2>&1 || true
}

install_driver() {
  local target=$1
  find_gpu
  if [[ $family == none ]]; then
    echo "kernora-drivers: no NVIDIA graphics card that needs a driver"
    return 0
  fi
  if driver_installed; then
    echo "kernora-drivers: the driver for ${gpu_name:-$device} is already installed"
    record installed
    return 0
  fi
  if [[ $target == no ]] && secure_boot; then
    echo "kernora-drivers: Secure Boot is on; the driver would not load"
    record secureboot
    return 1
  fi
  if ! online; then
    echo "kernora-drivers: offline, the driver will be installed later"
    record offline
    return 0
  fi
  echo "kernora-drivers: installing the driver for ${gpu_name:-$device} ($family)"
  record installing
  add_sources
  local packages=(linux-headers-amd64 nvidia-open)
  [[ $family == legacy ]] && packages=(linux-headers-amd64 nvidia-driver)
  if apt_update && apt_get install "${packages[@]}" && module_built; then
    apt_get clean
    printf 'options nvidia-drm modeset=1 fbdev=1\n' > "$modprobe_options"
    record installed
    if [[ $target == no ]]; then
      update-initramfs -u -k all
      printf '%s\n' "$gpu_name" > "$ready"
    fi
    echo "kernora-drivers: the driver is installed; it works after a restart"
    return 0
  fi
  echo "kernora-drivers: the driver could not be installed; undoing" >&2
  purge_driver
  record failed
  return 1
}

automatic_install() {
  automatic || exit 0
  live_session && exit 0
  find_gpu
  [[ $family == none ]] && exit 0
  driver_installed && exit 0
  [[ $(read_state status) == removed ]] && exit 0
  if secure_boot; then
    record secureboot
    exit 0
  fi
  local last
  last=$(read_state time)
  if [[ $(read_state status) == failed && $last =~ ^[0-9]+$ ]] && (( $(date +%s) - last < 86400 )); then
    exit 0
  fi
  install_driver no
}

print_status() {
  find_gpu
  local installed=no automatic_flag=yes boot=no status
  driver_installed && installed=yes
  automatic || automatic_flag=no
  secure_boot && boot=yes
  status=$(read_state status)
  [[ -e $ready ]] && status=ready
  local version=
  [[ $installed == yes ]] && version=$(dpkg-query -W -f='${Version}\n' nvidia-kernel-open-dkms nvidia-kernel-dkms 2>/dev/null | grep -m 1 . | cut -d- -f1)
  printf 'device=%s\nname=%s\nfamily=%s\ninstalled=%s\nversion=%s\nautomatic=%s\nsecureboot=%s\nstatus=%s\ntime=%s\nlive=%s\n' \
    "$device" "$gpu_name" "$family" "$installed" "$version" "$automatic_flag" "$boot" "${status:-}" \
    "$(read_state time)" "$(live_session && echo yes || echo no)"
}

remove_driver() {
  find_gpu
  record removing
  purge_driver
  update-initramfs -u -k all
  rm -f "$ready"
  record removed
}

with_lock() {
  local wait=$1
  shift
  mkdir -p "$state_dir"
  exec 9> "$state_dir/lock" || { echo "kernora-drivers: cannot open $state_dir/lock" >&2; exit 1; }
  if [[ $wait == wait ]]; then
    flock -w 3600 9 || { echo "kernora-drivers: another driver job did not finish" >&2; exit 1; }
  else
    flock -n 9 || { echo "kernora-drivers: already running" >&2; exit 0; }
  fi
  "$@"
}

require_root() {
  (( EUID == 0 )) || { echo "kernora-drivers: run as root" >&2; exit 1; }
}

case ${1:-} in
  status)
    print_status
    ;;
  auto)
    require_root
    with_lock nowait automatic_install
    ;;
  install)
    require_root
    target=no
    [[ ${2:-} == --target ]] && target=yes
    with_lock wait install_driver "$target"
    ;;
  remove)
    require_root
    with_lock wait remove_driver
    ;;
  request)
    require_root
    case ${2:-} in
      install | remove) systemctl start --no-block "kernora-drivers@${2}.service" ;;
      *) exit 2 ;;
    esac
    ;;
  set-automatic)
    require_root
    mkdir -p "${config%/*}"
    case ${2:-} in
      on) printf 'automatic=true\n' > "$config" ;;
      off) printf 'automatic=false\n' > "$config" ;;
      *) exit 2 ;;
    esac
    ;;
  *)
    echo "usage: kernora-drivers status|auto|install [--target]|remove|request install|remove|set-automatic on|off" >&2
    exit 2
    ;;
esac
