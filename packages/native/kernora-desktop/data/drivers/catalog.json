{
  "items": [
    {
      "id": "broadcom-wl",
      "icon": "network-wireless",
      "name": {"en": "Broadcom Wi-Fi", "ru": "Wi-Fi Broadcom"},
      "text": {"en": "Gets the Wi-Fi card in this computer working", "ru": "Включает Wi-Fi-карту этого компьютера"},
      "marker": "broadcom-sta-dkms",
      "packages": ["linux-image-amd64", "linux-headers-amd64", "broadcom-sta-dkms"],
      "source": "non-free",
      "module": "wl",
      "restart": true,
      "match": {
        "pci": [
          "14e4:0576", "14e4:4311", "14e4:4312", "14e4:4315", "14e4:4328",
