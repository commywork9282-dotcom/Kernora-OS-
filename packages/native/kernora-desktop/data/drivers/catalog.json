          "14e4:4331", "14e4:4353", "14e4:4357", "14e4:4358", "14e4:4359",
          "14e4:4360", "14e4:4365", "14e4:43a0", "14e4:43b1", "14e4:4727"
        ],
        "wifi": false
      },
      "recommend": {}
    },
    {
      "id": "vm-qemu",
      "icon": "computer",
      "name": {"en": "Virtual machine tools", "ru": "Инструменты виртуальной машины"},
      "text": {"en": "Helps Kernora work with QEMU and KVM", "ru": "Помогают Kernora работать с QEMU и KVM"},
      "marker": "qemu-guest-agent",
