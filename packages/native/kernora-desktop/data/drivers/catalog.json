      "match": {"virt": ["kvm", "qemu"]},
      "recommend": {}
    },
    {
      "id": "vm-vmware",
      "icon": "computer",
      "name": {"en": "Virtual machine tools", "ru": "Инструменты виртуальной машины"},
      "text": {"en": "Helps Kernora work with VMware", "ru": "Помогают Kernora работать с VMware"},
      "marker": "open-vm-tools",
      "packages": ["open-vm-tools", "open-vm-tools-desktop"],
      "restart": true,
      "match": {"virt": ["vmware"]},
      "recommend": {}
    },
    {
      "id": "vm-hyperv",
      "icon": "computer",
      "name": {"en": "Virtual machine tools", "ru": "Инструменты виртуальной машины"},
      "text": {"en": "Helps Kernora work with Hyper-V", "ru": "Помогают Kernora работать с Hyper-V"},
      "marker": "hyperv-daemons",
