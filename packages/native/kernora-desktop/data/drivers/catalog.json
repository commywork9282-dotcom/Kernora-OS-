    {
      "id": "printing",
      "icon": "printer",
      "name": {"en": "Printers and scanners", "ru": "Принтеры и сканеры"},
      "text": {"en": "Print and scan over USB and your network", "ru": "Печать и сканирование по USB и по сети"},
      "marker": "cups",
      "packages": [
        "cups", "cups-browsed", "ipp-usb", "print-manager", "printer-driver-all",
        "hplip", "sane-airscan", "sane-utils", "skanpage"
      ],
      "open": "kcm_printer_manager",
      "groups": ["lpadmin"],
      "match": {},
      "recommend": {"usb": ["07"]}
    },
    {
      "id": "firmware-updates",
      "icon": "system-software-update",
      "name": {"en": "Firmware updates", "ru": "Обновления прошивки"},
      "text": {"en": "Updates for the BIOS and built-in devices", "ru": "Обновления BIOS и встроенных устройств"},
      "marker": "fwupd",
      "packages": ["fwupd"],
      "match": {"virt": ["none"]},
      "recommend": {}
