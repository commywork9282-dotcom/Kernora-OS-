#!/usr/bin/python3
import argparse
import os
import pathlib
import re
import shlex
import stat
import subprocess
import tempfile

CATEGORIES = {"LANG", "LC_ALL", "LC_CTYPE", "LC_COLLATE", "LC_MESSAGES", "LC_NUMERIC",
              "LC_TIME", "LC_MONETARY", "LC_PAPER", "LC_NAME", "LC_ADDRESS",
              "LC_TELEPHONE", "LC_MEASUREMENT", "LC_IDENTIFICATION"}


def canonical(name, charset="UTF-8"):
    name, marker, modifier = name.partition("@")
    base, dot, encoding = name.partition(".")
    encoding = encoding if dot else charset
    return base + marker + modifier, re.sub(r"[^a-z0-9]", "", encoding.lower())


def supported_locales(root):
    entries = {}
    for line in (root / "usr/share/i18n/SUPPORTED").read_text().splitlines():
        fields = line.split()
        if len(fields) == 2 and not line.startswith("#"):
            entries[canonical(*fields)] = tuple(fields)
    return entries


def configured_locales(root):
    paths = [root / "etc/default/locale", root / "etc/locale.conf"]
    passwd = root / "etc/passwd"
    if passwd.exists():
        for line in passwd.read_text().splitlines():
            fields = line.split(":")
            if len(fields) == 7 and fields[2].isdigit() and 1000 <= int(fields[2]) < 65534 and fields[5].startswith("/"):
                paths.append(root / fields[5].lstrip("/") / ".config/plasma-localerc")
    values = set()
    for path in paths:
        if not path.is_file():
            continue
        section = ""
        for line in path.read_text(errors="replace").splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
                continue
            key, separator, value = line.partition("=")
            if not separator or key.strip() not in CATEGORIES:
                continue
            if path.name == "plasma-localerc" and section != "Formats":
                continue
            try:
                fields = shlex.split(value, comments=True)
            except ValueError:
                continue
            if len(fields) == 1:
                values.add(fields[0])
    return values


def prepare(root, requested):
    supported = supported_locales(root)
    enabled = set()
    for name in requested:
        key = canonical(name)
        if key[0] in {"C", "POSIX"}:
            continue
        if key not in supported:
            raise ValueError("Unsupported locale: " + name)
        enabled.add(key)
    path = root / "etc/locale.gen"
    original = path.read_text() if path.exists() else ""
    seen = set()
    active = set()
    for line in original.splitlines():
        fields = line.lstrip().lstrip("#").split()
        if len(fields) != 2:
            continue
        key = canonical(*fields)
        seen.add(key)
        if not line.lstrip().startswith("#"):
            active.add(key)
    additions = []
    for key in sorted(enabled - active):
        additions.append(" ".join(supported[key]))
        seen.add(key)
        active.add(key)
    for key, entry in supported.items():
        if key not in seen:
            additions.append("# " + " ".join(entry))
    if additions:
        text = original + ("\n" if original and not original.endswith("\n") else "") + "\n".join(additions) + "\n"
        mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, prefix=".kernora-locales-", delete=False) as stream:
            temporary = pathlib.Path(stream.name)
            stream.write(text)
        try:
            temporary.chmod(mode)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)
    return {key for key in active if key in supported and key[1] == "utf8"}


def command(root, args):
    prefix = [] if root == pathlib.Path("/") else ["/usr/sbin/chroot", str(root)]
    environment = dict(os.environ, LC_ALL="C", LANG="C", LANGUAGE="C")
    return subprocess.run(prefix + args, env=environment, check=True, text=True, capture_output=True)


def generated(root):
    return {canonical(name) for name in command(root, ["/usr/bin/locale", "-a"]).stdout.splitlines() if "." in name}


def repair(root):
    supported = supported_locales(root)
    selected = {name for name in configured_locales(root) if canonical(name) in supported}
    wanted = prepare(root, selected)
    missing = wanted - generated(root)
    if not missing:
        return
    result = command(root, ["/usr/sbin/locale-gen", "--keep-existing"])
    print(result.stdout, end="")
    missing = wanted - generated(root)
    if missing:
        raise RuntimeError("Locales were not generated: " + ", ".join(supported[key][0] for key in sorted(missing)))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=pathlib.Path, default=pathlib.Path("/"))
    parser.add_argument("--prepare", action="store_true")
    parser.add_argument("--enable", action="append", default=[])
    options = parser.parse_args()
    root = options.root.resolve()
    if options.prepare:
        prepare(root, options.enable)
    else:
        if options.enable:
            parser.error("--enable requires --prepare")
        repair(root)


if __name__ == "__main__":
    main()
