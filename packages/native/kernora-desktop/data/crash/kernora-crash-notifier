import configparser
import json
import os
import pathlib
import socket
import subprocess

TEXT = {
    "ru": ("Приложение закрылось", "Приложение «{name}» неожиданно закрылось. Его можно открыть снова."),
    "en": ("An app closed", "{name} closed unexpectedly. You can open it again."),
}


def receive() -> dict:
    try:
        chunks = []
        with socket.socket(fileno=3) as connection:
            while True:
                part = connection.recv(1 << 16)
                if not part:
                    break
                chunks.append(part)
        return json.loads(b"".join(chunks).decode("utf-8", "replace"))
    except (OSError, ValueError):
        return {}


def language() -> str:
    for variable in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(variable, "")
        if value:
            return value.split(":")[0].split("_")[0]
    return "en"


def application(executable: str, lang: str):
    directories = [pathlib.Path.home() / ".local/share/applications"]
    directories += [pathlib.Path(d) / "applications" for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    base = os.path.basename(executable)
    for directory in directories:
        for entry in sorted(directory.glob("*.desktop")) if directory.is_dir() else []:
            parser = configparser.RawConfigParser(strict=False, interpolation=None)
            try:
                parser.read(entry, encoding="utf-8")
                section = parser["Desktop Entry"]
            except (configparser.Error, KeyError, UnicodeDecodeError):
                continue
            command = section.get("Exec", "").split()
            if not command or os.path.basename(command[0]) != base:
                continue
            if section.get("NoDisplay", "false").lower() == "true":
                return None
            name = section.get(f"Name[{lang}]") or section.get("Name") or base
            return name, section.get("Icon", "dialog-error")
    return None


def main() -> int:
    entry = receive()
    executable = entry.get("COREDUMP_EXE", "")
    if not executable or entry.get("COREDUMP_UID", str(os.getuid())) != str(os.getuid()):
        return 0
    lang = language()
    found = application(executable, lang)
    if found is None:
        return 0
    name, icon = found
    title, body = TEXT.get(lang, TEXT["en"])
    subprocess.run(
        ["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
         "--object-path", "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.Notify",
         name, "0", icon, title, body.format(name=name), "[]", "{}", "8000"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
