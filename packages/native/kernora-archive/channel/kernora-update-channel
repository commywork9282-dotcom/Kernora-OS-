set -eu

sources=/etc/apt/sources.list.d/kernora-demo.sources
template=/usr/share/kernora/apt/kernora-demo.sources

case ${1:-} in
    status)
        if [ -e "$sources" ]; then
            echo demo
        else
            echo stable
        fi
        ;;
    set)
        if [ "$(id -u)" -ne 0 ]; then
            echo "kernora-update-channel: run it as root" >&2
            exit 1
        fi
        case ${2:-} in
            demo) install -m 0644 "$template" "$sources" ;;
            stable) rm -f "$sources" ;;
            *) exit 2 ;;
        esac
        ;;
    *)
        echo "usage: kernora-update-channel status|set demo|stable" >&2
        exit 2
        ;;
esac
