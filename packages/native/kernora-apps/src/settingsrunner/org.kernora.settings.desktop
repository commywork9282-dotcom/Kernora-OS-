[Desktop Entry]
Name=Kernora Settings
Name[ru]=Настройки Kernora
Comment=Finds pages and options of Kernora Settings
Comment[ru]=Находит разделы и параметры Настроек Kernora
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=org.kernora.settings
X-KDE-PluginInfo-Name=org.kernora.settings
X-KDE-PluginInfo-Version=1.0
X-KDE-PluginInfo-License=GPL
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.kernora.settings.runner
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
