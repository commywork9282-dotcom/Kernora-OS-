msgid "Quick Share"
msgstr "Quick Share"

msgctxt "@title application name"
msgid "Quick Share"
msgstr "Quick Share"

msgid "Could not send to %1"
msgstr "Не удалось отправить на %1"

msgid "Select the device you'd like to share files with"
msgstr "Выберите устройство, на которое хотите отправить файлы"

msgid "Quick Share is turned off"
msgstr "Quick Share выключен"

msgid "%1 Files"
msgstr "Файлов: %1"

msgid "Share with this device?"
msgstr "Отправить на это устройство?"

msgid "Scanning for nearby devices…"
msgstr "Ищем устройства поблизости…"

msgid "Turn on Quick Share to see devices nearby."
msgstr "Включите Quick Share, чтобы увидеть устройства рядом."

msgid "Turn on"
msgstr "Включить"

msgid "Secure connection ID: %1"
msgstr "Код безопасного подключения: %1"

msgid "Waiting for %1 to accept…"
msgstr "Ждём, пока %1 примет…"

msgid "Connecting…"
msgstr "Подключение…"

msgid "Can't share"
msgstr "Не удалось отправить"

msgid "The device you're trying to share with did not accept"
msgstr "Устройство, на которое вы отправляете, не приняло передачу"

msgid "Something went wrong. Please try again."
msgstr "Что-то пошло не так. Попробуйте ещё раз."

msgid "Make sure both devices are unlocked, close together and on the same Wi-Fi. If a phone isn't listed, open Quick Share on it and choose Everyone."
msgstr "Убедитесь, что оба устройства разблокированы, находятся рядом и в одной сети Wi-Fi. Если телефона нет в списке, откройте на нём Quick Share и выберите «Все»."

msgid "Close"
msgstr "Закрыть"

msgid "Cancel"
msgstr "Отмена"

msgid "Try again"
msgstr "Повторить"

msgid "Next"
msgstr "Далее"
