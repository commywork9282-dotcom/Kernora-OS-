msgstr[2] "У %1 устройств нет драйвера"

msgid "Removing the NVIDIA driver…"
msgstr "Удаление драйвера NVIDIA…"

msgid "Installing the NVIDIA driver…"
msgstr "Установка драйвера NVIDIA…"

msgid "Waiting for another install to finish…"
msgstr "Ждём завершения другой установки…"

msgid "Getting ready…"
msgstr "Подготовка…"

msgid "Downloading…"
msgstr "Загрузка…"

msgid "Installing…"
msgstr "Установка…"

msgid "Removing…"
msgstr "Удаление…"

msgid "Something went wrong. Undoing the changes…"
msgstr "Что-то пошло не так. Отменяем изменения…"

msgid "Updating firmware. Don't turn off the computer."
msgstr "Обновление прошивки. Не выключайте компьютер."

