#: src/updatenotifier/main.cpp:175
msgid "Updates are available"
msgstr "Доступны обновления"

#: src/updatenotifier/main.cpp:177
msgid "%1 update is ready to install, with security fixes."
msgid_plural "%1 updates are ready to install, among them security fixes."
msgstr[0] "Готово к установке: %1 обновление, в нём исправления безопасности."
msgstr[1] "Готово к установке: %1 обновления, среди них исправления безопасности."
msgstr[2] "Готово к установке: %1 обновлений, среди них исправления безопасности."

#: src/updatenotifier/main.cpp:179
msgid "%1 update is ready to install."
msgid_plural "%1 updates are ready to install."
msgstr[0] "Готово к установке: %1 обновление."
msgstr[1] "Готово к установке: %1 обновления."
msgstr[2] "Готово к установке: %1 обновлений."

#: src/updatenotifier/main.cpp:181
msgid "Open Updates"
msgstr "Открыть обновления"

#: src/updatenotifier/main.cpp:184
msgid "View"
msgstr "Посмотреть"

#: src/updatenotifier/main.cpp:205
msgid "Restart to finish updating"
msgstr "Перезагрузите компьютер"

#: src/updatenotifier/main.cpp:206
