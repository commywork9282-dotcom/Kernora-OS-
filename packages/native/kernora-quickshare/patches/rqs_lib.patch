+pub fn has_bluetooth_adapter() -> bool {
+    std::fs::read_dir("/sys/class/bluetooth")
+        .map(|mut entries| entries.next().is_some())
+        .unwrap_or(false)
+}
+
+pub fn pick_peer_ip<'a>(addresses: impl Iterator<Item = &'a Ipv4Addr>) -> Option<Ipv4Addr> {
+    let own: Vec<(Ipv4Addr, Ipv4Addr)> = get_if_addrs()
+        .map(|addrs| {
+            addrs
+                .into_iter()
+                .filter_map(|addr| match addr.addr {
+                    get_if_addrs::IfAddr::V4(v4) if !v4.ip.is_loopback() => Some((v4.ip, v4.netmask)),
+                    _ => None,
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let candidates: Vec<Ipv4Addr> = addresses
+        .copied()
+        .filter(|ip| !own.iter().any(|(mine, _)| mine == ip))
+        .collect();
+    let shared = |ip: &Ipv4Addr| {
+        own.iter().any(|(mine, mask)| {
+            u32::from(*mine) & u32::from(*mask) == u32::from(*ip) & u32::from(*mask)
+        })
+    };
+    candidates
+        .iter()
+        .find(|ip| shared(ip))
+        .or_else(|| candidates.first())
+        .copied()
+}
